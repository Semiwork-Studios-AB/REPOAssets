      m_Items: []
  - m_Id: 2168965816362
    m_Localized: "\u0E17\u0E33\u0E44\u0E21\u0E40\u0E01\u0E34\u0E14\u0E40\u0E23\u0E37\u0E48\u0E2D\u0E07\u0E41\u0E1A\u0E1A\u0E19\u0E35\u0E49"
