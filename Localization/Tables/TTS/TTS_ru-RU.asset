    m_Localized: "\u042D\u0442\u043E \u0437\u0435\u043B\u044C\u0435 \u0440\u043E\u0431\u043E\u0447\u0430\u0440\u043E\u0432\u0430\u0442\u0435\u043B\u044C\u043D\u043E."
