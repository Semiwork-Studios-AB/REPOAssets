    - rid: 2601146098748489728
  m_TableData:
  - m_Id: 2168907096064
    m_Localized: Fui, que se faz tarde!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816320
    m_Localized: Adeus e um queijo!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816321
    m_Localized: Adieu
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816322
    m_Localized: Sayonara
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816323
    m_Localized: Auf Wiedersehen
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816324
    m_Localized: Adios
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816325
    m_Localized: Ciao
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816326
    m_Localized: Au Revoir
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816327
    m_Localized: Hasta la vista
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816328
    m_Localized: "Vou ali e j\xE1 n\xE3o venho!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816329
    m_Localized: "At\xE9 logo!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816330
    m_Localized: "V\xE1, portem-se!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816331
    m_Localized: "A gente v\xEA-se!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816332
    m_Localized: "At\xE9 logo, malta!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816333
    m_Localized: Fui!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816334
    m_Localized: Juizinho!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816335
    m_Localized: Tchau!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816336
    m_Localized: AAAAAAAAAA!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816337
    m_Localized: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816338
    m_Localized: Tchauzinho... ou?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816339
    m_Localized: Isto vai doer!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816340
    m_Localized: "J\xE1 era...!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816341
    m_Localized: "Porqu\xEA eu?"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816342
    m_Localized: Desculpa
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816343
    m_Localized: Estou a ver a luz!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816344
    m_Localized: "Triste, mas necess\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816345
    m_Localized: "HEJ D\xC5!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816346
    m_Localized: "SEQU\xCANCIA DE AUTODESTRUI\xC7\xC3O CANCELADA!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816347
    m_Localized: Deixaste-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816348
    m_Localized: Abandonaram-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816349
    m_Localized: A minha equipa traiu-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816350
    m_Localized: Todos se esqueceram de mim.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816351
    m_Localized: Os meus amigos condenaram-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816352
    m_Localized: "O esquadr\xE3o abandonou-me."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816353
    m_Localized: O grupo borrifou-se para mim.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816354
    m_Localized: Todos eles me descartaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816355
    m_Localized: Confiei neles. Deixaram-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816356
    m_Localized: Os meus companheiros abandonaram-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816357
    m_Localized: Sinto-me perdido.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816358
    m_Localized: "Porque \xE9 que n\xE3o esperaram?"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816359
    m_Localized: O que fiz eu de errado?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816360
    m_Localized: "N\xE3o acredito."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816361
    m_Localized: Como foram capazes?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816362
    m_Localized: "Isto n\xE3o pode estar a acontecer."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816363
    m_Localized: Agora estou por minha conta.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816364
    m_Localized: "Eram a minha \xFAnica esperan\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816365
    m_Localized: Devia ter desconfiado.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816366
    m_Localized: "\xC9 t\xE3o injusto."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816367
    m_Localized: "Deixaram-me para tr\xE1s, sem salva\xE7\xE3o.."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816368
    m_Localized: "Abandonaram-me \xE0 minha sorte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816369
    m_Localized: "Deixaram-me para tr\xE1s no escuro..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816370
    m_Localized: Descartaram-me sem uma palavra...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816371
    m_Localized: Deixaram-me sem aviso...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816372
    m_Localized: "Abandonaram-me em sil\xEAncio..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816373
    m_Localized: "Tra\xEDram-me sem pensar duas vezes..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816374
    m_Localized: Esqueceram-se de mim sem remorsos...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816375
    m_Localized: Aqueles em quem confiava condenaram-me.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816376
    m_Localized: Largaram-me aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816377
    m_Localized: "Tenho de chegar ao cami\xE3o em..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816378
    m_Localized: "Trai\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816379
    m_Localized: "Trai\xE7\xE3o detetada"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816380
    m_Localized: Desculpa
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816381
    m_Localized: "Falhei \xE0 grande"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816382
    m_Localized: "Op\xE1, outra vez n\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816383
    m_Localized: "A uni\xE3o faz a for\xE7a!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816384
    m_Localized: "Pensei que \xE9ramos amigos"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816385
    m_Localized: "Pensei que \xE9ramos uma equipa "
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816386
    m_Localized: "Pensei que est\xE1vamos juntos nisto"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816387
    m_Localized: "Pensei que \xE9ramos uma fam\xEDlia"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816388
    m_Localized: "{playerName} faz o meu cora\xE7\xE3o fazer \xE3o \xE3o..."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816389
    m_Localized: "Sempre que vejo {playerName}, declaro fal\xEAncia."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816390
    m_Localized: "S\xF3 quero andar no C.A.R.T. com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816391
    m_Localized: "{playerName} \xE9 super mega robofofo, sabes?"
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816392
    m_Localized: "{playerName} \xE9 o meu mago favorito."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816393
    m_Localized: Quero tanto estar com {playerName}!
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816394
    m_Localized: "Pensar em {playerName} faz-me descarregar a atualiza\xE7\xE3o mais
      recente."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816395
    m_Localized: "{playerName}, deixas-me a fazer gugu d\xE1-d\xE1, ding dong."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816396
    m_Localized: Mal posso esperar para voltar a fazer o Taxas feliz com {playerName}.
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816397
    m_Localized: "S\xF3 quero ir ao Jap\xE3o com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816398
    m_Localized: Acho que tenho robossentimentos por {playerName}.
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816399
    m_Localized: "{playerName} tem o sorriso mais financeiramente est\xE1vel."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816400
    m_Localized: "{playerName} \xE9 tipo um sonho com todos os upgrades."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816401
    m_Localized: "Sempre que vejo {playerName}, fa\xE7o uma robodan\xE7a por dentro."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816402
    m_Localized: "{playerName} \xE9 o meu pateta favorito."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816403
    m_Localized: "Mal posso esperar para fazer roboc\xF3cegas a {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816404
    m_Localized: '{playerName}, alegras o meu dia!'
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816405
    m_Localized: "{playerName} faz o meu cora\xE7\xE3o fazer woop woop!"
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816406
    m_Localized: "S\xF3 quero partilhar segredos com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816407
    m_Localized: "N\xE3o paro de sorrir por causa de {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489728
  - m_Id: 2168965816408
    m_Localized: "Esta po\xE7\xE3o \xE9 simplesmente roboador\xE1vel."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816409
    m_Localized: "Adoro tanto esta po\xE7\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816410
    m_Localized: "Pensar nesta po\xE7\xE3o faz-me fazer bip bop."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816411
    m_Localized: "Esta po\xE7\xE3o \xE9 o meu amorzinho favorito."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816412
    m_Localized: "Sempre que vejo esta po\xE7\xE3o, declaro o meu amor."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816413
    m_Localized: "Esta po\xE7\xE3o torna o meu dia super mega fixe."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816414
    m_Localized: "Acho que tenho um fraquinho por esta po\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816415
    m_Localized: "A vida \xE9 maravilhosa com esta po\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816416
    m_Localized: "Esta po\xE7\xE3o faz o meu cora\xE7\xE3o arrancar."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816417
    m_Localized: "S\xF3 de pensar nesta po\xE7\xE3o fico feliz."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816418
    m_Localized: Ai! Ai! Ai!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816419
    m_Localized: Au! Au! Au!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816420
    m_Localized: Uf! Uf! Uf!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816421
    m_Localized: Ai! Ui! Uau!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816422
    m_Localized: 'Ai! Uauzinho! '
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816423
    m_Localized: 'erro erro erro '
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816424
    m_Localized: erro de sistema
    m_Metadata:
