  - m_Id: 2168965816329
    m_Localized: salut
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816330
    m_Localized: "tch\xF4-tch\xF4"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816331
    m_Localized: "\xE0 la prochaine"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816332
    m_Localized: "\xE0 plus dans le bus"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816333
    m_Localized: tchouss
    m_Metadata:
