  m_Name: TTS_pt-BR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: pt-BR
  m_SharedData: {fileID: 11400000, guid: bc4b19486e3f94d4a9fd44e4d2661ea1, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2601146098748489729
  m_TableData:
  - m_Id: 2168907096064
    m_Localized: "Fui, que j\xE1 deu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816320
    m_Localized: Adeus, povo bonito!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816321
    m_Localized: Adieu
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816322
    m_Localized: Sayonara
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816323
    m_Localized: Auf Wiedersehen
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816324
    m_Localized: Adios
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816325
    m_Localized: Ciao
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816326
    m_Localized: Au Revoir
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816327
    m_Localized: Hasta la vista
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816328
    m_Localized: "Fui ali e j\xE1 n\xE3o volto!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816329
    m_Localized: "At\xE9 mais!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816330
    m_Localized: Valeu, fui!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816331
    m_Localized: "A gente se v\xEA!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816332
    m_Localized: "At\xE9 mais, pessoal!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816333
    m_Localized: Fui nessa!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816334
    m_Localized: "Ju\xEDzo, hein!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816335
    m_Localized: Tchau!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816336
    m_Localized: AAAAAAAAAA!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816337
    m_Localized: AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816338
    m_Localized: Tchauzinho... ou?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816339
    m_Localized: Isso vai doer!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816340
    m_Localized: "J\xE1 era pra mim!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816341
    m_Localized: Por que eu?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816342
    m_Localized: Desculpa
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816343
    m_Localized: Estou vendo a luz!
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816344
    m_Localized: "Triste, mas necess\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816345
    m_Localized: "HEJ D\xC5!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816346
    m_Localized: "SEQU\xCANCIA DE AUTODESTRUI\xC7\xC3O CANCELADA!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816347
    m_Localized: "Voc\xEA me deixou."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816348
    m_Localized: Me abandonaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816349
    m_Localized: Minha equipe me traiu.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816350
    m_Localized: Todos se esqueceram de mim.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816351
    m_Localized: Meus amigos me condenaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816352
    m_Localized: "O esquadr\xE3o me abandonou."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816353
    m_Localized: "O grupo n\xE3o quis saber de mim."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816354
    m_Localized: Todos eles me descartaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816355
    m_Localized: Confiei neles. Me deixaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816356
    m_Localized: Meus companheiros me abandonaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816357
    m_Localized: Me sinto perdido.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816358
    m_Localized: "Por que n\xE3o esperaram?"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816359
    m_Localized: O que eu fiz de errado?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816360
    m_Localized: "N\xE3o acredito."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816361
    m_Localized: Como puderam?
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816362
    m_Localized: "Isso n\xE3o pode estar acontecendo."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816363
    m_Localized: Agora estou por minha conta.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816364
    m_Localized: "Eles eram minha \xFAnica esperan\xE7a."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816365
    m_Localized: Eu devia ter percebido.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816366
    m_Localized: "\xC9 t\xE3o injusto."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816367
    m_Localized: "Me deixaram pra tr\xE1s, sem salva\xE7\xE3o..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816368
    m_Localized: "Me abandonaram \xE0 pr\xF3pria sorte..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816369
    m_Localized: "Me deixaram pra tr\xE1s na escurid\xE3o..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816370
    m_Localized: Me descartaram sem uma palavra...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816371
    m_Localized: Me deixaram sem aviso...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816372
    m_Localized: "Me abandonaram em sil\xEAncio..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816373
    m_Localized: "Me tra\xEDram sem pensar duas vezes..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816374
    m_Localized: Se esqueceram de mim sem remorso...
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816375
    m_Localized: Aqueles em quem eu confiava me condenaram.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816376
    m_Localized: Me largaram aqui.
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816377
    m_Localized: "Preciso chegar ao caminh\xE3o em..."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816378
    m_Localized: "Trai\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816379
    m_Localized: "Trai\xE7\xE3o detectada"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816380
    m_Localized: Desculpa
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816381
    m_Localized: Eu falhei
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816382
    m_Localized: "Ah n\xE3o, de novo n\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816383
    m_Localized: "A uni\xE3o faz a for\xE7a!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816384
    m_Localized: "Achei que \xE9ramos amigos"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816385
    m_Localized: "Achei que \xE9ramos uma equipe"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816386
    m_Localized: "Achei que est\xE1vamos juntos nessa"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816387
    m_Localized: "Achei que \xE9ramos fam\xEDlia"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816388
    m_Localized: "{playerName} faz meu cora\xE7\xE3o fazer \xE3o \xE3o..."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816389
    m_Localized: "Sempre que vejo {playerName}, declaro fal\xEAncia."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816390
    m_Localized: "S\xF3 quero andar no C.A.R.T. com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816391
    m_Localized: "{playerName} \xE9 super mega robofofo, sabe?"
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816392
    m_Localized: "{playerName} \xE9 meu mago favorito."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816393
    m_Localized: Quero tanto ficar com {playerName}!
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816394
    m_Localized: "Pensar em {playerName} me faz baixar a atualiza\xE7\xE3o mais recente."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816395
    m_Localized: "{playerName}, voc\xEA me faz ficar gugu dad\xE1, ding dong."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816396
    m_Localized: "N\xE3o vejo a hora de fazer o Taxador feliz de novo com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816397
    m_Localized: "S\xF3 quero ir pro Jap\xE3o com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816398
    m_Localized: Acho que tenho robossentimentos por {playerName}.
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816399
    m_Localized: "{playerName} tem o sorriso mais financeiramente est\xE1vel."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816400
    m_Localized: "{playerName} \xE9 tipo um sonho com todos os upgrades."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816401
    m_Localized: "Sempre que vejo {playerName}, fa\xE7o uma robodan\xE7a por dentro."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816402
    m_Localized: "{playerName} \xE9 meu bob\xE3o favorito."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816403
    m_Localized: "Mal posso esperar pra fazer roboc\xF3cegas em {playerName} de novo."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816404
    m_Localized: "{playerName}, voc\xEA alegra meu dia!"
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816405
    m_Localized: "{playerName} faz meu cora\xE7\xE3o fazer woop woop!"
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816406
    m_Localized: "S\xF3 quero compartilhar segredos com {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816407
    m_Localized: "N\xE3o paro de sorrir por causa de {playerName}."
    m_Metadata:
      m_Items:
      - rid: 2601146098748489729
  - m_Id: 2168965816408
    m_Localized: "Esta po\xE7\xE3o \xE9 simplesmente roboador\xE1vel."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816409
    m_Localized: "Adoro tanto esta po\xE7\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816410
    m_Localized: "Pensar nesta po\xE7\xE3o me faz fazer bip bop."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816411
    m_Localized: "Esta po\xE7\xE3o \xE9 meu amorzinho favorito."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816412
    m_Localized: "Sempre que vejo esta po\xE7\xE3o, declaro meu amor."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816413
    m_Localized: "Esta po\xE7\xE3o deixa meu dia super mega incr\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816414
    m_Localized: "Acho que tenho uma quedinha por esta po\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816415
    m_Localized: "A vida \xE9 maravilhosa com esta po\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816416
    m_Localized: "Esta po\xE7\xE3o faz meu cora\xE7\xE3o inicializar."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816417
    m_Localized: "S\xF3 de pensar nesta po\xE7\xE3o j\xE1 fico feliz."
    m_Metadata:
      m_Items: []
  - m_Id: 2168965816418
    m_Localized: Ai! Ai! Ai!
    m_Metadata:
