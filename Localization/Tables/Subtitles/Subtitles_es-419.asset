  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_es-419
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-419
  m_SharedData: {fileID: 11400000, guid: d7769f30d4d5aeb45ab0918f43fed15a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: "\xA1Pues enl\xE1tame"
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: "y ll\xE1mame \"frijolito\"!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: "\xA1Puedo ver el brillo p\xE9treo"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: con los ojos cerrados!
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: "\xA1JA, JA!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "Eso es lo que sol\xEDan decir todos."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "El brillo p\xE9treo son"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "las part\xEDculas de luz"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: "y alta energ\xEDa de las piedras solares."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "En el a\xF1o..."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907347210240
    m_Localized: "\xA1Hola, camarada!"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693312
    m_Localized: "Ac\xE9rcate una piedra solar al o\xEDdo,"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693313
    m_Localized: "sentir\xE1s cosquillas en las neuronas."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153282
    m_Localized: "\xA1Podr\xEDas escuchar una canci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153283
    m_Localized: "\xA1No escucho nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153284
    m_Localized: "Quiz\xE1s sea porque no tengo"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153285
    m_Localized: un cerebro humano.
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153286
    m_Localized: "\xBFDe qu\xE9 hablas?"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153287
    m_Localized: "\xA1Somos humanos!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153288
    m_Localized: "\xBFVerdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "\xA1Hola, visitante!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "\xA1Este es el Hotel Valle Soleado!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: "Es la representaci\xF3n m\xE1s aut\xE9ntica"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: "de nuestra gran historia de miner\xEDa de cristales."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: Esto combinado con todas las comodidades
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: de la modernidad...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: Me llamo Jenny
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "Y trabajo aqu\xED desde hace..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: 73...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "a\xF1os."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: "\xA1Que disfrutes tu estancia!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: La clave del wifi es...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: 6...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: 7...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: 4--
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "\xA1El brillo p\xE9treo es la energ\xEDa del futuro!"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709376
    m_Localized: "Sin \xE9l,"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709377
    m_Localized: "no habr\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709378
    m_Localized: robots.
    m_Metadata:
      m_Items: []
  - m_Id: 1438646992363520
    m_Localized: Esos carritos mineros
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112256
    m_Localized: se usaban para atravesar
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112257
    m_Localized: las oscuras y peligrosas minas
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112258
    m_Localized: que los mineros
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112259
    m_Localized: exploramos y explotamos
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112260
    m_Localized: para extraer piedras solares.
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112261
    m_Localized: Lo gracioso
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112262
    m_Localized: "es que aqu\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112263
    m_Localized: "\xA1no hay agua mineral!"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191595347968
    m_Localized: Nuestro mundo
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096704
    m_Localized: funciona con estas rocas brillantes.
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096705
    m_Localized: "\xBFSab\xEDas que...?"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096706
    m_Localized: "Basta con un pu\xF1ado"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096707
    m_Localized: "para dar energ\xEDa"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096708
    m_Localized: "a una metr\xF3poli grande."
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096709
    m_Localized: "Fascinante, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375914909696
    m_Localized: "\xA1Hola, peques!"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047040
    m_Localized: "\xBFCu\xE1l de estos animales no es end\xE9mico"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047041
    m_Localized: de Valle Soleado?
    m_Metadata:
      m_Items: []
  - m_Id: 3615782301851648
    m_Localized: "\xA1Vamos, chicos, ustedes pueden!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406080
    m_Localized: "\xA1Solo un poco m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406081
    m_Localized: "\xA1Ya casi!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406082
    m_Localized: "\xA1Ja, ja!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406083
    m_Localized: "Qu\xE9 situaci\xF3n tan loca, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406084
    m_Localized: "\xA1As\xED son las cosas aqu\xED!"
    m_Metadata:
      m_Items: []
  - m_Id: 5022492442746880
    m_Localized: "Mi caballo MURI\xD3..."
    m_Metadata:
      m_Items: []
  - m_Id: 6150717449428992
    m_Localized: "\xA1Bu!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372032
    m_Localized: "\xA1Me escondo detr\xE1s del cilindro verde!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372033
    m_Localized: "\xA1Ja, ja, ja!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
