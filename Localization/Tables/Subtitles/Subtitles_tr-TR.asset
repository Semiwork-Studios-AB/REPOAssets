--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_tr-TR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: tr-TR
  m_SharedData: {fileID: 11400000, guid: d7769f30d4d5aeb45ab0918f43fed15a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: Hadi, beni konserve yap
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: ve "fasulye" de!
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: "G\xF6zlerim kapal\u0131yken bile"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: "ta\u015Flar\u0131n par\u0131ldad\u0131\u011F\u0131n\u0131 g\xF6rebiliyorum!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: HA! HA!
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "O zaman herkes \xF6yle demi\u015Fti."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "Ta\u015Flar\u0131n par\u0131lt\u0131s\u0131 sand\u0131\u011F\u0131m\u0131z
      \u015Fey, asl\u0131nda g\xFCnta\u015Flar\u0131n\u0131n yayd\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "\u0131\u015F\u0131k sa\xE7an"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: "y\xFCksek enerjili par\xE7ac\u0131klard\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "Y\u0131l--"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907347210240
    m_Localized: Naber ortak!
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693312
    m_Localized: "G\xFCnta\u015F\u0131n\u0131 kula\u011F\u0131na tuttu\u011Funda"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693313
    m_Localized: "beynini m\u0131nc\u0131klar."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153282
    m_Localized: "Bir \u015Fark\u0131 duyars\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153283
    m_Localized: "Ben hi\xE7bir \u015Fey duymuyorum!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153284
    m_Localized: Bende insan beyni
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153285
    m_Localized: "olmad\u0131\u011F\u0131 i\xE7indir belki de!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153286
    m_Localized: O ne demek?
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153287
    m_Localized: "Biz insan\u0131z!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153288
    m_Localized: "De\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "Merhaba ziyaret\xE7i!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "G\xFCnta\u015F\u0131 Vadisi Tatil K\xF6y\xFC'ne Ho\u015F Geldin!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: "Buras\u0131, kristal madencili\u011Fi tarihimizin"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: "en g\xFCzide sembol\xFCd\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: "Modern \xE7a\u011F\u0131n sundu\u011Fu"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: "t\xFCm imk\xE2nlarla birle\u015Ftirildi\u011Finde--"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: Ben Jenny.
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "Burada \xE7al\u0131\u015F\u0131yorum--"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: "73\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "\u2026y\u0131ld\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: "Umar\u0131m tatilinizden memnun kal\u0131rs\u0131n\u0131z!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: "Wifi \u015Fifresi\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: "6\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: "7\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: "4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: "4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: 4--
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "Ta\u015Flar\u0131n par\u0131lt\u0131s\u0131, gelece\u011Fin enerjisidir!"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709376
    m_Localized: Bu olmadan
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709377
    m_Localized: robotlar da
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709378
    m_Localized: olmaz!
    m_Metadata:
      m_Items: []
  - m_Id: 1438646992363520
    m_Localized: Biz madenciler,
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112256
    m_Localized: "bu maden arabalar\u0131yla"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112257
    m_Localized: "karanl\u0131k, tehlikeli madenlere"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112258
    m_Localized: gidiyorduk!
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112259
    m_Localized: "Oralarda G\xFCnta\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112260
    m_Localized: "aray\u0131p \xE7\u0131kar\u0131yorduk!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112261
    m_Localized: "\u0130lgin\xE7tir ki\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112262
    m_Localized: "bunlara binmek i\xE7in\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112263
    m_Localized: "re\u015Fit olman gerekiyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191595347968
    m_Localized: "D\xFCnyam\u0131z d\xF6n\xFCyorsa"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096704
    m_Localized: "bu parlayan garip ta\u015Flar sayesinde."
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096705
    m_Localized: "\u015E\xF6yle bir be\u015F on tanesiyle"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096706
    m_Localized: "b\xFCy\xFCk bir \u015Fehrin"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096707
    m_Localized: "elektrik ihtiyac\u0131n\u0131n kar\u015F\u0131lanabilece\u011Fini"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096708
    m_Localized: biliyor muydun?
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096709
    m_Localized: "\xC7ok ilgin\xE7, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375914909696
    m_Localized: "Merhaba \xE7ocuklar!"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047040
    m_Localized: Bu hayvan seslerinden hangisi
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047041
    m_Localized: "G\xFCnta\u015F\u0131 Vadisi'ne \xF6zg\xFC bir ses de\u011Fildir?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782301851648
    m_Localized: Hadi millet, yapabilirsiniz!
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406080
    m_Localized: "Birazc\u0131k daha!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406081
    m_Localized: "\xC7ok az kald\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406082
    m_Localized: Ha ha!
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406083
    m_Localized: "Ne manyakl\u0131k ama, de\u011Fil mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406084
    m_Localized: "Buralarda b\xF6yle i\u015Fte!"
    m_Metadata:
      m_Items: []
  - m_Id: 5022492442746880
    m_Localized: "At\u0131m \xD6LD\xDC--"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717449428992
    m_Localized: "B\xF6\xF6!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372032
    m_Localized: "Ben ye\u015Fil silindirin arkas\u0131na saklan\u0131yorum!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372033
    m_Localized: Ha ha ha!
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
