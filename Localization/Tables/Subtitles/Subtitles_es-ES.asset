MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_es-ES
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: d7769f30d4d5aeb45ab0918f43fed15a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: "Bueno, \xA1enl\xE1tame"
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: "y ll\xE1mame \xABalubias\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: "\xA1Veo el litobrillo"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: hasta con los ojos cerrados!
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: "\xA1JA! \xA1JA!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "Eso es lo que dec\xEDan en aquel entonces."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "El litobrillo son las part\xEDculas"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "de alta energ\xEDa e iluminadoras"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: que emiten las piedras solares.
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "En el a\xF1o..."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907347210240
    m_Localized: "\xA1Hola, compa\xF1ero!"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693312
    m_Localized: "Sost\xE9n una piedra solar junto a tu o\xEDdo"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693313
    m_Localized: "y ver\xE1s c\xF3mo te hace cosquillas en las neuronas."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153282
    m_Localized: "\xA1Puede que escuches una canci\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153283
    m_Localized: "\xA1No oigo nada!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153284
    m_Localized: "\xA1Tal vez sea porque no tengo"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153285
    m_Localized: un cerebro humano!
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153286
    m_Localized: "\xBFA qu\xE9 te refieres?"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153287
    m_Localized: "\xA1Somos humanos!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153288
    m_Localized: "\xBFVerdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "\xA1Hola, visitante!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "\xA1Te damos la bienvenida al Resort del Valle Piedra Solar!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: "La representaci\xF3n m\xE1s aut\xE9ntica"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: de nuestra gran historia minera de cristales.
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: Combinada con todas las comodidades
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: que la era moderna...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: Me llamo Jenny
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "y llevo trabajando aqu\xED..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: 73...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "\xA1a\xF1os!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: "\xA1Espero que disfrutes de tu estancia!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: "La contrase\xF1a del wifi es..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: 6...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: 7...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "\xA1El litobrillo estelar es la energ\xEDa del futuro!"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709376
    m_Localized: "Sin \xE9l"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709377
    m_Localized: "no habr\xEDa..."
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709378
    m_Localized: "\xA1robots!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438646992363520
    m_Localized: Estos carros mineros
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112256
    m_Localized: se usaban para atravesar las
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112257
    m_Localized: oscuras y peligrosas minas que nosotros,
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112258
    m_Localized: los mineros,
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112259
    m_Localized: exploramos para extraer
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112260
    m_Localized: "\xA1las piedras solares!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112261
    m_Localized: "Ir\xF3nicamente..."
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112262
    m_Localized: para viajar en ellos...
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112263
    m_Localized: "\xA1no puedes ser un menor!"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191595347968
    m_Localized: Nuestro mundo
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096704
    m_Localized: funciona gracias a estas peculiares rocas brillantes.
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096705
    m_Localized: "\xBFSab\xEDas que"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096706
    m_Localized: "con un pu\xF1ado basta"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096707
    m_Localized: para alimentar una gran
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096708
    m_Localized: zona metropolitana?
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096709
    m_Localized: "Es bastante interesante, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375914909696
    m_Localized: "\xA1Hola, ni\xF1os!"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047040
    m_Localized: "\xBFCu\xE1l de estos sonidos de animales no es nativo"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047041
    m_Localized: del Valle Piedra Solar?
    m_Metadata:
      m_Items: []
  - m_Id: 3615782301851648
    m_Localized: "\xA1Vamos, chicos, vosotros pod\xE9is!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406080
    m_Localized: "\xA1Solo un poco m\xE1s!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406081
    m_Localized: "\xA1Casi lo ten\xE9is!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406082
    m_Localized: "\xA1Ja, ja!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406083
    m_Localized: "Qu\xE9 locura de situaci\xF3n, \xBFverdad?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406084
    m_Localized: "\xA1As\xED son las cosas por estos lados!"
    m_Metadata:
      m_Items: []
  - m_Id: 5022492442746880
    m_Localized: "Mi caballo est\xE1 MUERTO..."
    m_Metadata:
      m_Items: []
  - m_Id: 6150717449428992
    m_Localized: "\xA1Bu!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372032
    m_Localized: "\xA1Estoy escondida detr\xE1s del cilindro verde!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372033
    m_Localized: "\xA1Ja, ja, ja!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
