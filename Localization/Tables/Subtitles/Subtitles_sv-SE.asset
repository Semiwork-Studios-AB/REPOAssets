  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_sv-SE
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: sv-SE
  m_SharedData: {fileID: 11400000, guid: d7769f30d4d5aeb45ab0918f43fed15a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: "N\xE4men, burka upp mig"
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: "och kalla mig \"b\xF6nan\"!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: Jag kan se stenglansen
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: "\xE4ven om mina \xF6gon \xE4r st\xE4ngda!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: HA! HA!
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "Det \xE4r vad de sa f\xF6rr, allihopa."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "Stenglans \xE4r den upplysande"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "h\xF6genergipartikeln"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: "som utstr\xE5las ur solstenar."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "Under \xE5ret--"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "Hejsan bes\xF6kare!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "V\xE4lkommen till Solstensdalens Resort!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: Den mest autentiska representationen
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: "av v\xE5ran m\xE4ktiga kristallbrytarhistoria."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: "Kombinerad med alla bekv\xE4mligheter"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: "som v\xE5r moderna tid--"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: "Mitt namn \xE4r Jenny"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "och jag har jobbat h\xE4r i--"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: 73...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "... \xE5r!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: Hoppas du trivs!
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: "Wifil\xF6senordet \xE4r..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: 6...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: 7...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: 4--
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "Stenglans \xE4r framtidens energi!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
