--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: Subtitles_fr-FR
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fr-FR
  m_SharedData: {fileID: 11400000, guid: d7769f30d4d5aeb45ab0918f43fed15a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: "Mettez-moi en bo\xEEte"
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: "et appelez-moi \xAB\_haricot\_\xBB\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: "Je vois le rayonnement min\xE9ral"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: "m\xEAme les yeux ferm\xE9s\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: "HA\_! HA\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "C\u2019est ce qu\u2019ils ont dit \xE0 l\u2019\xE9poque."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "Le rayonnement min\xE9ral,"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "ce sont des particules charg\xE9es"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: "\xE9mises par les solpierres."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "L\u2019ann\xE9e\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907347210240
    m_Localized: "Salut, partenaire\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693312
    m_Localized: "Si tu portes une solpierre \xE0 l\u2019oreille,"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693313
    m_Localized: "\xE7a te chatouillera les neurones."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153282
    m_Localized: "Tu pourrais entendre une chanson\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153283
    m_Localized: "Je n\u2019entends rien\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153284
    m_Localized: "Peut-\xEAtre parce que je n\u2019ai pas"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153285
    m_Localized: "un cerveau humain\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153286
    m_Localized: "Comment \xE7a\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153287
    m_Localized: "Nous sommes humains\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153288
    m_Localized: "Pas vrai\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "Bien le bonjour\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "Bienvenue dans la vall\xE9e de Solpierre\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: "L\u2019authentique repr\xE9sentation de notre"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: grande histoire de minage du cristal.
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: "Le tout avec les commodit\xE9s"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: "de la modernit\xE9\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: "Je m\u2019appelle Jenny,"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "je travaille ici depuis\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: "73\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "\u2026\_ans\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: "Profitez bien de votre s\xE9jour\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: "Le code wi-fi est\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: "6\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: "7\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: "4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: "4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: "4\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "Le rayonnement min\xE9ral est l\u2019\xE9nergie du futur\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709376
    m_Localized: Sans lui,
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709377
    m_Localized: "il n\u2019y aurait pas de\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709378
    m_Localized: "robots\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438646992363520
    m_Localized: Ces chariots
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112256
    m_Localized: "\xE9taient utilis\xE9s pour traverser"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112257
    m_Localized: "des mines dangereuses o\xF9 nous,"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112258
    m_Localized: les ouvriers,
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112259
    m_Localized: explorons et extrayons
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112260
    m_Localized: "les solpierres\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112261
    m_Localized: "Ironiquement\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112262
    m_Localized: Pour les utiliser,
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112263
    m_Localized: "il ne faut pas \xEAtre mineur\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191595347968
    m_Localized: Notre monde
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096704
    m_Localized: "fonctionne gr\xE2ce \xE0 ces pierres brillantes."
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096705
    m_Localized: "Le saviez-vous\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096706
    m_Localized: "Une seule poign\xE9e suffit"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096707
    m_Localized: "\xE0 alimenter"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096708
    m_Localized: tout un quartier.
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096709
    m_Localized: "Int\xE9ressant, n\u2019est-ce pas\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375914909696
    m_Localized: "Bonjour les enfants\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047040
    m_Localized: "Lequel de ces sons d\u2019animaux ne vient pas"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047041
    m_Localized: "de la vall\xE9e de Solpierre\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782301851648
    m_Localized: "Allez, vous pouvez y arriver\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406080
    m_Localized: "Encore un tout petit peu\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406081
    m_Localized: "On y est presque\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406082
    m_Localized: "Ha ha\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406083
    m_Localized: "C\u2019est compl\xE8tement fou, hein\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406084
    m_Localized: "C\u2019est comme \xE7a, par ici\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 5022492442746880
    m_Localized: "Mon cheval est MORT\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717449428992
    m_Localized: "Bouh\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372032
    m_Localized: "Je me cache derri\xE8re le cylindre vert\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372033
    m_Localized: "Ha ha ha\_!"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
