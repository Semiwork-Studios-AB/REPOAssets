  m_TableData:
  - m_Id: 1049453162127360
    m_Localized: "\u0417\u0430\u043A\u0430\u0442\u0430\u0439\u0442\u0435 \u043C\u0435\u043D\u0435
      \u0432 \u0431\u0430\u043D\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 1049453208264704
    m_Localized: "\u0456 \u043D\u0430\u0437\u0432\u0456\u0442\u044C \u043A\u0432\u0430\u0441\u043E\u043B\u0435\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067686980214784
    m_Localized: "\u042F \u0431\u0430\u0447\u0443 \u043A\u0430\u043C'\u044F\u043D\u0435
      \u0441\u044F\u0439\u0432\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687022157824
    m_Localized: "\u043D\u0430\u0432\u0456\u0442\u044C \u0456\u0437 \u0437\u0430\u043F\u043B\u044E\u0449\u0435\u043D\u0438\u043C\u0438
      \u043E\u0447\u0438\u043C\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352128
    m_Localized: "\u0425\u0410-\u0425\u0410!"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352129
    m_Localized: "\u0422\u0430\u043A \u0442\u043E\u0434\u0456 \u0432\u0441\u0456
      \u0433\u043E\u0432\u043E\u0440\u0438\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352130
    m_Localized: "\u041A\u0430\u043C'\u044F\u043D\u0435 \u0441\u044F\u0439\u0432\u043E\_\u2014
      \u0446\u0435 \u0441\u0432\u0456\u0442\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352131
    m_Localized: "\u0432\u0438\u0441\u043E\u043A\u043E\u0435\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u043D\u0456
      \u0447\u0430\u0441\u0442\u0438\u043D\u043A\u0438, \u0449\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352132
    m_Localized: "\u0432\u0438\u043F\u0440\u043E\u043C\u0456\u043D\u044E\u044E\u0442\u044C\u0441\u044F
      \u0441\u043E\u043D\u044F\u0447\u043D\u0438\u043C\u0438 \u043A\u0430\u043C\u0435\u043D\u044F\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1067687026352133
    m_Localized: "\u0420\u0456\u043A \u0431\u0443\u0432..."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907347210240
    m_Localized: "\u0410\u0433\u043E\u0432, \u043F\u0440\u0438\u044F\u0442\u0435\u043B\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693312
    m_Localized: "\u041F\u0456\u0434\u043D\u0435\u0441\u0438 \u0441\u043E\u043D\u044F\u0447\u043D\u0438\u0439
      \u043A\u0430\u043C\u0456\u043D\u044C \u0434\u043E \u0432\u0443\u0445\u0430\_\u2014"
    m_Metadata:
      m_Items: []
  - m_Id: 1365444215693313
    m_Localized: "\u043C\u043E\u0436\u0435, \u0432\u0456\u043D \u043F\u043E\u043B\u043E\u0441\u043A\u043E\u0447\u0435
      \u0442\u0432\u043E\u0457 \u043D\u0435\u0439\u0440\u043E\u043D\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153282
    m_Localized: "\u0410 \u0442\u0430\u043C, \u0434\u0438\u0432\u0438\u0441\u044C,
      \u0456 \u043F\u0456\u0441\u043D\u044E \u043F\u043E\u0447\u0443\u0454\u0448!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153283
    m_Localized: "\u042F \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0447\u0443\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153284
    m_Localized: "\u041C\u043E\u0436\u0435, \u0442\u043E\u043C\u0443, \u0449\u043E
      \u0432 \u043C\u0435\u043D\u0435 \u043D\u0435\u043C\u0430\u0454"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153285
    m_Localized: "\u043B\u044E\u0434\u0441\u044C\u043A\u043E\u0433\u043E \u043C\u043E\u0437\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153286
    m_Localized: "\u042F\u043A \u0446\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153287
    m_Localized: "\u041C\u0438 \u0436 \u043B\u044E\u0434\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 1363907389153288
    m_Localized: "\u041F\u0440\u0430\u0432\u0434\u0430 \u0436?"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734112038912
    m_Localized: "\u0412\u0456\u0442\u0430\u044E, \u0433\u043E\u0441\u0442\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981952
    m_Localized: "\u041B\u0430\u0441\u043A\u0430\u0432\u043E \u043F\u0440\u043E\u0448\u0443
      \u043D\u0430 \u043A\u0443\u0440\u043E\u0440\u0442 \xAB\u0414\u043E\u043B\u0438\u043D\u0430
      \u0441\u043E\u043D\u044F\u0447\u043D\u043E\u0433\u043E \u043A\u0430\u043C\u0435\u043D\u044F\xBB!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981953
    m_Localized: "\u041D\u0430\u0439\u0434\u043E\u0441\u0442\u043E\u0432\u0456\u0440\u043D\u0456\u0448\u0435
      \u0432\u0456\u0434\u0442\u0432\u043E\u0440\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981954
    m_Localized: "\u043D\u0430\u0448\u043E\u0457 \u0441\u043B\u0430\u0432\u0435\u0442\u043D\u043E\u0457
      \u0456\u0441\u0442\u043E\u0440\u0456\u0457 \u0432\u0438\u0434\u043E\u0431\u0443\u0442\u043A\u0443
      \u043A\u0440\u0438\u0441\u0442\u0430\u043B\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981955
    m_Localized: "\u0406, \u0437\u0432\u0456\u0441\u043D\u043E, \u0443\u0441\u0456
      \u0437\u0440\u0443\u0447\u043D\u043E\u0441\u0442\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981956
    m_Localized: "\u0441\u0443\u0447\u0430\u0441\u043D\u043E\u0433\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981957
    m_Localized: "\u041C\u0435\u043D\u0435 \u0437\u0432\u0443\u0442\u044C \u0414\u0436\u0435\u043D\u043D\u0456,"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981958
    m_Localized: "\u0456 \u044F \u043F\u0440\u0430\u0446\u044E\u044E \u0442\u0443\u0442
      \u0443\u0436\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981959
    m_Localized: 73...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981960
    m_Localized: "... \u0440\u043E\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981961
    m_Localized: "\u0421\u043F\u043E\u0434\u0456\u0432\u0430\u044E\u0441\u044F, \u0432\u0430\u043C
      \u0442\u0443\u0442 \u0441\u043F\u043E\u0434\u043E\u0431\u0430\u0454\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981962
    m_Localized: "\u041F\u0430\u0440\u043E\u043B\u044C \u0434\u043E \u0432\u0430\u0439-\u0444\u0430\u044E..."
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981963
    m_Localized: 6...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981964
    m_Localized: 7...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981965
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1426734153981966
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1428943054823424
    m_Localized: 4...
    m_Metadata:
      m_Items: []
  - m_Id: 1435852471349248
    m_Localized: "\u041A\u0430\u043C'\u044F\u043D\u0435 \u0441\u044F\u0439\u0432\u043E\_\u2014
      \u0446\u0435 \u0435\u043D\u0435\u0440\u0433\u0456\u044F \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709376
    m_Localized: "\u0411\u0435\u0437 \u043D\u044C\u043E\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709377
    m_Localized: "\u043D\u0435 \u0431\u0443\u043B\u043E \u0431..."
    m_Metadata:
      m_Items: []
  - m_Id: 1435852500709378
    m_Localized: "\u0440\u043E\u0431\u043E\u0442\u0456\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438646992363520
    m_Localized: "\u041D\u0430 \u0446\u0438\u0445 \u0432\u0430\u0433\u043E\u043D\u0435\u0442\u043A\u0430\u0445"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112256
    m_Localized: "\u043C\u0438, \u0448\u0430\u0445\u0442\u0430\u0440\u0456, \u0457\u0437\u0434\u0438\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112257
    m_Localized: "\u0442\u0435\u043C\u043D\u0438\u043C\u0438 \u043D\u0435\u0431\u0435\u0437\u043F\u0435\u0447\u043D\u0438\u043C\u0438
      \u0448\u0430\u0445\u0442\u0430\u043C\u0438,"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112258
    m_Localized: "\u0434\u0435 \u0448\u0443\u043A\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112259
    m_Localized: "\u0439 \u0432\u0438\u0434\u043E\u0431\u0443\u0432\u0430\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112260
    m_Localized: "\u0441\u043E\u043D\u044F\u0447\u043D\u0456 \u043A\u0430\u043C\u0435\u043D\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112261
    m_Localized: "\u0406\u0440\u043E\u043D\u0456\u044F \u0432 \u0442\u043E\u043C\u0443\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112262
    m_Localized: "\u0449\u043E \u043A\u0430\u0442\u0430\u0442\u0438\u0441\u044F \u043D\u0430
      \u043D\u0438\u0445\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 1438647030112263
    m_Localized: "\u043C\u043E\u0436\u043D\u0430 \u043B\u0438\u0448\u0435 \u0434\u043E\u0440\u043E\u0441\u043B\u0438\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191595347968
    m_Localized: "\u041D\u0430\u0448 \u0441\u0432\u0456\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096704
    m_Localized: "\u043F\u0440\u0430\u0446\u044E\u0454 \u043D\u0430 \u0446\u0438\u0445
      \u0434\u0438\u0432\u043D\u0438\u0445 \u043A\u0430\u043C\u0435\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096705
    m_Localized: "\u0410 \u0432\u0438 \u0437\u043D\u0430\u043B\u0438, \u0449\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096706
    m_Localized: "\u0432\u0441\u044C\u043E\u0433\u043E \u043A\u0456\u043B\u044C\u043A\u043E\u0445
      \u0448\u0442\u0443\u043A \u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096707
    m_Localized: "\u0434\u043B\u044F \u0437\u0430\u0431\u0435\u0437\u043F\u0435\u0447\u0435\u043D\u043D\u044F
      \u0435\u043D\u0435\u0440\u0433\u0456\u0454\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096708
    m_Localized: "\u0432\u0435\u043B\u0438\u043A\u043E\u0433\u043E \u043C\u0456\u0441\u0442\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 1806191633096709
    m_Localized: "\u0414\u043E\u0432\u043E\u043B\u0456 \u0446\u0456\u043A\u0430\u0432\u043E,
      \u043F\u0440\u0430\u0432\u0434\u0430?"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375914909696
    m_Localized: "\u041F\u0440\u0438\u0432\u0456\u0442, \u0434\u0456\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047040
    m_Localized: "\u042F\u043A\u0456 \u0437 \u0446\u0438\u0445 \u0437\u0432\u0443\u043A\u0456\u0432
      \u0442\u0432\u0430\u0440\u0438\u043D \u043D\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2505375961047041
    m_Localized: "\u0434\u043B\u044F \u0414\u043E\u043B\u0438\u043D\u0438 \u0441\u043E\u043D\u044F\u0447\u043D\u043E\u0433\u043E
      \u043A\u0430\u043C\u0435\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782301851648
    m_Localized: "\u041D\u0443\u043C\u043E, \u0434\u0440\u0443\u0437\u0456, \u0432\u0438
      \u0437\u043C\u043E\u0436\u0435\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406080
    m_Localized: "\u0429\u0435 \u0437\u043E\u0432\u0441\u0456\u043C \u0442\u0440\u0456\u0448\u0435\u0447\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406081
    m_Localized: "\u041C\u0430\u0439\u0436\u0435 \u0433\u043E\u0442\u043E\u0432\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406082
    m_Localized: "\u0425\u0430-\u0445\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406083
    m_Localized: "\u041D\u0443 \u0456 \u0431\u043E\u0436\u0435\u0432\u0456\u043B\u043B\u044F,
      \u0435\u0433\u0435 \u0436?"
    m_Metadata:
      m_Items: []
  - m_Id: 3615782335406084
    m_Localized: "\u0422\u0430\u043A \u0432\u0436\u0435 \u0442\u0443\u0442 \u0437\u0430\u0432\u0435\u0434\u0435\u043D\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 5022492442746880
    m_Localized: "\u041C\u0456\u0439 \u043A\u0456\u043D\u044C \u0417\u0414\u041E\u0425..."
    m_Metadata:
      m_Items: []
  - m_Id: 6150717449428992
    m_Localized: "\u0411\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372032
    m_Localized: "\u042F \u0445\u043E\u0432\u0430\u044E\u0441\u044F \u0437\u0430
      \u0437\u0435\u043B\u0435\u043D\u0438\u043C \u0446\u0438\u043B\u0456\u043D\u0434\u0440\u043E\u043C!"
    m_Metadata:
      m_Items: []
  - m_Id: 6150717491372033
    m_Localized: "\u0425\u0430-\u0445\u0430-\u0445\u0430!"
    m_Metadata:
      m_Items: []
  references:
