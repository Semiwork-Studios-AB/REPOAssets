    - rid: 2515126557588324457
  m_TableData:
  - m_Id: 26547416404832256
    m_Localized: Maintenir pour retenter votre chance ({cost})
    m_Metadata:
      m_Items:
      - rid: 2515126557588324457
  - m_Id: 22956499448881152
    m_Localized: '[back] pour passer'
    m_Metadata:
      m_Items: []
  - m_Id: 2984229311066112
    m_Localized: "Point d\u2019extraction activ\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: "Mission d\u2019extraction termin\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: FOCUS
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "Rapportez le butin au point d\u2019extraction"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: "\xC9vitez les grenades\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "Trouvez le prochain point d\u2019extraction"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: "Retournez au camion\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: "Achetez des articles \xE0 la boutique"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: "Profitez du trajet, r\xE9approvisionnez-vous et \xC9QUIPEZ-VOUS\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: "Beau boulot\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: "Utilisez [move] pour vous d\xE9placer."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "D\xE9placez-vous pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "Utilisez [move] jusqu\u2019\xE0 ce que la barre de progression
      soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: Appuyez sur [jump] pour sauter.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "Sautez pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "Appuyez sur [jump] pour sauter jusqu\u2019\xE0 ce que la barre
      de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Appuyez sur [crouch] pour vous accroupir. Les monstres auront plus
      de mal \xE0 vous voir."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "Restez en position accroupie pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "Maintenez [crouch] et utilisez [move] jusqu\u2019\xE0 ce que la
      barre de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: "Utilisez [crouch] pour vous faufiler sous des \xE9l\xE9ments du
      d\xE9cor et vous cacher."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "Cachez-vous pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "Maintenez [crouch] et glissez-vous sous un \xE9l\xE9ment du d\xE9cor,
      puis restez en place jusqu\u2019\xE0 ce que la barre de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "Maintenez [sprint] pour sprinter. Cette action consomme de l\u2019\xE9nergie."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "Sprintez pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "Maintenez [sprint] et utilisez [move] pour sprinter jusqu\u2019\xE0
      ce que la barre de progression soit remplie\_! Si vous tombez \xE0 court d\u2019\xE9nergie,
      attendez qu\u2019elle se r\xE9g\xE9n\xE8re\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Courez et appuyez sur [tumble] pour effectuer une glissade tout
      en \xE9l\xE9gance. Sauter peut aider\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "Courez, sautez et effectuez une glissade pour remplir la barre
      de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Courez avec [sprint], sautez avec [jump] et appuyez sur [tumble]
      pour effectuer une glissade. R\xE9p\xE9tez ces actions jusqu\u2019\xE0 ce que
      la barre de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: Saisissez des objets en utilisant [grab].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "Transportez l\u2019objet pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "Maintenez [grab] sur un objet jusqu\u2019\xE0 ce que la barre de
      progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "Utilisez [pushAndPull] pour modifier la distance \xE0 laquelle
      vous tenez un objet devant vous."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "Modifiez la distance d\u2019un objet que vous tenez\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "Maintenez [grab] sur un objet et utilisez [pushAndPull] pour modifier
      la distance de l\u2019objet\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: Faites pivoter les objets que vous tenez en utilisant [grab2].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "Faites pivoter un objet pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "Lorsque vous tenez un objet avec [grab], maintenez [grab2] et d\xE9placez
      la vis\xE9e pour le faire pivoter. Continuez jusqu\u2019\xE0 ce que la barre
      de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "Saisissez un objet et appuyez sur [interact] pour l\u2019activer."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "Activez et d\xE9sactivez l\u2019objet\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "Saisissez la balle avec [grab], puis activez-la et d\xE9sactivez-la
      en utilisant [interact] jusqu\u2019\xE0 ce que la barre de progression soit
      remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "Saisissez un objet et utilisez [inventory1]/[inventory2]/[inventory3]
      pour l\u2019ajouter \xE0 votre inventaire."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "Remplissez votre inventaire\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "Lorsque vous tenez un objet \xE0 l\u2019aide de la touche [grab],
      appuyez sur [inventory1]/[inventory2]/[inventory3]. Assignez un objet \xE0
      chaque emplacement pour remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: "Utilisez [inventory1]/[inventory2]/[inventory3] pour sortir des
      objets de l\u2019inventaire."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "Videz votre inventaire\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "Utilisez [inventory1]/[inventory2]/[inventory3] pour vider tous
      les emplacements de l\u2019inventaire et remplir la barre de progression\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "Utilisez [map] pour afficher la carte. La carte est <b><u>IMPORTANTE</u></b>
      pour vous rep\xE9rer."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: "Consultez la carte\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "Maintenez [map] et gardez la carte affich\xE9e jusqu\u2019\xE0
      ce que la barre de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "Voici un C.A.D.D.I.E. Attrapez-le par la poign\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "Faites un petit tour avec le C.A.D.D.I.E.\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "Prenez le C.A.D.D.I.E. par la poign\xE9e avec [grab] et d\xE9placez-vous
      jusqu\u2019\xE0 ce que la barre de progression soit remplie\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "Remplissez les C.A.D.D.I.E.s d\u2019objets de valeur. Les C.A.D.D.I.E.s
      sont <b><u>IMPORTANTS</u></b> pour transporter davantage de butin."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "Remplissez le C.A.D.D.I.E. d\u2019objets de valeur\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "D\xE9posez trois objets dans le C.A.D.D.I.E."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Activez les <b><u>POINTS D\u2019EXTRACTION</u></b> et rapportez-y
      un maximum de butin."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "Trouvez les objets de valeur\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "BONJOUR\_! RAPPORTEZ DU BUTIN AU <b><u>POINT D\u2019EXCTRACTION</u></b>\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "Entrez dans le <b><u>CAMION</u></b> et envoyez un message \xE0
      votre patron pour quitter le niveau."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "Montez dans le camion et envoyez un message\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "Montez dans le camion et maintenez [grab] sur l\u2019espace messagerie
      de l\u2019\xE9cran du camion pour envoyer un message\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "Partagez vos points de vie avec d\u2019autres joueurs en les attrapant
      par le cou\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "R\xE9animez les autres joueurs en r\xE9cup\xE9rant leurs t\xEAtes\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "Achetez des <b><u>CRISTAUX D\u2019\xC9NERGIE</u></b> pour la <b><u>STATION
      DE RECHARGE</u></b> afin de recharger et r\xE9parer votre \xE9quipement\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "Un seul <b><u>POINT D\u2019EXTRACTION</u></b> peut \xEAtre actif
      \xE0 la fois. Trouvez le point actif \xE0 l\u2019aide de la carte\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "Appuyer sur [chat] pour ouvrir le chat\_! \xC7a va \xEAtre amusant\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "Il est temps de partir. Le camion vous soigne et r\xE9anime les
      joueurs dont vous avez r\xE9cup\xE9r\xE9 la t\xEAte\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "Ce niveau comporte de multiples <b><u>POINTS D\u2019EXTRACTION</u></b>.
      Terminez-les tous pour pouvoir quitter le niveau\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "Voici la <b><u>BOUTIQUE</u></b>. R\xE9cup\xE9rez des objets de
      valeur pour obtenir de l\u2019\xE9quipement. Les d\xE9g\xE2ts subis seront
      soign\xE9s en sortant\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "Utilisez [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      pour exprimer vos \xE9motions. Vous pouvez m\xEAme faire des m\xE9langes\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "Si vous utilisez votre rayon tracteur sur un monstre, une jauge
      de surcharge appara\xEEtra. Si la jauge est remplie, votre personnage sera
      violemment repouss\xE9 en arri\xE8re."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "Si plusieurs joueurs utilisent leur rayon tracteur sur un monstre,
      l\u2019effet de surcharge diminue."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "Lorsque vous mourez, utilisez la charge de la batterie de votre
      t\xEAte pour la poss\xE9der un bref moment."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "Pendant la possession, maintenez [jump] pour sauter. Un appui prolong\xE9
      permet de sauter plus haut, mais cela consomme davantage d\u2019\xE9nergie."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "OH, LE JOLI TOUTOU\_!"
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "Rapportez un maximum d\u2019objets de valeur aux <b><u>POINTS D\u2019EXTRACTION</u></b>."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "Voici une <b><u>BO\xCETE DE COSM\xC9TIQUES</u></b>. R\xE9cup\xE9rez-la
      pour obtenir une r\xE9compense."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: "En cas de d\xE9g\xE2ts, vous pouvez <b><u>SOIGNER</u></b> la bo\xEEte
      en d\xE9pensant vos points de vie."
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "Ins\xE9rez des <b><u>JETONS</u></b> dans la machine de la boutique
      pour obtenir vos r\xE9compenses."
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: "Appuyer sur [interact] pour ins\xE9rer un jeton"
    m_Metadata:
      m_Items: []
  - m_Id: 26094195824295936
    m_Localized: "C.A.D.D.I.E.\_\u2013\_Canon"
    m_Metadata:
      m_Items: []
  - m_Id: 26094195849461760
    m_Localized: "C.A.D.D.I.E.\_\u2013\_Laser"
    m_Metadata:
      m_Items: []
  - m_Id: 30522141892837376
    m_Localized: "Mode\_: Puissant"
    m_Metadata:
      m_Items: []
  - m_Id: 30522141918003200
    m_Localized: "Mode\_: Faible"
    m_Metadata:
      m_Items: []
  - m_Id: 26094195849461761
    m_Localized: C.A.D.D.I.E.
    m_Metadata:
