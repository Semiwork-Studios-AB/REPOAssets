  m_TableData:
  - m_Id: 2984229311066112
    m_Localized: Extraheringspunkt Aktiverad
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: "Extraheringspunkt F\xE4rdig"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "Fyll Extraheringspunkten med v\xE4rdesaker"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: Undvik granaterna!
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "Hitta n\xE4sta Extraheringspunkt"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: Spring till Trucken!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: Bra jobb!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: "Anv\xE4nd [move] f\xF6r att r\xF6ra dig."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "R\xF6r dig f\xF6r att fylla f\xF6rloppsindikatorn."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "Anv\xE4nd [move] p\xE5 ditt tangentbord tills f\xF6rloppsindikatorn
      \xE4r fylld!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: "Tryck [jump] f\xF6r att hoppa."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "Hoppa f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "Tryck [jump] f\xF6r att hoppa tills f\xF6rloppsindikatorn \xE4r
      fylld!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Tryck [crouch] f\xF6r att smyga. Monster har sv\xE5rt att se dig
      d\xE5."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "Smyg f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "H\xE5ll [crouch] och anv\xE4nd [move] tills f\xF6rloppsindikatorn
      \xE4r fylld!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: "Anv\xE4nd [crouch] f\xF6r att smyga under m\xF6bler och g\xF6mma
      dig."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "G\xF6m dig f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "H\xE5ll [crouch] och g\xE5 in under en m\xF6bel. Stanna d\xE4r
      tills du fyller f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "H\xE5ll ner [sprint] f\xF6r att springa. Detta t\xF6mmer din energi."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "Spring f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "H\xE5ll [sprint] och anv\xE4nd [move] f\xF6r att springa tills
      du fyller f\xF6rloppsindikatorn! Om energin tar slut f\xE5r du v\xE4nta tills
      den regenerar!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Spring och tryck [tumble] f\xF6r att falla med stil. Att hoppa
      hj\xE4lper ocks\xE5!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "Spring, hoppa och tumla f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Spring med [sprint], hoppa med [jump] och tryck [tumble] f\xF6r
      att kasta dig sj\xE4lv. G\xF6r det tills du fyller f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: 'Grabba saker med [grab]'
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "Lyft den d\xE4r saken f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "Tryck och h\xE5ll [grab] p\xE5 ett object tills du fyller f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "Anv\xE4nd [pushAndPull] f\xF6r att \xE4ndra distansen du h\xE5ller
      ett objekt."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\xC4ndra distansen p\xE5 ett grabbat objekt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "Tryck och h\xE5ll [grab] p\xE5 ett objekt och anv\xE4nd [pushAndPull]
      f\xF6r att \xE4ndra distansen p\xE5 objektet du grabbat!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: 'Rotera grabbade objekt med [grab2]'
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "Rotera saker f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "N\xE4r du h\xE5ller ett objekt med [grab], tryck och h\xE5ll [grab2]
      och r\xF6r ditt sikte f\xF6r att rotera det. Rotera tills du fyller f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "Grabba och tryck [interact] f\xF6r aktivera utrustning."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "S\xE4tt p\xE5 och st\xE4ng av utrustningen!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "Grabba bollen med [grab] och aktivera och avaktivera den med [interact]
      tills f\xF6rloppsindikatorn fylls!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "Grabba utrustning och anv\xE4nd [inventory1]/[inventory2]/[inventory3]
      f\xF6r att l\xE4gga den i ditt inventarie."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: Fyll ditt inventarie!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "N\xE4r du h\xE5ller ett objekt med [grab], tryck [inventory1]/[inventory2]/[inventory3].
      Fyll alla slots i ditt inventarie f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: "Anv\xE4nd [inventory1]/[inventory2]/[inventory3] f\xF6r att plocka
      ut utrustning ur ditt inventarie."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "T\xF6m ditt inventarie!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "Anv\xE4nd [inventory1]/[inventory2]/[inventory3] och t\xF6m alla
      slots f\xF6r att fylla f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "Anv\xE4nd [map] f\xF6r att visa kartan. Kartan \xE4r <b><u>VIKTIG</u></b>
      f\xF6r navigering."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: Checka kartan!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "H\xE5ll ner [map] och checka den tills du fyllt f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "Detta \xE4r en V.A.G.N. Ta den vid rodret!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "G\xE5 runt med V.A.G.N.en lite!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "Grabba V.A.G.N.en vid rodret  med [grab] och g\xE5 runt med den
      tills du fyllt f\xF6rloppsindikatorn!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "Fyll V.A.G.N.en med v\xE4rdesaker. V.A.G.N.en \xE4r <b><u>VIKTIG</u></b>
      f\xF6r att den kan b\xE4ra massa grunkor."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "Fyll V.A.G.N.en med v\xE4rdesaker!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "L\xE4gg tre grunkor i V.A.G.N.en"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Aktivera och fyll <b><u>EXTRAHERINGSPUNKTEN</u></b> med v\xE4rdesaker."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "Extrahera v\xE4rdesakerna!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "HEJSAN! FYLL<b><u>EXTRAHERINGSPUNKTEN</u></b> MED V\xC4RDESAKER!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "Kliv in i <b><u>TRUCKEN</u></b> och skicka ett meddelande till
      chefen f\xF6r att l\xE4mna en bana."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: Kliv in i trucken och skicka ett meddelande!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "G\xE5 in i trucken. Grabba tag och h\xE5ll i meddelandef\xE4ltet
      p\xE5 trucksk\xE4rmen med [grab] f\xF6r att skicka ett meddelande!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: Dela din livskraft med andra spelare genom att grabba tag i deras
      nackar!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "\xC5teruppliva andra spelare genom att extrahera deras huvuden!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "K\xF6p <b><u>STR\xD6MKRISTALLER</u></b> till <b><u>LADDSTATIONEN</u></b>
      f\xF6r att ladda och reparera din utrustning!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "Endast en <b><u>EXTRAHERINGSPUNKT</u></b> kan vara aktiv \xE5t
      g\xE5ngen. Hitta den via kartan!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: (se) Press [chat] to open the chat! It's fun!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "Dags att dra. Truken helar och \xE5terupplivar spelarhuvuden!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "Den h\xE4r banan har flera <b><u>EXTRAHERINGSPUNKTER</u></b>. Du
      m\xE5ste klara dem innan du kan l\xE4mna!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "Detta \xE4r <b><u>MACKEN</u></b>. Extrahera prylar f\xF6r att k\xF6pa.
      Ingen skada stannar h\xE4r!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "Anv\xE4nd [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      f\xF6r att g\xF6ra grimaser. Du kan tillochmed blanda dom!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: (se) Grabbing a monster will now cause overcharge, when full you
      get blasted.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "Flera spelare d\xE4mpar \xF6verbelastningseffekten."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "Under d\xF6den laddar ditt huvud. Anv\xE4nd den lilla kraft du
      har f\xF6r att kort kontrollera det."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "N\xE4r du hems\xF6ker ditt huvud. H\xE5ll in [jump] f\xF6r att
      hoppa. H\xE5ll in f\xF6r att hoppa l\xE4ngre. Men det dr\xE4nerar mer kraft."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: KLAPPA HUNDEN!
    m_Metadata:
      m_Items: []
  - m_Id: 22956499448881152
    m_Localized: '[back] skippa'
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "Fyll <b><u>EXTRAHERINGSPUNKTEN</u></b> med v\xE4rdesaker."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "Detta \xE4r en <b><u>SK\xD6NHETSL\xC5DA</u></b>, utvinn den f\xF6r
      en bel\xF6ning."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: "Om den skadas s\xE5 kan du <b><u>HELA</u></b> den med din egen
      h\xE4lsa."
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "Stoppa in <b><u>SKATTEPOLETTER</u></b> i butiksmaskinen f\xF6r
      att f\xE5 dina bel\xF6ningar."
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: FOKUSERA
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: "K\xF6p prylar i aff\xE4ren"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: "Njut av \xE5kturen, ladda upp grejerna och KITTA UPP!"
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: "Tryck [interact] f\xF6r att stoppa in skattepolletten"
    m_Metadata:
      m_Items: []
  - m_Id: 26094195824295936
    m_Localized: V.A.G.N. Kanon
    m_Metadata:
      m_Items: []
  - m_Id: 26094195849461760
