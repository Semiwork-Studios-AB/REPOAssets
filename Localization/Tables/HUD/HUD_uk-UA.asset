  m_TableData:
  - m_Id: 26547416404832256
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u0434\u043B\u044F
      \u0437\u0430\u043C\u0456\u043D\u0438 ({cost})"
    m_Metadata:
      m_Items:
      - rid: 2515126557588324470
  - m_Id: 22956499448881152
    m_Localized: "[back]: \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229311066112
    m_Localized: "\u0422\u043E\u0447\u043A\u0430 \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F
      \u0430\u043A\u0442\u0438\u0432\u043E\u0432\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: "\u0422\u043E\u0447\u043A\u0430 \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: "\u0413\u041E\u041B\u041E\u0412\u041D\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "\u0417\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C \u0442\u043E\u0447\u043A\u0443
      \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F \u0446\u0456\u043D\u043D\u0438\u043C\u0438
      \u0440\u0435\u0447\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: "\u0423\u043D\u0438\u043A\u0430\u0439\u0442\u0435 \u0433\u0440\u0430\u043D\u0430\u0442!"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "\u0417\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u043D\u0430\u0441\u0442\u0443\u043F\u0443
      \u0442\u043E\u0447\u043A\u0443 \u0432\u0438\u0432\u0435\u0434\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0434\u043E \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: "\u041A\u0443\u043F\u0443\u0439\u0442\u0435 \u0432 \u043A\u0440\u0430\u043C\u043D\u0438\u0446\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: "\u041F\u0440\u0438\u0454\u043C\u043D\u043E\u0457 \u043F\u043E\u0457\u0437\u0434\u043A\u0438
      \u2014 \u0437\u0430\u0440\u044F\u0434\u0456\u0442\u044C \u0443\u0441\u0435
      \u0439 \u0421\u041F\u041E\u0420\u042F\u0414\u0406\u0422\u042C\u0421\u042F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: "\u0427\u0443\u0434\u043E\u0432\u0430 \u0440\u043E\u0431\u043E\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: "[move]: \u0440\u0443\u0445\u0430\u0442\u0438\u0441\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "\u041F\u0435\u0440\u0435\u0441\u0443\u0432\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [move] \u043D\u0430 \u0441\u0432\u043E\u0454\u043C\u0443 \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u0457,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435 [jump],
      \u0449\u043E\u0431\u0438 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "\u0421\u0442\u0440\u0438\u0431\u0430\u0439\u0442\u0435, \u0449\u043E\u0431
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435 [jump],
      \u0449\u043E\u0431\u0438 \u0441\u0442\u0440\u0438\u0431\u0430\u0442\u0438,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C [crouch]
      \u0434\u043B\u044F \u0441\u043A\u0440\u0430\u0434\u0430\u043D\u043D\u044F.
      \u041C\u043E\u043D\u0441\u0442\u0440\u0430\u043C \u0431\u0443\u0434\u0435 \u0432\u0430\u0436\u0447\u0435
      \u0432\u0430\u0441 \u043F\u043E\u043C\u0456\u0442\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "\u0421\u043A\u0440\u0430\u0434\u0430\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 [crouch]
      \u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [move], \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [crouch], \u0449\u043E\u0431\u0438 \u043F\u0440\u043E\u043A\u0440\u0430\u0434\u0430\u0442\u0438\u0441\u044F
      \u043F\u0456\u0434 \u0447\u0438\u043C\u043E\u0441\u044C \u0456 \u0445\u043E\u0432\u0430\u0442\u0438\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "\u0425\u043E\u0432\u0430\u0439\u0442\u0435\u0441\u044F, \u0449\u043E\u0431
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 [crouch],
      \u043F\u0440\u043E\u0439\u0434\u0456\u0442\u044C \u043F\u0456\u0434 \u043E\u0431\u2019\u0454\u043A\u0442\u043E\u043C
      \u0456 \u0437\u0430\u043B\u0438\u0448\u0442\u0435\u0441\u044F \u0442\u0430\u043C,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 [sprint]
      \u0434\u043B\u044F \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E \u0431\u0456\u0433\u0443.
      \u0426\u0435 \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454 \u0435\u043D\u0435\u0440\u0433\u0456\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "\u0411\u0456\u0436\u0456\u0442\u044C \u0448\u0432\u0438\u0434\u043A\u043E,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 [sprint]
      \u0456 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [move] \u0434\u043B\u044F \u0448\u0432\u0438\u0434\u043A\u043E\u0433\u043E
      \u0431\u0456\u0433\u0443, \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443 \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!
      \u042F\u043A\u0449\u043E \u0437\u0430\u043A\u0456\u043D\u0447\u0438\u0442\u044C\u0441\u044F
      \u0435\u043D\u0435\u0440\u0433\u0456\u044F \u2014 \u043F\u043E\u0447\u0435\u043A\u0430\u0439\u0442\u0435,
      \u043F\u043E\u043A\u0438 \u0432\u043E\u043D\u0430 \u043D\u0435 \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C [tumble]
      \u043F\u0456\u0434 \u0447\u0430\u0441 \u0431\u0456\u0433\u0443, \u0449\u043E\u0431\u0438
      \u0441\u0442\u0438\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0438\u0442\u0438\u0441\u044F.
      \u0422\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u0442\u0438
      \u0441\u0442\u0440\u0438\u0431\u043E\u043A!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "\u0411\u0456\u0436\u0456\u0442\u044C, \u0441\u0442\u0440\u0438\u0431\u0430\u0439\u0442\u0435
      \u0439 \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u044F\u0439\u0442\u0435\u0441\u044F,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "\u0411\u0456\u0436\u0456\u0442\u044C \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      [sprint], \u0441\u0442\u0440\u0438\u0431\u0430\u0439\u0442\u0435 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [jump] \u0456 \u043D\u0430\u0442\u0438\u0441\u043A\u0430\u0439\u0442\u0435
      [tumble], \u0449\u043E\u0431 \u043A\u0438\u0434\u0430\u0442\u0438 \u0441\u0435\u0431\u0435.
      \u0420\u043E\u0431\u0456\u0442\u044C \u0446\u0435, \u043F\u043E\u043A\u0438
      \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443 \u043D\u0435
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: "\u0425\u0430\u043F\u0430\u0439\u0442\u0435 \u043E\u0431\u2019\u0454\u043A\u0442\u0438
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [grab]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "\u041D\u0435\u0441\u0456\u0442\u044C \u0446\u044E \u0440\u0456\u0447,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0439 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      [grab] \u043D\u0430 \u043E\u0431\u2019\u0454\u043A\u0442\u0456, \u043F\u043E\u043A\u0438
      \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443 \u043D\u0435
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [pushAndPull] \u0434\u043B\u044F \u0437\u043C\u0456\u043D\u0438 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
      \u0441\u0445\u043E\u043F\u043B\u0435\u043D\u0438\u0445 \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\u0417\u043C\u0456\u043D\u0456\u0442\u044C \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C
      \u0441\u0445\u043E\u043F\u043B\u0435\u043D\u043E\u0433\u043E \u043E\u0431\u2019\u0454\u043A\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0439 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      [grab] \u043D\u0430 \u043E\u0431\u2019\u0454\u043A\u0442\u0456 \u0442\u0430
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435 [pushAndPull]
      \u0434\u043B\u044F \u0437\u043C\u0456\u043D\u0438 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u0456
      \u0441\u0445\u043E\u043F\u043B\u0435\u043D\u043E\u0433\u043E \u043E\u0431\u2019\u0454\u043A\u0442\u0430!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: "\u041E\u0431\u0435\u0440\u0442\u0430\u0439\u0442\u0435 \u0441\u0445\u043E\u043F\u043B\u0435\u043D\u0456
      \u043E\u0431\u2019\u0454\u043A\u0442\u0438 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      [grab2]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "\u041E\u0431\u0435\u0440\u0442\u0430\u0439\u0442\u0435 \u0440\u0435\u0447\u0456,
      \u0449\u043E\u0431 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "\u0422\u0440\u0438\u043C\u0430\u044E\u0447\u0438 \u043E\u0431\u2019\u0454\u043A\u0442
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [grab],
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C \u0439 \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      [grab2], \u0442\u043E\u0434\u0456 \u0432\u043E\u0434\u0456\u0442\u044C \u043F\u0440\u0438\u0446\u0456\u043B\u043E\u043C,
      \u0449\u043E\u0431 \u043E\u0431\u0435\u0440\u0442\u0430\u0442\u0438. \u041E\u0431\u0435\u0440\u0442\u0430\u0439\u0442\u0435,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "\u0421\u0445\u043E\u043F\u0456\u0442\u044C \u0456 \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      [interact] \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0438\u043A\u0430\u043D\u043D\u044F
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "\u0423\u0432\u0456\u043C\u043A\u043D\u0456\u0442\u044C \u0456 \u0432\u0438\u043C\u043A\u043D\u0456\u0442\u044C
      \u0446\u044E \u0448\u0442\u0443\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "\u0421\u0445\u043E\u043F\u0456\u0442\u044C \u043A\u0443\u043B\u044E
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [grab],
      \u0430 \u0442\u043E\u0434\u0456 \u0432\u043C\u0438\u043A\u0430\u0439\u0442\u0435
      \u0439 \u0432\u0438\u043C\u0438\u043A\u0430\u0439\u0442\u0435 \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [interact], \u043F\u043E\u043A\u0438
      \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443 \u043D\u0435
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "\u0421\u0445\u043E\u043F\u0456\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0456 \u0441\u0445\u043E\u0432\u0430\u0439\u0442\u0435 \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [inventory1]/[inventory2]/[inventory3]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "\u0417\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C \u0432\u0435\u0441\u044C
      \u0441\u0432\u0456\u0439 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "\u0422\u0440\u0438\u043C\u0430\u044E\u0447\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [grab],
      \u043D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C [inventory1]/[inventory2]/[inventory3].
      \u0417\u0430\u0431\u0438\u0439\u0442\u0435 \u0432\u0441\u0456 \u043C\u0456\u0441\u0446\u044F
      \u0432 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0456, \u0449\u043E\u0431
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0448\u043A\u0430\u043B\u0443
      \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: "\u0412\u0438\u0439\u043C\u0430\u0439\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438
      \u0437 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u044E \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [inventory1]/[inventory2]/[inventory3]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "\u0417\u0432\u0456\u043B\u044C\u043D\u0456\u0442\u044C \u0432\u0435\u0441\u044C
      \u0441\u0432\u0456\u0439 \u0456\u043D\u0432\u0435\u043D\u0442\u0430\u0440!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [inventory1]/[inventory2]/[inventory3], \u0449\u043E\u0431\u0438 \u0437\u0432\u0456\u043B\u044C\u043D\u0438\u0442\u0438
      \u0432\u0441\u0456 \u043C\u0456\u0441\u0446\u044F \u0439 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438
      \u0448\u043A\u0430\u043B\u0443 \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "\u041F\u043E\u043A\u0430\u0436\u0456\u0442\u044C \u043C\u0430\u043F\u0443
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [map].
      \u041C\u0430\u043F\u0430 <b><u>\u0412\u0410\u0416\u041B\u0418\u0412\u0410</u></b>
      \u0434\u043B\u044F \u043E\u0440\u0456\u0454\u043D\u0442\u0430\u0446\u0456\u0457."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043C\u0430\u043F\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 [map] \u0456
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u0434\u0430\u0439\u0442\u0435 \u043C\u0430\u043F\u0443,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "\u0426\u0435 \u0412\u0406\u0417\u041E\u041A. \u0421\u0445\u043E\u043F\u0456\u0442\u044C
      \u0439\u043E\u0433\u043E \u0437\u0430 \u0440\u0443\u0447\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "\u041F\u043E\u0445\u043E\u0434\u0456\u0442\u044C \u0442\u0440\u043E\u0445\u0438
      \u0437 \u0412\u0406\u0417\u041A\u041E\u041C!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "\u0421\u0445\u043E\u043F\u0456\u0442\u044C \u0412\u0406\u0417\u041E\u041A
      \u0437\u0430 \u0440\u0443\u0447\u043A\u0443 \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E
      [grab] \u0456 \u043F\u043E\u0445\u043E\u0434\u0456\u0442\u044C \u0442\u0430\u043A,
      \u043F\u043E\u043A\u0438 \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443
      \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "\u0417\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C \u0412\u0406\u0417\u041E\u041A
      \u0446\u0456\u043D\u043D\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438.
      \u0412\u0406\u0417\u041A\u0418 \u0434\u0443\u0436\u0435 <b><u>\u0412\u0410\u0416\u041B\u0418\u0412\u0406</u></b>
      \u0434\u043B\u044F \u043F\u0435\u0440\u0435\u043C\u0456\u0449\u0435\u043D\u043D\u044F
      \u0440\u0435\u0447\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "\u0417\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C \u0412\u0406\u0417\u041E\u041A
      \u0446\u0456\u043D\u043D\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "\u041F\u043E\u043A\u043B\u0430\u0434\u0456\u0442\u044C \u0442\u0440\u0438
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0438 \u0434\u043E \u0412\u0406\u0417\u041A\u0410."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u0443\u0439\u0442\u0435 \u0439 \u043D\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C
      <b><u>\u0422\u041E\u0427\u041A\u0418 \u0412\u0418\u0412\u0415\u0414\u0415\u041D\u041D\u042F</u></b>
      \u0446\u0456\u043D\u043D\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "\u0412\u0438\u0432\u0435\u0434\u0456\u0442\u044C \u0446\u0456\u043D\u043D\u0456
      \u0440\u0435\u0447\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "\u041F\u0420\u0418\u0412\u0406\u0422! \u0417\u0410\u041F\u041E\u0412\u041D\u0406\u0422\u042C
      <b><u>\u0422\u041E\u0427\u041A\u0423 \u0412\u0418\u0412\u0415\u0414\u0415\u041D\u041D\u042F</u></b>
      \u0426\u0406\u041D\u041D\u0418\u041C\u0418 \u0420\u0415\u0427\u0410\u041C\u0418!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "\u0417\u0430\u043B\u0456\u0437\u044C\u0442\u0435 \u0434\u043E <b><u>\u0412\u0410\u041D\u0422\u0410\u0416\u0406\u0412\u041A\u0418</u></b>
      \u0439 \u043D\u0430\u0434\u0456\u0448\u043B\u0456\u0442\u044C \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F
      \u0448\u0435\u0444\u0443, \u0449\u043E\u0431 \u043F\u043E\u043A\u0438\u043D\u0443\u0442\u0438
      \u0440\u0456\u0432\u0435\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "\u0417\u0430\u043B\u0456\u0437\u044C\u0442\u0435 \u0434\u043E \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0438
      \u0439 \u043D\u0430\u0434\u0456\u0448\u043B\u0456\u0442\u044C \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "\u0406\u0434\u0456\u0442\u044C \u0443 \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0443,
      \u0442\u043E\u0434\u0456 \u0441\u0445\u043E\u043F\u0456\u0442\u044C \u0442\u0430
      \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435 \u0437\u043E\u043D\u0443
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F \u043D\u0430
      \u0435\u043A\u0440\u0430\u043D\u0456 \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0438
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [grab],
      \u0449\u043E\u0431 \u043D\u0430\u0434\u0456\u0441\u043B\u0430\u0442\u0438 \u043E\u043F\u043E\u0432\u0456\u0441\u0442\u043A\u0443!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "\u0414\u0456\u043B\u0456\u0442\u044C\u0441\u044F \u0441\u0432\u043E\u0457\u043C
      \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F\u043C \u0437 \u0456\u043D\u0448\u0438\u043C\u0438
      \u0433\u0440\u0430\u0432\u0446\u044F\u043C\u0438, \u0445\u0430\u043F\u0430\u044E\u0447\u0438
      \u0457\u0445 \u0437\u0430 \u0448\u0438\u044E!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "\u0412\u0456\u0434\u0440\u043E\u0434\u0436\u0443\u0439\u0442\u0435
      \u0456\u043D\u0448\u0438\u0445 \u0433\u0440\u0430\u0432\u0446\u0456\u0432,
      \u0432\u0438\u0432\u043E\u0434\u044F\u0447\u0438 \u0457\u0445\u043D\u0456 \u0433\u043E\u043B\u043E\u0432\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "\u041A\u0443\u043F\u0443\u0439\u0442\u0435 <b><u>\u0415\u041D\u0415\u0420\u0413\u041E\u041A\u0420\u0418\u0421\u0422\u0410\u041B\u0418</u></b>
      \u0434\u043B\u044F <b><u>\u0417\u0410\u0420\u042F\u0414\u041D\u041E\u0407 \u0421\u0422\u0410\u041D\u0426\u0406\u0407</u></b>,
      \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0442\u0438
      \u0439 \u0440\u0435\u043C\u043E\u043D\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u043F\u043E\u0440\u044F\u0434\u0436\u0435\u043D\u043D\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "\u0412\u043E\u0434\u043D\u043E\u0447\u0430\u0441 \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u0430 \u0442\u0456\u043B\u044C\u043A\u0438
      \u043E\u0434\u043D\u0430 <b><u>\u0422\u041E\u0427\u041A\u0410 \u0412\u0418\u0412\u0415\u0414\u0415\u041D\u041D\u042F</u></b>\_\u2014
      \u0437\u043D\u0430\u0439\u0434\u0456\u0442\u044C \u043F\u043E\u0442\u043E\u0447\u043D\u0443
      \u043D\u0430 \u043C\u0430\u043F\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "\u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C [chat],
      \u0449\u043E\u0431 \u0432\u0456\u0434\u0447\u0438\u043D\u0438\u0442\u0438 \u0447\u0430\u0442!
      \u0426\u0435 \u0432\u0435\u0441\u0435\u043B\u043E!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "\u0427\u0430\u0441 \u0432\u0456\u0434\u0431\u0443\u0432\u0430\u0442\u0438.
      \u0412\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0430 \u0437\u0446\u0456\u043B\u044E\u0454
      \u0432\u0430\u0441 \u0456 \u0432\u0456\u0434\u0440\u043E\u0434\u0436\u0443\u0454
      \u0437\u0456\u0431\u0440\u0430\u043D\u0456 \u0433\u043E\u043B\u043E\u0432\u0438
      \u0433\u0440\u0430\u0432\u0446\u0456\u0432!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "\u041D\u0430 \u0446\u044C\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u0454 \u0431\u0456\u043B\u044C\u0448\u0435 \u0432\u0456\u0434 \u043E\u0434\u043D\u0456\u0454\u0457
      <b><u>\u0422\u041E\u0427\u041A\u0418 \u0412\u0418\u0412\u0415\u0414\u0415\u041D\u041D\u042F</u></b>.
      \u041F\u0435\u0440\u0435\u0434 \u0432\u0438\u0445\u043E\u0434\u043E\u043C \u0442\u0440\u0435\u0431\u0430
      \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u0438 \u0432\u0441\u0456!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "\u0426\u0435 <b><u>\u041A\u0420\u0410\u041C\u041D\u0418\u0426\u042F</u></b>\_\u2014
      \u0432\u0438\u0432\u043E\u0434\u044C\u0442\u0435 \u0440\u0435\u0447\u0456,
      \u0449\u043E\u0431 \u043A\u0443\u043F\u0443\u0432\u0430\u0442\u0438 \u0457\u0445.
      \u0428\u043A\u043E\u0434\u0430 \u0442\u0443\u0442 \u043D\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6],
      \u0449\u043E\u0431\u0438 \u0437\u043C\u0456\u043D\u044E\u0432\u0430\u0442\u0438
      \u0432\u0438\u0440\u0430\u0437 \u043E\u0431\u043B\u0438\u0447\u0447\u044F.
      \u041C\u043E\u0436\u043D\u0430 \u043D\u0430\u0432\u0456\u0442\u044C \u0437\u043C\u0456\u0448\u0443\u0432\u0430\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "\u042F\u043A\u0449\u043E \u0441\u0445\u043E\u043F\u0438\u0442\u0438
      \u043C\u043E\u043D\u0441\u0442\u0440\u0430, \u0446\u0435 \u0441\u043F\u0440\u0438\u0447\u0438\u043D\u044F\u0454
      \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F.
      \u0412\u0456\u0434 \u043F\u043E\u0432\u043D\u043E\u0433\u043E \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F
      \u0432\u0430\u0441 \u0441\u043A\u043B\u0430\u0434\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "\u041A\u043E\u043B\u0438 \u043B\u044E\u0434\u0435\u0439 \u043A\u0456\u043B\u044C\u043A\u0430,
      \u0446\u0435 \u043F\u043E\u043C\u2019\u044F\u043A\u0448\u0438\u0442\u044C \u0435\u0444\u0435\u043A\u0442
      \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "\u0423 \u0441\u0442\u0430\u043D\u0456 \u0441\u043C\u0435\u0440\u0442\u0456
      \u0432\u0430\u0448\u0430 \u0433\u043E\u043B\u043E\u0432\u0430 \u0437\u0430\u0440\u044F\u0434\u0436\u0430\u0454\u0442\u044C\u0441\u044F\_\u2014
      \u0441\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435\u0441\u044F
      \u0446\u0438\u043C \u0437\u0430\u0440\u044F\u0434\u043E\u043C, \u0449\u043E\u0431
      \u0442\u0438\u043C\u0447\u0430\u0441\u043E\u0432\u043E \u0432\u0441\u0435\u043B\u0438\u0442\u0438\u0441\u044C
      \u0443 \u0441\u0432\u043E\u044E \u0433\u043E\u043B\u043E\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "\u0412\u0441\u0435\u043B\u0438\u0432\u0448\u0438\u0441\u044C \u0432
      \u0441\u0432\u043E\u044E \u0433\u043E\u043B\u043E\u0432\u0443, \u0443\u0442\u0440\u0438\u043C\u0443\u0439\u0442\u0435
      [jump], \u0449\u043E\u0431\u0438 \u0441\u0442\u0440\u0438\u0431\u043D\u0443\u0442\u0438.
      \u0412\u0438\u0449\u0438\u0439 \u0441\u0442\u0440\u0438\u0431\u043E\u043A \u0432\u0438\u0442\u0440\u0430\u0447\u0430\u0454
      \u0431\u0456\u043B\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "\u041F\u041E\u0413\u041B\u0410\u0414\u042C\u0422\u0415 \u0421\u041E\u0411\u0410\u041A\u0423!"
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "\u041D\u0430\u043F\u043E\u0432\u043D\u0456\u0442\u044C <b><u>\u0422\u041E\u0427\u041A\u0418
