  - m_Id: 59509086252937217
    m_Localized: "\u041F\u0443\u0441\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 84133915759992832
    m_Localized: "\u0412\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0439\u0442\u0435
      [pushPull], \u043D\u0430\u0432\u043E\u0434\u044F\u0447\u0438\u0441\u044C \u0437\u0430
      \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [aim], \u0449\u043E\u0431
      \u0437\u043C\u0456\u043D\u0438\u0442\u0438 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C
      \u0434\u043E \u0441\u0445\u043E\u043F\u043B\u0435\u043D\u0438\u0445 \u043E\u0431\u2019\u0454\u043A\u0442\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 84133915806130176
    m_Localized: "\u0423\u0442\u0440\u0438\u043C\u0443\u044E\u0447\u0438 \u043E\u0431'\u0454\u043A\u0442
      \u0447\u0435\u0440\u0435\u0437 [grab], \u0437\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      [pushPull] \u0456 \u0440\u0435\u0433\u0443\u043B\u044E\u0439\u0442\u0435 \u0432\u0456\u0434\u0441\u0442\u0430\u043D\u044C
      \u0437\u0430 \u0434\u043E\u043F\u043E\u043C\u043E\u0433\u043E\u044E [aim],
      \u0434\u043E\u043A\u0438 \u043D\u0435 \u0437\u0430\u043F\u043E\u0432\u043D\u0438\u0442\u044C\u0441\u044F
      \u0448\u043A\u0430\u043B\u0430 \u043F\u043E\u0441\u0442\u0443\u043F\u0443!"
    m_Metadata:
      m_Items: []
