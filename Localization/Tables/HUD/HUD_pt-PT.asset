    - rid: 6163163424511229957
  m_TableData:
  - m_Id: 2984229311066112
    m_Localized: "Ponto de extra\xE7\xE3o ativado"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: "Ponto de extra\xE7\xE3o conclu\xEDdo"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "Enche o ponto de extra\xE7\xE3o com objetos de valor"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: Evita as granadas!
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "Encontra o pr\xF3ximo ponto de extra\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: "Volta para o cami\xE3o!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: Bom trabalho!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: Usa [move] para te mover.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: Move-te para encher a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "Usa [move] no teclado at\xE9 a barra de progresso ficar cheia!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: Prime [jump] para saltar.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: Salta para encher a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "Prime [jump] para saltar at\xE9 a barra de progresso ficar cheia!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Prime [crouch] para te esgueirares. Assim, \xE9 menos prov\xE1vel
      que os monstros te vejam."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: Esgueira-te para encher a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "Mant\xE9m [crouch] premido e usa [move] at\xE9 a barra de progresso
      ficar cheia!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: "Mant\xE9m [crouch] premido para te esconderes debaixo de objetos."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: Esconde-te para encher a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "Mantendo [crouch], passa por baixo de um objeto e fica l\xE1 at\xE9
      encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "Mant\xE9m [sprint] premido para correr. Isto consome energia."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: Corre para encher a barra de progresso
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "Mant\xE9m [sprint] premido e usa [move] para correr at\xE9 encheres
      a barra de progresso! Se ficares sem energia, espera que recupere!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Corre e prime [tumble] para ca\xEDres com estilo. Saltar tamb\xE9m
      ajuda!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: Corre, salta e cai para encheres a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Corre com [sprint], salta com [jump] e prime [tumble] para te lan\xE7ares.
      Repete at\xE9 encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: Agarra objetos com [grab].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: Transporta esse objeto para encheres a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "Mant\xE9m [grab] premido num objeto at\xE9 encheres a barra de
      progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "Usa [pushAndPull] para ajustar a dist\xE2ncia dos objetos agarrados."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "Ajusta a dist\xE2ncia de um objeto agarrado!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "Mant\xE9m [grab] premido num objeto e usa [pushAndPull] para ajustar
      a dist\xE2ncia do objeto agarrado!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: Gira os objetos agarrados com [grab2].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: Gira objetos para encheres a barra de progresso!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "Enquanto seguras um objeto com [grab], mant\xE9m [grab2] premido
      e move a mira para o girares. Continua at\xE9 encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: Pega num objeto e prime [interact] para o ligar ou desligar.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: Liga e desliga esse objeto!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "Agarra a bola com [grab] e usa [interact] para a ligares e desligares
      at\xE9 encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "Agarra um objeto e usa [inventory1]/[inventory2]/[inventory3] para
      o guardares no invent\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "Enche todo o invent\xE1rio!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "Enquanto seguras um objeto com [grab], prime [inventory1]/[inventory2]/[inventory3].
      Preenche todos os espa\xE7os do invent\xE1rio para completares a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: "Use [inventory1]/[inventory2]/[inventory3] para retirar itens do
      invent\xE1rio."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "Esvazia todo o invent\xE1rio!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "Usa [inventory1]/[inventory2]/[inventory3] e esvazia todos os espa\xE7os
      para encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "Usa [map] para veres o mapa. O mapa \xE9 <b><u>IMPORTANTE</u></b>
      para te orientares."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: Consulta o mapa!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "Mant\xE9m [map] premido e consulta o mapa at\xE9 encheres a barra
      de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "Isto \xE9 um C.A.R.T. Agarra-o pelo puxador."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: Anda um pouco com o C.A.R.T.!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "Agarra o C.A.R.T. pelo puxador com [grab] e anda com ele at\xE9
      encheres a barra de progresso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "Enche os C.A.R.T.s com objetos de valor. Os C.A.R.T.s s\xE3o <b><u>IMPORTANTES</u></b>
      para transportares mais coisas."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: Enche o C.A.R.T. com objetos de valor!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "Coloca tr\xEAs objetos no C.A.R.T."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Ativa e enche os <b><u>PONTOS DE EXTRA\xC7\xC3O</u></b> com objetos
      de valor."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: Extrai os objetos de valor!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "OL\xC1! ENCHE O <b><u>PONTO DE EXTRA\xC7\xC3O</u></b> COM OBJETOS
      DE VALOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "Entra no <b><u>CAMI\xC3O</u></b> e envia uma mensagem ao teu chefe
      para sa\xEDres do n\xEDvel."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "Entra no cami\xE3o e envia uma mensagem!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "Entra no cami\xE3o, agarra a \xE1rea da mensagem no ecr\xE3 com
      [grab] e mant\xE9m premido para enviar a mensagem!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "Partilha a tua sa\xFAde com outros jogadores agarrando-os pelo
      pesco\xE7o!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "Reanima outros jogadores extraindo-lhes a cabe\xE7a!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "Compra <b><u>CRISTAIS DE ENERGIA</u></b> para a <b><u>ESTA\xC7\xC3O
      DE CARREGAMENTO</u></b> recarregar e reparar o teu equipamento!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "S\xF3 pode estar ativo um <b><u>PONTO DE EXTRA\xC7\xC3O</u></b>
      de cada vez. Usa o mapa para encontrares o ponto ativo!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "Prime [chat] para abrir o chat! \xC9 divertido!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "Est\xE1 na hora de sair! O cami\xE3o cura-te e reanima as cabe\xE7as
      de jogadores que levares contigo!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "Este n\xEDvel tem v\xE1rios <b><u>PONTOS DE EXTRA\xC7\xC3O</u></b>.
      Tens de concluir todos para poderes sair!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "Esta \xE9 a <b><u>LOJA</u></b>. Extrai os objetos que quiseres
      comprar. Aqui, nenhum dano \xE9 permanente!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "Usa [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      para fazeres express\xF5es. At\xE9 podes combin\xE1-las!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "Agarrar um monstro passa agora a causar sobrecarga. Quando chegar
      ao m\xE1ximo, \xE9s lan\xE7ado pelos ares."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "V\xE1rias pessoas reduzem o efeito da sobrecarga."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "Enquanto est\xE1s morto, a tua cabe\xE7a acumula carga. Usa-a para
      controlares a cabe\xE7a por breves instantes."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "Enquanto controlas a tua cabe\xE7a, mant\xE9m [jump] premido para
      saltar. Quanto mais tempo mantiveres, mais alto saltas e mais carga gastas."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "FAZ FESTAS \xC0 CADELA!"
    m_Metadata:
      m_Items: []
  - m_Id: 22956499448881152
    m_Localized: '[back] para ignorar'
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "Enche os <b><u>PONTOS DE EXTRA\xC7\xC3O</u></b> com objetos de
      valor."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "Esta \xE9 uma <b><u>CAIXA DE COSM\xC9TICOS</u></b>. Extrai-a para
      receberes algo especial!"
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: "Se a caixa sofrer danos, podes <b><u>REPAR\xC1-LA</u></b> usando
      a tua pr\xF3pria sa\xFAde."
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "Insere <b><u>TOKENS DE IMPOSTO</u></b> na m\xE1quina da loja para
      receberes as tuas recompensas."
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: FOCO
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: Compra coisas na loja
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: Aproveita a viagem, recupera energias e PREPARA-TE!
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: Prime [interact] para inserires o token de imposto.
    m_Metadata:
      m_Items: []
  - m_Id: 26094195824295936
    m_Localized: "C.A.R.T Canh\xE3o"
    m_Metadata:
