      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: "\u4F7F\u7528[grab2]\u4F86\u65CB\u8F49\u5DF2\u6293\u53D6\u7684\u7269\u54C1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "\u6301\u7E8C\u65CB\u8F49\u7269\u54C1\uFF0C\u4E00\u76F4\u5230\u9032\u5EA6\u689D\u586B\u6EFF\u70BA\u6B62\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "\u4F7F\u7528[grab]\u62FF\u4F4F\u7269\u54C1\u7684\u540C\u6642\uFF0C\u6309\u4F4F[grab2]\u4F86\u79FB\u52D5\u8996\u89D2\uFF0C\u5373\u53EF\u8F49\u52D5\u8A72\u7269\u54C1\u3002\u6301\u7E8C\u65CB\u8F49\u7269\u54C1\uFF0C\u4E00\u76F4\u5230\u9032\u5EA6\u689D\u586B\u6EFF\u70BA\u6B62\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "\u6293\u53D6\u7269\u54C1\u4E26\u6309\u4E0B[interact]\uFF0C\u5373\u53EF\u5207\u63DB\u7269\u54C1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "\u8A66\u8A66\u770B\u5207\u63DB\u5404\u7A2E\u4E0D\u540C\u7269\u54C1\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "\u53CD\u8986\u4F7F\u7528[grab]\u4F86\u628A\u90A3\u9846\u7403\u62FF\u8D77\u4F86\uFF0C\u4E26\u4E14\u4F7F\u7528[interact]\u5207\u63DB\uFF0C\u4E00\u76F4\u5230\u9032\u5EA6\u689D\u586B\u6EFF\u70BA\u6B62\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "\u6293\u53D6\u4E00\u4EF6\u7269\u54C1\u5F8C\uFF0C\u4F7F\u7528[inventory1]/[inventory2]/[inventory3]\u4F86\u5C07\u7269\u54C1\u653E\u5165\u9053\u5177\u6B04\u4F4D\u7576\u4E2D\u3002"
