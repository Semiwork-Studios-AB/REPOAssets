      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "\u0E01\u0E14 [crouch] \u0E04\u0E49\u0E32\u0E07\u0E41\u0E25\u0E49\u0E27\u0E40\u0E14\u0E34\u0E19\u0E40\u0E02\u0E49\u0E32\u0E44\u0E1B\u0E43\u0E15\u0E49\u0E1E\u0E23\u0E47\u0E2D\u0E1E
