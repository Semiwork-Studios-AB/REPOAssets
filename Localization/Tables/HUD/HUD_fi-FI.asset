  m_SharedData: {fileID: 11400000, guid: 64fd365dff4a0674f9ea9125eb765214, type: 2}
  m_Metadata:
    m_Items:
    - rid: 6163163424511229958
  m_TableData:
  - m_Id: 2984229311066112
    m_Localized: Toimituspiste aktivoitu
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: Toimituspiste valmis
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "T\xE4yt\xE4 toimituspiste arvoesineill\xE4"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: "V\xE4lttele kranaatteja!"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: Etsi seuraava toimituspiste
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: Palaa rekkaan!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: Hyvin tehty!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: Paina [move] liikkuaksesi
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "Liiku t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "Paina [move] n\xE4pp\xE4imist\xF6ss\xE4si kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: "Paina [jump] hypp\xE4\xE4ksesi."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "Hypp\xE4\xE4 t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "Paina [jump] kunnes edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Paina [crouch] hiipi\xE4ksesi. Hirvi\xF6t eiv\xE4t huomaa sinua
      silloin yht\xE4 helposti."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "Hiivi t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "Paina [crouch] ja liiku painamalla [move] t\xE4ytt\xE4\xE4ksesi
      edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: Paina [crouch] ja hiivi huonekalujen alle piiloutuaksesi.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "Piiloudu t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "Paina [crouch], hiivi huonekalun alle, ja pysy siell\xE4 kunnes
      edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "Paina [sprint] juostaksesi. T\xE4m\xE4 k\xE4ytt\xE4\xE4 energiaa."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "Juokse t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "Paina [sprint] ja liiku k\xE4ytt\xE4m\xE4ll\xE4 [move] kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Juokse, hypp\xE4\xE4 ja paina [tumble] heitt\xE4\xE4ksesi itsesi."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "Juokse, hypp\xE4\xE4 ja heit\xE4 itsesi t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Juokse painamalla [sprint], hypp\xE4\xE4 painamalla [jump], ja
      paina [tumble] heitt\xE4\xE4ksesi itsesi. Toista t\xE4m\xE4 kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: Tartu esineisiin painamalla [grab].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "Kanna esinett\xE4 t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "Paina ja pid\xE4 [grab] pohjassa kunnes edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "K\xE4yt\xE4 [push] muuttaaksesi esineen et\xE4isyytt\xE4 sinuun."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "Muuta esineen et\xE4isyytt\xE4 sinuun!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "Paina ja pid\xE4 [grab] pohjassa, ja muuta esineen et\xE4isyytt\xE4
      k\xE4ytt\xE4m\xE4ll\xE4 [push] kunnes edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: "Kierr\xE4 esinett\xE4 painamalla [grab2]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "Kierr\xE4 esinett\xE4 kunnes edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "Pid\xE4 esinett\xE4 k\xE4dess\xE4si pit\xE4m\xE4ll\xE4 [grab] pohjassa,
      ja kierr\xE4 esinett\xE4 pit\xE4m\xE4ll\xE4 [grab2] pohjassa ja liikuttamalla
      t\xE4ht\xE4int\xE4si. Tee n\xE4in kunnes edistymispalkki on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "Tartu esineeseen, ja paina [interact] pist\xE4\xE4ksesi se p\xE4\xE4lle
      ja pois p\xE4\xE4lt\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "Pist\xE4 esine p\xE4\xE4lle ja pois p\xE4\xE4lt\xE4 kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "Tartu palloon pit\xE4m\xE4ll\xE4 [grab] pohjassa, ja pist\xE4 esine
      p\xE4\xE4lle ja pois p\xE4\xE4lt\xE4 painamalla [interact] kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "Tartu esineeseen, ja paina [inventory1]/[inventory2]/[inventory3]
      pist\xE4\xE4ksesi esineit\xE4 taskuusi!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "T\xE4yt\xE4 kaikki taskusi!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "Kun pid\xE4t tavaraa k\xE4dess\xE4si pit\xE4m\xE4ll\xE4 [grab]
      pohjassa, paina [inventory1]/[inventory2]/[inventory3]. T\xE4yt\xE4 kaikki
      taskusi!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: Paina [inventory1]/[inventory2]/[inventory3] ottaaksesi esineet
      pois taskuistasi.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "Tyhjenn\xE4 kaikki taskusi!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "Tyhjenn\xE4 kaikki taskusi painamalla [inventory1]/[inventory2]/[inventory3]
      t\xE4ytt\xE4\xE4ksesi edistymispalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "Paina [map] katsoaksesi karttaan. Kartta on <b><u>T\xC4RKE\xC4</u></b>
      navigointia varten."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: Katso karttaa!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "Pid\xE4 [map] pohjassa, ja katso karttaa kunnes edistymispalkki
      on t\xE4ynn\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "T\xE4m\xE4 on K.\xC4.R.R.Y. Tartu siihen kahvasta"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "K\xE4vele K.\xC4.R.R.Y.n kanssa v\xE4h\xE4n!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "Tartu K.\xC4.R.R.Y.yn painamalla [grab] ja k\xE4vele sen kanssa
      t\xE4ytt\xE4\xE4ksesi edistyspalkin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "T\xE4yt\xE4 K.\xC4.R.R.Y arvoesineill\xE4. K.\xC4.R.R.Y.t ovat
      <b><u>T\xC4RKEIT\xC4</u></b> tavaroiden kuljettamista varten."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "T\xE4yt\xE4 K.\xC4.R.R.Y. arvoesineill\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "Pist\xE4 K.\xC4.R.R.Y.yn 3 arvoesinett\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Aktivoi ja t\xE4yt\xE4 <b><u>TOIMITUSPISTEIT\xC4</u></b> arvoesineill\xE4."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "L\xE4het\xE4 arvoesineet matkaan!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "HALOO! T\xC4YT\xC4 <b><u>TOIMITUSPISTE</u></b> ARVOESINEILL\xC4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "Mene <b><u>REKKAAN</u></b> ja l\xE4het\xE4 viesti pomollesi l\xE4hte\xE4ksesi
      pois."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "Mene rekkaan ja l\xE4het\xE4 viesti!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "Mene rekkaan, pid\xE4 viestin\xE4yt\xF6n viestialuetta pohjassa
      painamalla [grab] ja l\xE4het\xE4 viesti pomollesi."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "Jaa terveyspisteit\xE4 muiden pelaajien kanssa tarttumalla heid\xE4n
      niskoihin!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "Elvyt\xE4 toiset pelaajan l\xE4hett\xE4m\xE4ll\xE4 heid\xE4n p\xE4\xE4t
      toimituspisteell\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: Osta <b><u>ENERGIAKRISTALLEJA LATAUSPISTEELLE</u></b> lataaksesi
      tavaroitasi.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: Vain yksi <b>TOIMITUSPISTE<u></u></b> voi olla aktiivinen kerrallaan.
      Etsi nykyinen aktiivinen toimituspiste kartallasi!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "Paina [chat] avataksesi ch\xE4tin. Se on tosi hauskaa! Jee!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "Aika l\xE4hte\xE4. Rekka parantaa sinua ja elvytt\xE4\xE4 kuolleiden
      kavereittesi p\xE4\xE4t!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "T\xE4ss\xE4 tasossa on monta <b><u>TOIMITUSPISTETT\xC4</u></b>.
      Sinun pit\xE4\xE4 saada kaikki niist\xE4 valmiiksi ennen kuin voit l\xE4hte\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "T\xE4m\xE4 on <b><u>KAUPPA</u></b>. Toimita tavaroita toimituspisteell\xE4
      ostaaksesi ne. Mik\xE4\xE4n vahinko t\xE4\xE4ll\xE4 ei ole pysyv\xE4\xE4!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: (fi) Use [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      to make expressions. You can even mix!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: (fi) Grabbing an enemy will now cause overcharge, when full you
      get blasted.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: (fi) Multiple people will dampen the overcharge effect.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: (fi) While dead your head charges, use that charge to briefly possess
      your head.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: (fi) While possessing your head, hold [jump] to jump. Hold to jump
      higher at a greater cost.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: (fi) PET THE DOG!
    m_Metadata:
      m_Items: []
  - m_Id: 22956499448881152
    m_Localized: '[menu] ohittaaksesi'
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: (fi) Fill <b><u>EXTRACTION POINTS</u></b> with valuables.
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: (fi) This is a <b><u>COSMETIC BOX</u></b>, extract it for a reward.
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: (fi) If it gets damaged, you can <b><u>HEAL</u></b> it using your
      own health.
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: (fi) Insert <b><u>TAX TOKENS</u></b> into the shop machine to claim
      your rewards.
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: "TEHT\xC4V\xC4"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: Osta kamaa kaupasta
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: Nauti matkasta, lataa kamasi ja VARUSTAUDU!
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: (fi) Press [interact] to insert tax token
    m_Metadata:
      m_Items: []
