      \u0627\u0636\u063A\u0637 \u0645\u0637\u0648\u0644\u064B\u0627 \u0639\u0644\u0649
      [grab2] \u0648\u062D\u0631\u0651\u0643 \u0647\u062F\u0641\u0643 \u0644\u062A\u062F\u0648\u064A\u0631\u0647.
      \u0627\u0633\u062A\u0645\u0631 \u0628\u0627\u0644\u062A\u062F\u0648\u064A\u0631
      \u062D\u062A\u0649 \u062A\u0645\u0644\u0623 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "\u0623\u0645\u0633\u0643 \u0628\u0627\u0644\u0639\u0646\u0627\u0635\u0631
