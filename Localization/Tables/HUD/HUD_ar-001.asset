      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "\u0627\u0631\u0643\u0636 \u0644\u0645\u0644\u0621 \u0634\u0631\u064A\u0637
      \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "\u0627\u0636\u063A\u0637 \u0645\u0637\u0648\u0644\u064B\u0627 \u0639\u0644\u0649
      [sprint] \u0648\u0627\u0633\u062A\u062E\u062F\u0645 [move] \u0644\u0644\u0631\u0643\u0636
      \u062D\u062A\u0649 \u062A\u0645\u0644\u0623 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!
      \u0625\u0630\u0627 \u0646\u0641\u062F\u062A \u0627\u0644\u0637\u0627\u0642\u0629\u060C
      \u0627\u0646\u062A\u0638\u0631 \u062D\u062A\u0649 \u062A\u062A\u062C\u062F\u062F!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "\u0627\u0631\u0643\u0636 \u0648\u0627\u0636\u063A\u0637 \u0639\u0644\u0649
      [tumble] \u0644\u0644\u0633\u0642\u0648\u0637 \u0628\u0623\u0646\u0627\u0642\u0629.
      \u0627\u0644\u0642\u0641\u0632 \u064A\u0633\u0627\u0639\u062F \u0623\u064A\u0636\u064B\u0627!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "\u0627\u0631\u0643\u0636 \u0648\u0627\u0642\u0641\u0632 \u0648\u0627\u0633\u0642\u0637
      \u0644\u0645\u0644\u0621 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "\u0627\u0631\u0643\u0636 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
      [sprint]\u060C \u0648\u0627\u0642\u0641\u0632 \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645
      [jump]\u060C \u0648\u0627\u0636\u063A\u0637 \u0639\u0644\u0649 [tumble] \u0644\u0631\u0645\u064A
      \u0646\u0641\u0633\u0643. \u0643\u0631\u0631 \u0630\u0644\u0643 \u062D\u062A\u0649
      \u062A\u0645\u0644\u0623 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: "\u0623\u0645\u0633\u0643 \u0627\u0644\u0623\u0634\u064A\u0627\u0621
      \u0628\u0627\u0633\u062A\u062E\u062F\u0627\u0645 [grab]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "\u0627\u062D\u0645\u0644 \u0630\u0644\u0643 \u0627\u0644\u0634\u064A\u0621
      \u0644\u0645\u0644\u0621 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "\u0627\u0636\u063A\u0637 \u0645\u0637\u0648\u0644\u064B\u0627 \u0639\u0644\u0649
      [grab] \u0639\u0646\u062F \u0623\u062D\u062F \u0627\u0644\u0623\u0634\u064A\u0627\u0621
      \u062D\u062A\u0649 \u062A\u0645\u0644\u0623 \u0634\u0631\u064A\u0637 \u0627\u0644\u062A\u0642\u062F\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "\u0627\u0633\u062A\u062E\u062F\u0645 [pushAndPull] \u0644\u062A\u063A\u064A\u064A\u0631
      \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0623\u0634\u064A\u0627\u0621 \u0627\u0644\u0645\u0645\u0633\u0648\u0643\u0629."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\u063A\u064A\u0651\u0631 \u0645\u0633\u0627\u0641\u0629 \u0627\u0644\u0639\u0646\u0635\u0631
