    - rid: 6163163424511229959
  m_TableData:
  - m_Id: 2984229311066112
    m_Localized: Udvindingspunkt aktiveret
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: Udvindingspunkt klaret
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "Fyld udvindingspunktet med v\xE6rdigenstande"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: Undvig granaterne!
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "Find det n\xE6ste udvindingspunkt"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: "L\xF8b tilbage til flyttebilen!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: Flot klaret!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: "Brug [move] for at bev\xE6ge dig."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "Bev\xE6g dig for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "Brug [move] p\xE5 dit tastatur indtil forl\xF8bsindikatoren er
      fyldt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: "Tryk p\xE5 [jump] for at hoppe."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "Hop for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "Tryk p\xE5 [jump] for at hoppe indtil forl\xF8bsindikatoren er
      fyldt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Tryk [crouch] for at snige dig. S\xE5 har monstre sv\xE6rere ved
      at se dig."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "Snig dig rundt for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "Hold [crouch] nede og brug [move] indtil forl\xF8bsindikatoren
      er fyldt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: Brug [crouch] til at krybe under ting for at gemme dig.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "Gem dig for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "Hold [crouch] nede og snig dig under et m\xF8bel. Bliv der indtil
      forl\xF8bsindikatoren er fyldt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: Hold [sprint] nede for at sprinte. Det koster energi.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "Sprint for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "Hold [sprint] nede og brug [move] for at sprinte indtil du har
      fyldt forl\xF8bsindikatoren! Hvis du l\xF8ber t\xF8r for energi, vent p\xE5
      at den genopbygges."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Sprint og tryk [tumble] for at falde med ynde. Det hj\xE6lper hvis
      du hopper!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "Sprint, hop og fald for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Sprint med [sprint], hop med [jump] og tryk s\xE5 [tumble] for
      at kaste dig selv afsted. G\xF8r det indtil du har fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: "Haps ting ved hj\xE6lp af [grab]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "B\xE6r rundt p\xE5 den der ting for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "Tryk og hold [grab] nede p\xE5 et objekt indtil du har fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "Brug [pushAndPull] for at \xE6ndre afstanden p\xE5 ting du har
      hapset."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\xC6ndr afstanden p\xE5 en ting du har hapset!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "Tryk og hold [grab] nede p\xE5 et objekt, og brug s\xE5 [pushAndPull]
      til at \xE6ndre afstanden p\xE5 den ting du har hapset!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: "Rot\xE9r hapsede objekter med [grab2]."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "Rot\xE9r et eller andet for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "Mens du har fat i noget med [grab], tryk og hold [grab2] nede,
      og sigt s\xE5 rundt for at rotere det du har fat i. Rot\xE9r indtil du har
      fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "Haps og tryk [interact] for at t\xE6nde og slukke for udstyr."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "T\xE6nd og sluk for den der ting!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "Haps bolden med [grab] og t\xE6nd og sluk for den med [interact]
      indtil du har fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "Haps et stykke udstyr og brug [inventory1]/[inventory2]/[inventory3]
      til at l\xE6gge det i dit inventar."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: Fyld hele dit inventar!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "Tryk [inventory1]/[inventory2]/[inventory3] mens du har fat i et
      stykke udstyr med [grab]. Fyld alle pladserne i dit inventar for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: Brug [inventory1]/[inventory2]/[inventory3] til at tage udstyr ud
      af dit inventar.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "T\xF8m hele dit inventar!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "Brug [inventory1]/[inventory2]/[inventory3] og t\xF8m alle pladser
      for at fylde forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "Brug [map] for at se kortet. Kortet er <b><u>VIGTIGT</u></b> n\xE5r
      du navigerer."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: Tjek kortet!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "Hold [map] nede og kig p\xE5 kortet indtil du har fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "Det her er en V.O.G.N. Tag fat i h\xE5ndtaget p\xE5 den."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "G\xE5 lige lidt rundt med V.O.G.N.en!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "Tag fat i h\xE5ndtaget p\xE5 V.O.G.N.en med [grab] og g\xE5 rundt
      med den indtil du har fyldt forl\xF8bsindikatoren!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "Fyld V.O.G.N.en med v\xE6rdigenstande. V.O.G.N.e er <b><u>VIGTIGE</u></b>
      n\xE5r du vil b\xE6re flere ting."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "Fyld V.O.G.N.en med v\xE6rdigenstande!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "L\xE6g tre v\xE6rdigenstande i V.O.G.N.en."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Aktiv\xE9r og fyld <b><u>UDVINDINGSPUNKTER</u></b> med v\xE6rdigenstande."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "Udvind v\xE6rdigenstandene!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "HALLO! FYLD <b><u>UDVINDINGSPUNKTET</u></b> MED V\xC6RDIGENSTANDE!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "G\xE5 ind i <b><u>FLYTTEBILEN</u></b> og send en besked til din
      chef for at forlade banen."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "G\xE5 ind i flyttebilen og send en besked!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "G\xE5 ind i flyttebilen, tag fat i beskedomr\xE5det p\xE5 flyttevognssk\xE6rmen
      med [grab] og send en besked!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "Del dit liv med andre spillere ved at tage fat i nakken p\xE5 dem!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "Genopliv andre spillere ved at udvinde deres d\xF8dningehoveder!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "K\xF8b <b><u>ENERGIKRYSTALLER</u></b> til <b><u>LADESTANDEREN</u></b>
      for at genoplade og fikse dit udstyr!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "Kun \xE9t <b><u>UDVINDINGSPUNKT</u></b> kan v\xE6re aktivt ad gangen.
      Find det aktive punkt ved hj\xE6lp ad dit kort!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "Tryk p\xE5 [chat] for at \xE5bne chatten! Det er sjovt!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "S\xE5 skal vi videre. Flyttebilen heler dig og genopliver spillere's
      d\xF8dningehoveder!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "Det her niveau har flere <b><u>UDVINDINGSPUNKTER</u></b>. Du er
      n\xF8dt til at klare dem alle sammen f\xF8r du kan tage videre!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "Det her er <b><u>K\xD8BMANDEN</u></b>. Udvind udstyr for at k\xF8be
      det. Hvis du tager skade her s\xE5 t\xE6ller det ikke!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: Brug [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      for at lave ansigtsudtryk. Du kan endda blande!
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "Der opbygges nu overbelastning n\xE5r du hapser monstre. N\xE5r
      overbelastningen n\xE5r maks, bliver du spr\xE6ngt."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "Flere spillere d\xE6mper overbelastningseffekten."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "N\xE5r du er d\xF8d, oplader dit hoved sig. Brug ladningen til
      kortvarigt at bes\xE6tte dit d\xF8dningehoved."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "Mens du bes\xE6tter dit d\xF8dningehoved, hold [jump] nede for
      at at hoppe. Hold den nede l\xE6ngere for at bruge mere ladning og hoppe h\xF8jere."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "K\xC6L FOR HUNDEN!"
    m_Metadata:
      m_Items: []
  - m_Id: 22956499448881152
    m_Localized: '[back] for at springe over'
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "Fyld <b><u>UDVINDINGSPUNKTER</u></b> med v\xE6rdigenstande."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "Det her er en <b><u>GARDEROBEKASSE</u></b>, udvind den og f\xE5
      en bel\xF8nning."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: Hvis den tager skade, kan du <b><u>HELE</u></b> den med dit eget
      liv.
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "Indl\xF8s <b><u>SKATTEPOLETTER</u></b> i k\xF8bmandsmaskinen for
      at f\xE5 dine bel\xF8nninger."
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: FOKUS
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: "K\xF8b ting hos k\xF8bmanden"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: Nyd turen, genoplad dine ting og UDRUST DIG!
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: "Tryk [interact] for at indl\xF8se skattepolet"
    m_Metadata:
      m_Items: []
  - m_Id: 26094195824295936
    m_Localized: V.O.G.N.-kanon
    m_Metadata:
