      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: "[inventory1]/[inventory2]/[inventory3] \uC368\uC11C \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C
      \uC544\uC774\uD15C\uC744 \uAEBC\uB0B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uB97C \uC2F9 \uBE44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "[inventory1]/[inventory2]/[inventory3] \uC0AC\uC6A9\uD574\uC11C
      \uBAA8\uB4E0 \uCE78\uC744 \uBE44\uC6CC\uC11C \uC9C4\uD589\uB3C4 \uBC14\uB97C
      \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "[map] \uC368\uC11C \uC9C0\uB3C4\uB97C \uBD10\uC694. \uC9C0\uB3C4\uB294
      \uAE38\uC744 \uCC3E\uB294 \uB370 <b><u>\uC911\uC694</u></b>\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: "\uC9C0\uB3C4\uB97C \uD655\uC778\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [map]
      \uAE38\uAC8C \uB204\uB974\uAE30\uB85C \uC9C0\uB3C4\uB97C \uBD10\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "C.A.R.T.\uC608\uC694. \uC190\uC7A1\uC774\uB97C \uC7A1\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "C.A.R.T.\uB97C \uC7A0\uC2DC \uB04C\uACE0 \uB2E4\uB140\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "[grab] \uC368\uC11C C.A.R.T.\uC758 \uC190\uC7A1\uC774\uB97C \uC7A1\uACE0,
      \uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 \uB04C\uACE0 \uB2E4\uB140\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "C.A.R.T.\uC5D0 \uADC0\uC911\uD488\uC744 \uCC44\uC6CC\uC694. C.A.R.T.\uB294
      \uB9CE\uC740 \uBB3C\uAC74\uC744 \uC6B4\uBC18\uD558\uB294 \uB370 <b><u>\uC911\uC694</u></b>\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "C.A.R.T.\uC5D0 \uADC0\uC911\uD488\uC744 \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: "C.A.R.T.\uC5D0 \uC544\uC774\uD15C \uC138 \uAC1C\uB97C \uB123\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "<b><u>\uBC18\uCD9C \uC9C0\uC810</u></b>\uC744 \uD65C\uC131\uD654\uD558\uACE0
      \uADC0\uC911\uD488\uC744 \uCC44\uC6CC \uB123\uC73C\uC138\uC694"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "\uADC0\uC911\uD488\uC744 \uBC18\uCD9C\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "\uC800\uAE30\uC694! <b><u>\uBC18\uCD9C \uC9C0\uC810</u></b>\uC744
      \uADC0\uC911\uD488\uC73C\uB85C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "<b><u>\uD2B8\uB7ED</u></b>\uC5D0 \uB4E4\uC5B4\uAC00 \uBCF4\uC2A4\uC5D0\uAC8C
      \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0B4 \uB808\uBCA8\uC5D0\uC11C \uB098\uAC00\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "\uD2B8\uB7ED\uC5D0 \uB4E4\uC5B4\uAC00 \uBA54\uC2DC\uC9C0\uB97C
      \uBCF4\uB0B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "\uD2B8\uB7ED\uC5D0 \uAC78\uC5B4 \uB4E4\uC5B4\uAC00 \uD2B8\uB7ED
      \uD654\uBA74\uC758 \uBA54\uC2DC\uC9C0 \uAD6C\uC5ED\uC744 [grab](\uC73C)\uB85C
      \uBD99\uC7A1\uC544 \uBA54\uC2DC\uC9C0\uB97C \uBCF4\uB0B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC758 \uBAA9\uC744 \uBD99\uC7A1\uC544
      \uCCB4\uB825\uC744 \uB098\uB220\uC918\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uC758 \uBA38\uB9AC\uD1B5\uC744
      \uBC18\uCD9C\uD574 \uBD80\uD65C\uC2DC\uCF1C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "<b><u>\uCDA9\uC804\uC18C</u></b>\uAC00 \uC7A5\uBE44\uB97C \uCDA9\uC804\uD558\uACE0
      \uC218\uBCF5\uD560 \uC218 \uC788\uB3C4\uB85D <b><u>\uC5D0\uB108\uC9C0 \uC218\uC815</u></b>\uC744
      \uC0AC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "\uD55C \uBC88\uC5D0 <b><u>\uBC18\uCD9C \uC9C0\uC810</u></b>\uC774
      \uD558\uB098\uB9CC \uD65C\uC131 \uC0C1\uD0DC\uC77C \uC218 \uC788\uC5B4\uC694.
      \uD604\uC7AC \uC5B4\uB290 \uC9C0\uC810\uC774 \uD65C\uC131\uD654\uB418\uC5B4
      \uC788\uB294\uC9C0 \uC9C0\uB3C4\uC5D0\uC11C \uCC3E\uC73C\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "[chat] \uB20C\uB7EC \uCC44\uD305\uC744 \uC5F4\uC5B4\uC694! \uCC44\uD305\uC740
      \uC7AC\uBC0C\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "\uB5A0\uB0A0 \uC2DC\uAC04\uC774\uC5D0\uC694. \uD2B8\uB7ED\uC5D0
      \uD50C\uB808\uC774\uC5B4 \uBA38\uB9AC\uD1B5\uC744 \uC2E4\uC73C\uBA74 \uD2B8\uB7ED\uC774
      \uBA38\uB9AC\uD1B5\uC744 \uBD80\uD65C\uC2DC\uCF1C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "\uC774 \uB808\uBCA8\uC740 <b><u>\uBC18\uCD9C \uC9C0\uC810</u></b>\uC774
      \uC5EC\uB7EC \uACF3\uC774\uC5D0\uC694. \uC804\uBD80 \uC644\uB8CC\uD574\uC57C
      \uB098\uAC08 \uC218 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "<b><u>\uC0C1\uC810</u></b>\uC774\uC5D0\uC694. \uC544\uC774\uD15C\uC744
      \uBC18\uCD9C\uD574 \uAD6C\uB9E4\uD574\uC694. \uC5EC\uAE30\uC11C \uBC1B\uC740
      \uD53C\uD574\uB294 \uD68C\uBCF5\uB3FC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "[expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      \uC368\uC11C \uAC10\uC815\uD45C\uD604\uC744 \uD574\uC694. \uC870\uD569\uD560
      \uC218\uB3C4 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "\uC774\uC81C \uBAAC\uC2A4\uD130\uB97C \uBD99\uC7A1\uC73C\uBA74
      \uACFC\uBD80\uD558\uAC00 \uAC78\uB824\uC694. \uAC8C\uC774\uC9C0\uAC00 \uAF49
      \uCC28\uBA74 \uD3ED\uBC1C\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: "\uC5EC\uB7FF\uC774\uC11C \uBD99\uC7A1\uC73C\uBA74 \uACFC\uBD80\uD558
      \uD6A8\uACFC\uAC00 \uB204\uADF8\uB7EC\uC838\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: "\uC8FD\uC5B4\uC788\uB294 \uB3D9\uC548 \uBA38\uB9AC\uD1B5\uC774
      \uCDA9\uC804\uB3FC\uC694. \uCDA9\uC804\uB41C \uC5D0\uB108\uC9C0\uB97C \uC368\uC11C
      \uC7A0\uC2DC \uBA38\uB9AC\uD1B5\uC744 \uC870\uC885\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "\uBA38\uB9AC\uD1B5\uC744 \uC870\uC885\uD558\uB294 \uB3D9\uC548
      [jump] \uAE38\uAC8C \uB204\uB974\uAE30\uB85C \uC810\uD504\uD574\uC694. \uB354
      \uAE38\uAC8C \uB204\uB974\uBA74 \uC5D0\uB108\uC9C0\uB97C \uB354 \uC368\uC11C
      \uB354 \uB192\uC774 \uC810\uD504\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "\uAC1C\uB97C \uC4F0\uB2E4\uB4EC\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "<b><u>\uBC18\uCD9C \uC9C0\uC810</u></b>\uC744 \uADC0\uC911\uD488\uC73C\uB85C
      \uCC44\uC6CC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "<b><u>\uCE58\uC7A5\uD488 \uC0C1\uC790</u></b>\uC608\uC694. \uBC18\uCD9C\uD574
      \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: "\uC0C1\uC790\uAC00 \uC190\uC0C1\uB418\uBA74 \uCCB4\uB825\uC744
      \uC368\uC11C <b><u>\uC218\uB9AC</u></b>\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "<b><u>\uC138\uAE08 \uD1A0\uD070</u></b>\uC744 \uC0C1\uC810 \uAE30\uACC4\uC5D0
      \uB123\uC5B4 \uBCF4\uC0C1\uC744 \uBC1B\uC544\uC694."
