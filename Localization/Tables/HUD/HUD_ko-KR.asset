      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: "\uB4DC\uB77C\uC774\uBE0C\uB97C \uC990\uAE30\uACE0 \uBB3C\uD488\uC744
      \uCDA9\uC804\uD558\uACE0 \uC7A5\uBE44\uB97C \uCC59\uAE30\uC138\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: "\uC798\uD588\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: "[move] \uC368\uC11C \uC6C0\uC9C1\uC5EC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "\uC6C0\uC9C1\uC5EC \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [move]
      \uC0AC\uC6A9\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: "[jump] \uB20C\uB7EC \uC810\uD504\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "\uC810\uD504\uD574 \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [jump]
      \uB20C\uB7EC \uC810\uD504\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "[crouch] \uB20C\uB7EC \uC6C5\uD06C\uB824\uC694. \uBAAC\uC2A4\uD130\uC5D0\uAC8C
      \uB4E4\uD0AC \uD655\uB960\uC774 \uB0AE\uC544\uC838\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "\uC6C5\uD06C\uB824\uC11C \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [crouch]
      \uB204\uB978 \uCC44 [move] \uC0AC\uC6A9\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: "[crouch] \uC368\uC11C \uC0AC\uBB3C \uC544\uB798 \uC228\uC5B4\uB4E4\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "\uC228\uC5B4\uC11C \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "[crouch] \uB204\uB978 \uCC44 \uC0AC\uBB3C \uC544\uB798\uB85C \uAC78\uC5B4
      \uB4E4\uC5B4\uAC04 \uB2E4\uC74C, \uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0
      \uC228\uC5B4 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "[sprint] \uAE38\uAC8C \uB204\uB974\uAE30\uB85C \uB2EC\uB824\uC694.
      \uC2A4\uD0DC\uBBF8\uB098\uAC00 \uC18C\uBAA8\uB3FC\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "\uB2EC\uB824\uC11C \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [sprint]
      \uB204\uB978 \uCC44 [move] \uC368\uC11C \uB2EC\uB824\uC694! \uC2A4\uD0DC\uBBF8\uB098\uAC00
      \uBC14\uB2E5\uB098\uBA74 \uD68C\uBCF5\uB418\uAE38 \uAE30\uB2E4\uB824\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "\uB2EC\uB9AC\uB2E4\uAC00 [tumble] \uB20C\uB7EC \uBA4B\uC9C0\uAC8C
      \uB118\uC5B4\uC838\uC694. \uC810\uD504\uB3C4 \uB3C4\uC6C0\uC774 \uB3FC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "\uB2EC\uB9AC\uAE30, \uC810\uD504\uD558\uAE30, \uB118\uC5B4\uC9C0\uAE30\uB85C
      \uC9C4\uD589\uB3C4 \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "\uB2EC\uB9AC\uAE30\uC5D0\uB294 [sprint], \uC810\uD504\uC5D0\uB294
      [jump], \uBAB8 \uB358\uC9C0\uAE30\uC5D0\uB294 [tumble] \uC0AC\uC6A9\uD574\uC694.
      \uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 \uBC18\uBCF5\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: "[grab] \uC368\uC11C \uBB3C\uAC74\uC744 \uBD99\uC7A1\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "\uADF8 \uBB3C\uAC74\uC744 \uB4E4\uACE0 \uB2E4\uB140\uC11C \uC9C4\uD589\uB3C4
      \uBC14\uB97C \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 \uBB3C\uAC74
      \uC704\uC5D0 \uCEE4\uC11C\uB97C \uB450\uACE0 [grab] \uB204\uB974\uACE0 \uC788\uC5B4\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "\uBD99\uC7A1\uC740 \uBB3C\uAC74\uC758 \uAC70\uB9AC\uB294 [pushAndPull]
      \uC368\uC11C \uC870\uC808\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\uBD99\uC7A1\uC740 \uBB3C\uAC74\uC758 \uAC70\uB9AC\uB97C \uC870\uC808\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "\uBB3C\uAC74 \uC704\uC5D0 \uCEE4\uC11C\uB97C \uB450\uACE0 [grab]
      \uB204\uB978 \uCC44 [pushAndPull] \uC368\uC11C \uBB3C\uAC74\uACFC\uC758 \uAC70\uB9AC\uB97C
      \uC870\uC808\uD574\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: "[grab2] \uC368\uC11C \uBD99\uC7A1\uC740 \uBB3C\uAC74\uC744 \uB3CC\uB824\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "\uBB3C\uAC74\uC744 \uB3CC\uB824\uC11C \uC9C4\uD589\uB3C4 \uBC14\uB97C
      \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "[grab] \uC368\uC11C \uBB3C\uAC74\uC744 \uB4E0 \uC0C1\uD0DC\uB85C
      [grab2] \uB204\uB978 \uCC44 \uC870\uC900\uC810\uC744 \uC6C0\uC9C1\uC5EC \uBB3C\uAC74\uC744
      \uB3CC\uB824\uC694. \uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0
      \uB3CC\uB824\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: "\uBD99\uC7A1\uC740 \uB2E4\uC74C [interact] \uB20C\uB7EC \uC544\uC774\uD15C\uC744
      \uB044\uACE0 \uCF1C\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "\uC544\uC774\uD15C\uC744 \uB044\uACE0 \uCF1C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "\uC9C4\uD589\uB3C4 \uBC14\uAC00 \uCC30 \uB54C\uAE4C\uC9C0 [grab]
      \uC368\uC11C \uACF5\uC744 \uBD99\uC7A1\uACE0 [interact] \uC368\uC11C \uB044\uACE0
      \uCF1C\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: "\uC544\uC774\uD15C\uC744 \uBD99\uC7A1\uACE0 [inventory1]/[inventory2]/[inventory3]
      \uC368\uC11C \uC778\uBCA4\uD1A0\uB9AC\uC5D0 \uB123\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "\uC778\uBCA4\uD1A0\uB9AC\uB97C \uAF49 \uCC44\uC6CC\uC694!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "[grab] \uC368\uC11C \uC544\uC774\uD15C\uC744 \uB4E4\uACE0 \uC788\uB294
      \uB3D9\uC548 [inventory1]/[inventory2]/[inventory3] \uB20C\uB7EC\uC694. \uC778\uBCA4\uD1A0\uB9AC\uC758
      \uBAA8\uB4E0 \uCE78\uC744 \uCC44\uC6B0\uBA74 \uC9C4\uD589\uB3C4 \uBC14\uAC00
      \uCC44\uC6CC\uC838\uC694!"
