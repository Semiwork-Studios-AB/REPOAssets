  m_Name: HUD_es-ES
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: es-ES
  m_SharedData: {fileID: 11400000, guid: 64fd365dff4a0674f9ea9125eb765214, type: 2}
  m_Metadata:
    m_Items:
    - rid: 2515126557588324460
  m_TableData:
  - m_Id: 26547416404832256
    m_Localized: "Mant\xE9n para cambiar ({cost})"
    m_Metadata:
      m_Items:
      - rid: 2515126557588324460
  - m_Id: 22956499448881152
    m_Localized: '[back] para saltar'
    m_Metadata:
      m_Items: []
  - m_Id: 2984229311066112
    m_Localized: "Punto de extracci\xF3n activado"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231936
    m_Localized: "Punto de extracci\xF3n completado"
    m_Metadata:
      m_Items: []
  - m_Id: 23920995436847104
    m_Localized: OBJETIVO
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231937
    m_Localized: "Llena el punto de extracci\xF3n con objetos de valor"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231938
    m_Localized: "\xA1Evita las granadas!"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231939
    m_Localized: "Busca el siguiente punto de extracci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 2984229336231940
    m_Localized: "\xA1Vuelve al cami\xF3n!"
    m_Metadata:
      m_Items: []
  - m_Id: 25797701263065088
    m_Localized: Compra cosas en la tienda
    m_Metadata:
      m_Items: []
  - m_Id: 25797701284036608
    m_Localized: "\xA1Disfruta del viaje, recarga cosas y EQU\xCDPATE!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442524647424
    m_Localized: "\xA1Bien hecho!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813248
    m_Localized: Usa [move] para moverte.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813249
    m_Localized: "\xA1Mu\xE9vete para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813250
    m_Localized: "\xA1Usa [move] en tu dispositivo hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813251
    m_Localized: Pulsa [jump] para saltar.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813252
    m_Localized: "\xA1Salta para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813253
    m_Localized: "\xA1Pulsa [jump] para dar saltos hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813254
    m_Localized: "Pulsa [crouch] para ir a hurtadillas. As\xED hay menos posibilidades
      de que te vean los monstruos."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813255
    m_Localized: "\xA1Ve a hurtadillas para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813256
    m_Localized: "\xA1Mant\xE9n [crouch] y usa [move] hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813257
    m_Localized: Usa [crouch] para meterte bajo cosas y esconderte.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813258
    m_Localized: "\xA1Esc\xF3ndete para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813259
    m_Localized: "\xA1Mant\xE9n [crouch], m\xE9tete debajo de algo y qu\xE9date ah\xED
      hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813260
    m_Localized: "Mant\xE9n [sprint] para correr. Esto reducir\xE1 tu aguante."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813261
    m_Localized: "\xA1Corre para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813262
    m_Localized: "\xA1Mant\xE9n [sprint] y usa [move] para correr hasta llenar la
      barra de progreso! Si se te agota el aguante, \xA1espera a recuperarlo!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813263
    m_Localized: "Corre y pulsa [tumble] para caerte con estilo. \xA1Saltar tambi\xE9n
      ayuda!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813264
    m_Localized: "\xA1Corre, salta y t\xEDrate para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813265
    m_Localized: "Corre con [sprint], salta con [jump] y pulsa [tumble] para tirarte.
      \xA1Hazlo hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813266
    m_Localized: Agarra objetos con [grab].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813267
    m_Localized: "\xA1Lleva esa cosa para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813268
    m_Localized: "\xA1Pulsa y mant\xE9n [grab] con un objeto hasta llenar la barra
      de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813269
    m_Localized: "\xA1Usa [pushAndPull] para cambiar la distancia de los objetos
      que agarres!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813270
    m_Localized: "\xA1Cambia la distancia de un objeto agarrado!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813271
    m_Localized: "\xA1Pulsa y mant\xE9n [grab] con un objeto y usa [pushAndPull]
      para cambiar la distancia del objeto agarrado!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813272
    m_Localized: Rota los objetos agarrados con [grab2].
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813273
    m_Localized: "\xA1Rota objetos para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813274
    m_Localized: "Mientras agarras un objeto con [grab], pulsa y mant\xE9n [grab2]
      y mueve la c\xE1mara para rotarlo. \xA1R\xF3talo hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813275
    m_Localized: Agarra y pulsa [interact] para activar objetos.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813276
    m_Localized: "\xA1Activa y desactiva eso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813277
    m_Localized: "\xA1Agarra la bola con [grab] para activarla y desactivarla usando
      [interact] hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813278
    m_Localized: Agarra un objeto y usa [inventory1]/[inventory2]/[inventory3] para
      ponerlo en tu inventario.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813279
    m_Localized: "\xA1Llena todo tu inventario!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813280
    m_Localized: "Mientras agarras un objeto con [grab], pulsa [inventory1]/[inventory2]/[inventory3].
      \xA1Llena todos los espacios del inventario para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813281
    m_Localized: Usa [inventory1]/[inventory2]/[inventory3] para sacar objetos de
      tu inventario.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813282
    m_Localized: "\xA1Vac\xEDa todo tu inventario!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "\xA1Usa [inventory1]/[inventory2]/[inventory3] y vac\xEDa todos
      los espacios para llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: Usa [map] para ver el mapa. El mapa es muy <b><u>IMPORTANTE</u></b>
      para ubicarte.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813285
    m_Localized: "\xA1Consulta el mapa!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201856
    m_Localized: "\xA1Mant\xE9n [map] y m\xEDralo hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201857
    m_Localized: "Esto es un C.A.R.R.O. Ag\xE1rralo por el manillar."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201858
    m_Localized: "\xA1Camina un poco con el C.A.R.R.O.!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201859
    m_Localized: "\xA1Agarra el C.A.R.R.O. por el manillar con [grab] y camina un
      poco hasta llenar la barra de progreso!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201860
    m_Localized: "Llena el C.A.R.R.O. con objetos de valor. El C.A.R.R.O. es muy
      <b><u>IMPORTANTE</u></b> para llevar m\xE1s cosas."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201861
    m_Localized: "\xA1Llena el C.A.R.R.O. de objetos de valor!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201862
    m_Localized: Pon tres objetos en el C.A.R.R.O.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201863
    m_Localized: "Activa y llena los <b><u>PUNTOS DE EXTRACCI\xD3N</u></b> con objetos
      de valor."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201864
    m_Localized: "\xA1Extrae los objetos de valor!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201865
    m_Localized: "\xA1HOLA! \xA1LLENA EL <b><u>PUNTO DE EXTRACCI\xD3N</u></b> CON
      OBJETOS DE VALOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201866
    m_Localized: "Entra en el <b><u>CAMI\xD3N</u></b> y env\xEDa un mensaje a tu
      jefe para salir del nivel."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201867
    m_Localized: "\xA1Entra en el cami\xF3n y env\xEDa un mensaje!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201868
    m_Localized: "\xA1Entra en el cami\xF3n y agarra y mant\xE9n la zona de mensaje
      de la pantalla del cami\xF3n con [grab] para enviar un mensaje!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201869
    m_Localized: "\xA1Comparte tu salud con otros compa\xF1eros agarrando sus cuellos!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201870
    m_Localized: "\xA1Extrae las cabezas de otros compa\xF1eros para revivirlos!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201871
    m_Localized: "\xA1Compra <b><u>CRISTALES DE ENERG\xCDA</u></b> para la <b><u>ESTACI\xD3N
      DE CARGA</u></b> para recargar y reparar tu equipamiento!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201872
    m_Localized: "No puede haber m\xE1s de un <b><u>PUNTO DE EXTRACCI\xD3N </u></b>
      activo al mismo tiempo. \xA1Busca el actual usando tu mapa!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201873
    m_Localized: "\xA1Pulsa [chat] para abrir el chat! \xA1Te lo pasar\xE1s de locos!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201874
    m_Localized: "Hora de irse. \xA1El cami\xF3n te cura y revive las cabezas de
      los jugadores que lleve!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201875
    m_Localized: "Este nivel tiene varios <b><u>PUNTOS DE EXTRACCI\xD3N</u></b>,
      \xA1debes completarlos todos para poder irte!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201876
    m_Localized: "Esta es la <b><u>TIENDA</u></b>, extrae objetos para comprarlos
      en la tienda. \xA1El da\xF1o que se produzca en la tienda se queda en la tienda!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201877
    m_Localized: "Usa [expression1]/[expression2]/[expression3]/[expression4]/[expression5]/[expression6]
      para expresarte. \xA1Hasta puedes mezclar emociones!"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201878
    m_Localized: "Agarrar monstruos ahora causar\xE1 sobrecarga. Cuando llegue al
      m\xE1ximo, se producir\xE1 un chispazo que te empujar\xE1."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201879
    m_Localized: Varias personas pueden mitigar el efecto de sobrecarga.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201880
    m_Localized: Cuando mueres, tu cabeza se carga; usa esa carga para poseer tu
      cabeza brevemente.
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201881
    m_Localized: "Mientras posees tu cabeza, mant\xE9n [jump] para saltar. Mant\xE9n
      para saltar m\xE1s alto con un coste mayor."
    m_Metadata:
      m_Items: []
  - m_Id: 18554442558201882
    m_Localized: "\xA1ACARICIA EL PERRO!"
    m_Metadata:
      m_Items: []
  - m_Id: 23598574554132480
    m_Localized: "Llena los <b><u>PUNTOS DE EXTRACCI\xD3N<</u></b> con objetos de
      valor."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344067186688
    m_Localized: "Esto es una <b><u>CAJA DE COSM\xC9TICOS</u></b>, extr\xE1ela para
      obtener una recompensa."
    m_Metadata:
      m_Items: []
  - m_Id: 23609344088158208
    m_Localized: "Si recibe da\xF1o, puedes <b><u>REPARARLA</u></b> con tu propia
      salud."
    m_Metadata:
      m_Items: []
  - m_Id: 23623549780570112
    m_Localized: "Introduce <b><u>FICHAS DE IMPUESTO</u></b> en la m\xE1quina de
      la tienda para recoger tus recompensas."
    m_Metadata:
      m_Items: []
  - m_Id: 25822090339713024
    m_Localized: Pulsa [interact] para introducir fichas de impuesto
    m_Metadata:
      m_Items: []
  - m_Id: 26094195824295936
    m_Localized: "Ca\xF1\xF3n de C.A.R.R.O."
    m_Metadata:
      m_Items: []
  - m_Id: 26094195849461760
    m_Localized: "L\xE1ser de C.A.R.R.O."
    m_Metadata:
      m_Items: []
  - m_Id: 30522141892837376
    m_Localized: 'Modo: Fuerte'
    m_Metadata:
      m_Items: []
  - m_Id: 30522141918003200
    m_Localized: "Modo: D\xE9bil"
    m_Metadata:
      m_Items: []
