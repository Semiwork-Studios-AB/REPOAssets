  - m_Id: 18554442549813280
    m_Localized: "\u4F7F\u7528[grab]\u6293\u4F4F\u7269\u54C1\u65F6\uFF0C\u518D\u6309[inventory1]/[inventory2]/[inventory3]\u3002\u586B\u5145\u7269\u54C1\u680F\u6240\u6709\u680F\u4F4D\uFF0C\u8BA9\u8FDB\u5EA6\u6761\u586B\u6EE1\uFF01"
