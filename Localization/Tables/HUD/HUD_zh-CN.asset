    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813283
    m_Localized: "\u4F7F\u7528[inventory1]/[inventory2]/[inventory3]\u6E05\u7A7A\u6240\u6709\u680F\u4F4D\uFF0C\u8BA9\u8FDB\u5EA6\u6761\u586B\u6EE1\uFF01"
    m_Metadata:
      m_Items: []
  - m_Id: 18554442549813284
    m_Localized: "\u4F7F\u7528[map]\u67E5\u770B\u5730\u56FE\u3002\u5730\u56FE\u662F\u8BA4\u8DEF\u7684<b><u>\u5173\u952E</u></b>\u3002"
