      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: "\u0421\u0435\u0440\u043F\u0430\u0441\u0442\u0438\u0439 \u043C\u0456\u0441\u044F\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "\u0417\u0446\u0456\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0438\u043A
      \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0438 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      35 \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u0456\u0432 \u0432\u0430\u0436\u0447\u0435
      \u0437\u0431\u0438\u0442\u0438 \u0446\u0456\u043D\u043D\u0438\u043C\u0438 \u0440\u0435\u0447\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "\u041F\u0456\u0432\u043C\u0456\u0441\u044F\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0443\u044E\u0442\u044C
      \u0432\u0430\u0448 \u0445\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u0437\u0430\u0437\u043D\u0430\u044E\u0442\u044C
      \u0442\u044F\u0436\u043A\u0438\u0445 \u0443\u0448\u043A\u043E\u0434\u0436\u0435\u043D\u044C
      \u0432\u0456\u0434 \u044F\u043C, \u0430\u043B\u0435 \u043C\u043E\u0436\u0443\u0442\u044C
      \u0432\u0438\u0436\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "\u0417\u0446\u0456\u043B\u044E\u0432\u0430\u043B\u044C\u043D\u0438\u043A
      \u0432\u0430\u043D\u0442\u0430\u0436\u0456\u0432\u043A\u0438 \u0432\u0456\u0434\u043D\u043E\u0432\u043B\u044E\u0454
      25 \u0437\u0434\u043E\u0440\u043E\u0432\u2019\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: "\u041F\u043E\u0432\u043D\u0438\u0439 \u043C\u0456\u0441\u044F\u0446\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u0438 \u043F\u0435\u0440\u0435\u0432\u0430\u043D\u0442\u0430\u0436\u0443\u044E\u0442\u044C
      \u0432\u0430\u0448 \u0445\u0430\u043F\u0430\u043B\u044C\u043D\u0438\u043A \u0441\u0443\u043C\u0430\u0440\u043D\u043E
