    m_Localized: "\u0423 \u0446\u0456\u0439 \u0433\u0440\u0456 \u0454 \u043C\u0438\u0433\u043E\u0442\u043B\u0438\u0432\u0435
      \u0441\u0432\u0456\u0442\u043B\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "\u0423 \u0434\u0435\u044F\u043A\u0438\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043C\u043E\u0436\u0435 \u0441\u0442\u0430\u0442\u0438\u0441\u044C \u0435\u043F\u0456\u043B\u0435\u043F\u0442\u0438\u0447\u043D\u0438\u0439
      \u043D\u0430\u043F\u0430\u0434 \u043F\u0456\u0434 \u0432\u043F\u043B\u0438\u0432\u043E\u043C
      \u043F\u0435\u0432\u043D\u0438\u0445 \u0441\u0432\u0456\u0442\u043B\u043E\u0432\u0438\u0445
      \u0432\u0456\u0437\u0435\u0440\u0443\u043D\u043A\u0456\u0432 \u0456 \u043C\u0435\u0440\u0435\u0445\u0442\u043B\u0438\u0432\u043E\u0433\u043E
      \u0441\u0432\u0456\u0442\u043B\u0430. \u042F\u043A\u0449\u043E \u043F\u0456\u0434
      \u0447\u0430\u0441 \u0433\u0440\u0438 \u0432\u0438 \u0432\u0456\u0434\u0447\u0443\u0454\u0442\u0435
      \u0431\u0443\u0434\u044C-\u044F\u043A\u0438\u0439 \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442,
      \u043D\u0435\u0433\u0430\u0439\u043D\u043E \u043F\u0440\u0438\u043F\u0438\u043D\u0456\u0442\u044C
      \u0433\u0440\u0443 \u0442\u0430 \u0437\u0432\u0435\u0440\u043D\u0456\u0442\u044C\u0441\u044F
      \u0434\u043E \u043B\u0456\u043A\u0430\u0440\u044F."
    m_Metadata:
      m_Items: []
