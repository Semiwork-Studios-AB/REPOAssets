    m_Localized: Gemte spil
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029711
    m_Localized: Gemte spil
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "Her er alt det spas og l\xF8jer du har lavet, og her kan du forts\xE6tte
      lige hvor du slap."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029713
    m_Localized: Slet gemt spil
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029714
    m_Localized: "Indl\xE6s gemt spil"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029715
    m_Localized: Brug backup
    m_Metadata:
      m_Items: []
  - m_Id: 10257803930230784
    m_Localized: "(Klik for at omd\xF8be)"
    m_Metadata:
      m_Items: []
  - m_Id: 7715786482245632
    m_Localized: Beskadiget spilfil
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: "Aktuel m\xE5ne:"
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: "Samlet indt\xE6gt:"
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: "Det var ikke s\xE5 godt!"
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: "Tryk p\xE5 \"Slet gemt spil\" for at slette hele spilfilsmappen."
    m_Metadata:
      m_Items: []
  - m_Id: 5801515992834048
    m_Localized: '{players:list:{}|,   |   og   }'
    m_Metadata:
      m_Items:
      - rid: 7803763168112017414
  - m_Id: 7730571982659584
    m_Localized: "\xC5h nej!"
    m_Metadata:
      m_Items: []
  - m_Id: 7730572012019712
    m_Localized: Beskadiget spilfil
    m_Metadata:
      m_Items: []
  - m_Id: 8038179729825792
    m_Localized: "Omd\xF8b gemt spil"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991616
    m_Localized: Tilbage
    m_Metadata:
      m_Items: []
