      m_Items: []
  - m_Id: 15661116075008006
    m_Localized: Start spil
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008007
    m_Localized: "Er alle klar?\n\nN\xE5r spillet k\xF8rer kan nye spillere ikke
      komme med."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008008
    m_Localized: Ja!
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008009
    m_Localized: Nej vent lige!
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008010
    m_Localized: Forlad lobby
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008011
    m_Localized: Er du sikker?
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008012
    m_Localized: Ja
