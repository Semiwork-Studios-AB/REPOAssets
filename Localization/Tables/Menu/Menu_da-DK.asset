      - rid: 7803763168112017414
  - m_Id: 23207164712574976
    m_Localized: '{ping} ms'
    m_Metadata:
      m_Items:
      - rid: 7803763168112017414
  - m_Id: 26475650059841536
    m_Localized: Fotosensitivitetsadvarsel
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: Spillet indeholder blinkende lys.
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Visse personer kan opleve epileptiske anfald, n\xE5r de uds\xE6ttes
      for lysm\xF8nstre og blinkende lys. Stop straks med at spille hvis du f\xF8ler
      ubehag, og kontakt en l\xE6ge."
    m_Metadata:
      m_Items: []
  - m_Id: 30857599407521792
    m_Localized: Servicestationen
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687616
    m_Localized: "Kv\xE6rnearenaen"
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687617
    m_Localized: McJannek stationen
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687618
    m_Localized: "Hovedmandens herreg\xE5rd"
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687619
    m_Localized: Museet for menneskets kunst
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687620
    m_Localized: "Vimsekost h\xF8jskole"
    m_Metadata:
      m_Items: []
  - m_Id: 30862829494894592
    m_Localized: "K\xF8bmanden"
    m_Metadata:
      m_Items: []
  - m_Id: 30862829524254720
    m_Localized: Niveau {number}
    m_Metadata:
      m_Items:
      - rid: 7803763168112017414
  - m_Id: 30862829524254721
    m_Localized: Spillet er ude
    m_Metadata:
      m_Items: []
  - m_Id: 33065608682569728
    m_Localized: Du gjorde det helt selv!
    m_Metadata:
      m_Items: []
  - m_Id: 33437954568257536
    m_Localized: "Gr\xE6nsen for gemte spil er n\xE5et"
    m_Metadata:
      m_Items: []
  - m_Id: 33437954593423360
    m_Localized: "Du kan kun have {limit} gemte spil ad gangen. Du er n\xF8dt til
      at slette nogle gemte spil for at lave plads."
    m_Metadata:
      m_Items:
      - rid: 7803763168112017414
  - m_Id: 33437954593423361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 33712689910808576
    m_Localized: Sparket ud
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168704
    m_Localized: "Du er blevet sparket ud af v\xE6rten."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168705
    m_Localized: Okay, nederen
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168706
    m_Localized: Frakoblet
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390400
    m_Localized: "\xC5rsag:"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168708
    m_Localized: "Indl\xE6sningen h\xE6nger"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168709
    m_Localized: "V\xE6rten er frakoblet"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390401
    m_Localized: Du er banlyst fra den her lobby.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168710
    m_Localized: Okay, nederen
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168711
