    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296962
    m_Localized: Ja!
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296963
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 15673645669015552
    m_Localized: Godkend
    m_Metadata:
      m_Items: []
  - m_Id: 16030297698066432
    m_Localized: "Spiller p\xE5 vej..."
    m_Metadata:
      m_Items: []
  - m_Id: 16702161813680128
    m_Localized: Nedre ansigt
    m_Metadata:
      m_Items: []
  - m_Id: 17747241957765120
    m_Localized: Ryd
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930944
    m_Localized: "Er du sikker p\xE5 at du vil tage alt dit t\xF8j og kropsdele og
      hall\xF8j af?\n\nDet kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930945
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930946
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930947
    m_Localized: Ryd
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930948
    m_Localized: "Er du sikker p\xE5 at du vil tage alle dine kropsdele af?\n\nDet
      kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930949
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930950
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930951
    m_Localized: Ryd
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930952
    m_Localized: "Er du sikker p\xE5 at du vil tage alt dit t\xF8j af?\n\nDet kan
      ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930953
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930954
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930955
    m_Localized: "Bland tilf\xE6ldigt"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930956
    m_Localized: "Er du sikker p\xE5 at du tilf\xE6ldigt vil blande alt dit t\xF8j
      og kropsdele?\n\nDet kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930957
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930958
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930959
    m_Localized: "Bland tilf\xE6ldigt"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930960
    m_Localized: "Er du sikker p\xE5 at du tilf\xE6ldigt vil blande alle kropsdele?\n\nDet
      kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930961
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930962
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930963
    m_Localized: "Bland tilf\xE6ldigt"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930964
    m_Localized: "Er du sikker p\xE5 at du tilf\xE6ldigt vil blande alt t\xF8j?\n\nDet
      kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930965
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930966
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930967
    m_Localized: Skift farve
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930968
    m_Localized: "Det kommer til at erstatte farven p\xE5 alle dine kropsdele.\n\nDet
      kan ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930969
    m_Localized: Jaer :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930970
