  - m_Id: 22911118074785792
    m_Localized: "Aktive m\xE5ner"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: Tilbage
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: "M\xE5nesegl"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: Livgiveren i flyttebilen giver nu 35 liv.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Monstre er nu sv\xE6rere at sl\xE5 omkuld med v\xE6rdigenstande."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "Halvm\xE5ne"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "Monstre overbelaster nu din hapsestr\xE5le."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: Monstre tager stor skade fra huller, men kan overleve.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: Livgiveren i flyttebilen giver nu 25 liv.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: "Fuldm\xE5ne"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "Monstre overbelaster nu din hapsestr\xE5le med en samlet for\xF8gelse
      p\xE5 25%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: Monstre tager nu mindre skade fra huller.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: "Superm\xE5ne"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: "Fjendekugler eksploderer nu n\xE5r de g\xE5r i stykker."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "Monstre overbelaster nu din hapsestr\xE5le med en samlet for\xF8gelse
      p\xE5 50%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: Monstre tager nu endu mindre skade fra huller.
    m_Metadata:
      m_Items: []
