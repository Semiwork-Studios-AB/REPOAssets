    m_Localized: Godkend
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853696
    m_Localized: "Indl\xE6s gemt spil"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853697
    m_Localized: "Indl\xE6s det her gemte spil?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853698
    m_Localized: Ja!
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853699
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853700
    m_Localized: Slet gemt spil
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853701
    m_Localized: "Er du HELT SIKKER p\xE5 at du vil slette det her gemte spil FOR
      EVIGT?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853702
    m_Localized: Jaer! :')
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853703
    m_Localized: Nej...
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853704
    m_Localized: Gendan fra backup
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853705
    m_Localized: "Overskriv det her gemte spil med den seneste backup?\n\nDet kan
      ikke g\xF8res om!"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853706
    m_Localized: Ja!
