    m_Metadata:
      m_Items: []
  - m_Id: 754728038916096
    m_Localized: "Opret spil som v\xE6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: "Vennen med den bedste computer skal helst v\xE6re v\xE6rt.\n\n\nEr
      du den ven?"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: Haha jaaa! :)
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: Det er ikke mig... :'(
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Advarsel
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "N\xE5r du spiller med tilf\xE6ldige spillere, kan det v\xE6re du
      m\xF8der folk der snyder, eller bare er rigtig ubehaglige..."
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: "Jeg forst\xE5r"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: Ellers tak :(
    m_Metadata:
      m_Items: []
  - m_Id: 4093170002669568
    m_Localized: Afslut spillet
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: Sluk for hele programmet?
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: Selvdestruktion
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: "Helt s\xE6ri\xF8st?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: Det er ude med mig
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
    m_Localized: Nej
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735490
    m_Localized: Ja
    m_Metadata:
