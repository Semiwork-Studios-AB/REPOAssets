  m_TableData:
  - m_Id: 33712689940168712
    m_Localized: 'Twoja wersja: {versionSelf}

      Wersja tego lobby: {version}'
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 53350507566661632
    m_Localized: "Czy na pewno chcesz do\u0142\u0105czy\u0107?\n{lobbyName}"
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 5801515992834048
    m_Localized: '{players:list:{}|,   |   i   }'
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 33437954593423360
    m_Localized: "Limit zapisanych gier wynosi {limit}. Aby stworzy\u0107 nowy zapis,
      nale\u017Cy usun\u0105\u0107 wcze\u015Bniejszy."
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 23207164712574976
    m_Localized: '{ping} ms'
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 23197572767145984
    m_Localized: '{ping} ms'
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 30862829524254720
    m_Localized: Poziom {number}
    m_Metadata:
      m_Items:
      - rid: 2515126557588324493
  - m_Id: 62270994624512
    m_Localized: Gra prywatna
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790336
    m_Localized: Gra publiczna
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790337
    m_Localized: "Do\u0142\u0105cz do znajomego"
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790338
    m_Localized: Gra solo
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790339
    m_Localized: Samouczek
    m_Metadata:
      m_Items: []
  - m_Id: 21739271462313984
    m_Localized: Personalizacja
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790340
    m_Localized: Ustawienia
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790341
    m_Localized: "Wyjd\u017A z gry"
    m_Metadata:
      m_Items: []
  - m_Id: 754728038916096
    m_Localized: "Stw\xF3rz gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: "Znajomy z najlepszym sprz\u0119tem \npowinien by\u0107 gospodarzem.\n\nCzy
      jeste\u015B tym znajomym?"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: Haha, no ba!  :)
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: "Nie, raczej nie\u2026  :'("
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Uwaga
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "Podczas rozgrywki jest mo\u017Cliwo\u015B\u0107 natrafienia na
      osoby oszukuj\u0105ce lub nieuprzejme\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: Rozumiem
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: "Nie, dzi\u0119ki :("
    m_Metadata:
      m_Items: []
  - m_Id: 4093170002669568
    m_Localized: "Wyjd\u017A z gry"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: "Zamkn\u0105\u0107 aplikacj\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735488
    m_Localized: "Menu g\u0142\xF3wne"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735489
    m_Localized: "Wyj\u015B\u0107 do menu g\u0142\xF3wnego?"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735490
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735491
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: Autodestrukcja
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: "Naprawd\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: Dla mnie to koniec
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 33712689910808576
    m_Localized: "Wyrzucono ci\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168704
    m_Localized: "Gospodarz wyrzuci\u0142 ci\u0119 z gry."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168705
    m_Localized: Cholibka, no ok
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168706
    m_Localized: "Roz\u0142\u0105czono"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390400
    m_Localized: "Pow\xF3d:"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168708
    m_Localized: Przekroczono limit czasu wczytywania
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168709
    m_Localized: "Gospodarz si\u0119 roz\u0142\u0105czy\u0142"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390401
    m_Localized: "Masz zakaz wst\u0119pu do tego lobby."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168710
    m_Localized: Cholibka, no ok
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168711
    m_Localized: "Z\u0142a wersja gry"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168713
    m_Localized: Cholibka, no ok
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168714
    m_Localized: "Lobby zamkni\u0119te"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168715
    m_Localized: "Lobby zosta\u0142o zamkni\u0119te."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168716
    m_Localized: Cholibka, no ok
    m_Metadata:
      m_Items: []
  - m_Id: 53350507528912896
    m_Localized: "Do\u0142\u0105cz do serwera"
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661633
    m_Localized: Jeszcze jak!
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661634
    m_Localized: Nie!
    m_Metadata:
      m_Items: []
