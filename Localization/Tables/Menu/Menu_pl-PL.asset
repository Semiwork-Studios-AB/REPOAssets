      m_Items: []
  - m_Id: 15590857808797696
    m_Localized: "Pomi\u0144"
    m_Metadata:
      m_Items: []
  - m_Id: 15673645669015552
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116045647872
    m_Localized: Lobby
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008000
    m_Localized: "Wci\u015Bnij [chat], aby czatowa\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008001
    m_Localized: "Rozpocznij gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 16030297698066432
    m_Localized: "Gracz do\u0142\u0105cza..."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008002
    m_Localized: "Zapro\u015B"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008003
    m_Localized: Ustawienia
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008004
    m_Localized: Modyfikuj
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008005
    m_Localized: "Opu\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008006
    m_Localized: "Rozpocznij gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008007
    m_Localized: "Wszyscy gotowi?\n\nGdy gra si\u0119 rozpocznie,\nnowi gracze nie
      b\u0119d\u0105 mogli do\u0142\u0105czy\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008008
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008009
    m_Localized: Nie, moment!
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008010
    m_Localized: "Opu\u015B\u0107 lobby"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008011
    m_Localized: Na pewno?
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008012
    m_Localized: Tak
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008013
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 26475650059841536
    m_Localized: "Ostrze\u017Cenie o \u015Bwiat\u0142oczu\u0142o\u015Bci"
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: "W tej grze pojawiaj\u0105 si\u0119 b\u0142yskaj\u0105ce \u015Bwiat\u0142a."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Niekt\xF3re osoby mog\u0105 do\u015Bwiadczy\u0107 ataku epileptycznego
      na skutek oddzia\u0142ywania efekt\xF3w \u015Bwietlnych lub b\u0142yskaj\u0105cych
      \u015Bwiate\u0142. Je\u015Bli podczas grania odczujesz dyskomfort, natychmiast
      przesta\u0144 gra\u0107 i skontaktuj si\u0119 z lekarzem."
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972608
    m_Localized: Wczytywanie
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972609
    m_Localized: "Wczytywanie si\u0119 zawiesi\u0142o?"
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972610
    m_Localized: "Wci\u015Bnij [back], aby wyj\u015B\u0107 do menu g\u0142\xF3wnego"
