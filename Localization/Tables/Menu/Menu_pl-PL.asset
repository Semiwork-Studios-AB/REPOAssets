  - m_Id: 10581343602728965
    m_Localized: "G\xF3ra stroju"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728966
    m_Localized: "D\xF3\u0142 stroju"
    m_Metadata:
      m_Items: []
  - m_Id: 15231403133231104
    m_Localized: But lewy
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728969
    m_Localized: "Wz\xF3r g\xF3rnej cz\u0119\u015Bci g\u0142owy"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728970
    m_Localized: "Wz\xF3r dolnej cz\u0119\u015Bci g\u0142owy"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728961
    m_Localized: "Wz\xF3r g\xF3rnej cz\u0119\u015Bci cia\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728968
    m_Localized: "Wz\xF3r dolnej cz\u0119\u015Bci cia\u0142a"
    m_Metadata:
      m_Items: []
  - m_Id: 15240008624496640
    m_Localized: "Wz\xF3r prawego ramienia"
    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468160
    m_Localized: "Wz\xF3r lewego ramienia"
    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468161
    m_Localized: "Wz\xF3r prawej nogi"
    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468162
    m_Localized: "Wz\xF3r lewej nogi"
    m_Metadata:
      m_Items: []
  - m_Id: 16702161813680128
    m_Localized: "Dolna cz\u0119\u015B\u0107 twarzy"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728971
    m_Localized: "Usu\u0144 zestaw"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728972
    m_Localized: "Czy NA PEWNO chcesz usun\u0105\u0107 ten zestaw NA ZAWSZE?"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728973
    m_Localized: Tak! :')
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728974
    m_Localized: Nie...
    m_Metadata:
      m_Items: []
  - m_Id: 17747241957765120
    m_Localized: "Wyczy\u015B\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930944
    m_Localized: "Czy na pewno chcesz zdj\u0105\u0107 wszystkie cz\u0119\u015Bci
      cia\u0142a i przedmioty kosmetyczne?\n\nTo jest nieodwracalne!"
