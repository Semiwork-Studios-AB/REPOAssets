  - m_Id: 21825235077554180
    m_Localized: "Aktywne ksi\u0119\u017Cyce"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554181
    m_Localized: "Menu g\u0142\xF3wne"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554182
    m_Localized: "Wyjd\u017A z gry"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118074785792
    m_Localized: "Aktywne ksi\u0119\u017Cyce"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: "Wr\xF3\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: "Ksi\u0119\u017Cyc w nowiu"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "Modu\u0142 leczniczy w ci\u0119\u017Car\xF3wce przywraca teraz
      35 pkt zdrowia."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Potwory trudniej teraz przewr\xF3ci\u0107 warto\u015Bciowymi przedmiotami."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "P\xF3\u0142ksi\u0119\u017Cyc"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "Potwory przeci\u0105\u017Caj\u0105 teraz tw\xF3j chwytak."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "Potwory otrzymuj\u0105 powa\u017Cne obra\u017Cenia od do\u0142\xF3w,
      ale mog\u0105 przetrwa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "Modu\u0142 leczniczy w ci\u0119\u017Car\xF3wce przywraca teraz
      25 pkt zdrowia."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: "Ksi\u0119\u017Cyc w pe\u0142ni"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "Potwory przeci\u0105\u017Caj\u0105 teraz tw\xF3j chwytak o 25%
      szybciej."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: "Potwory otrzymuj\u0105 teraz mniejsze obra\u017Cenia od do\u0142\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: "Superksi\u0119\u017Cyc"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: "Kule przeciwnik\xF3w teraz wybuchaj\u0105 podczas zniszczenia."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "Potwory przeci\u0105\u017Caj\u0105 teraz tw\xF3j chwytak o 50%
      szybciej."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: "Potwory otrzymuj\u0105 teraz mniejsze obra\u017Cenia od do\u0142\xF3w."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029706
    m_Localized: "< Wr\xF3\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029707
    m_Localized: Nowa gra
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029708
    m_Localized: Tryb gry solo
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029709
    m_Localized: Tryb gry wieloosobowej
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029710
    m_Localized: Zapisane gry
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029711
    m_Localized: Zapisane gry
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "Oto ca\u0142a zabawa, kt\xF3r\u0105 uda\u0142o ci si\u0119 prze\u017Cy\u0107,
      i szansa na to, by j\u0105 kontynuowa\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029713
    m_Localized: "Usu\u0144 zapisan\u0105 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029714
    m_Localized: "Wczytaj zapisan\u0105 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029715
    m_Localized: "U\u017Cyj kopii zapasowej"
    m_Metadata:
      m_Items: []
  - m_Id: 10257803930230784
    m_Localized: "(Naci\u015Bnij, by zmieni\u0107 nazw\u0119)"
    m_Metadata:
      m_Items: []
  - m_Id: 7715786482245632
    m_Localized: Uszkodzony plik zapisu
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: "Obecna faza ksi\u0119\u017Cyca:"
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: "\u0141\u0105czny zysk:"
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: Przepraszamy!
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: "Wci\u015Bnij \u201EUsu\u0144 zapisan\u0105 gr\u0119\u201D, aby
      usun\u0105\u0107 \nca\u0142y folder z plikami zapisu."
    m_Metadata:
      m_Items: []
  - m_Id: 33065608682569728
    m_Localized: "Uda\u0142o ci si\u0119 w\u0142asnymi si\u0142ami!"
    m_Metadata:
      m_Items: []
  - m_Id: 7730571982659584
    m_Localized: Ups!
    m_Metadata:
      m_Items: []
  - m_Id: 7730572012019712
    m_Localized: Uszkodzony plik zapisu
    m_Metadata:
      m_Items: []
  - m_Id: 8038179729825792
    m_Localized: "Zmie\u0144 nazw\u0119 zapisanej gry"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991616
    m_Localized: "Wr\xF3\u0107"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991617
    m_Localized: "Potwierd\u017A"
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296960
    m_Localized: Nowa gra
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296961
    m_Localized: "Czy chcesz rozpocz\u0105\u0107 now\u0105 gr\u0119?"
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296962
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296963
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 33437954568257536
    m_Localized: "Osi\u0105gni\u0119to limit zapis\xF3w"
    m_Metadata:
      m_Items: []
  - m_Id: 33437954593423361
    m_Localized: OK
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853696
    m_Localized: "Wczytaj zapisan\u0105 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853697
    m_Localized: "Wczyta\u0107 ten zapis?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853698
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853699
    m_Localized: Nie
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853700
    m_Localized: "Usu\u0144 zapisan\u0105 gr\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853701
    m_Localized: "Czy NA PEWNO chcesz usun\u0105\u0107 ten zapis NA ZAWSZE?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853702
    m_Localized: Tak! :')
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853703
    m_Localized: "Nie\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853704
    m_Localized: "Przywr\xF3\u0107 z kopii zapasowej"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853705
    m_Localized: "Czy chcesz nadpisa\u0107 ten zapis kopi\u0105 zapasow\u0105?\n\nTo
      jest nieodwracalne!"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853706
    m_Localized: Tak!
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853707
    m_Localized: Nie
