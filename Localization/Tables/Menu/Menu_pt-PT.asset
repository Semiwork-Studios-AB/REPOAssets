      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: 'Lua Atual:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: '(pt-PT) Total Haul:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: Desculpa!
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: "Carrege \"Apagar jogo salvo\" para apagar toda a pasta de grava\xE7\xF5es."
