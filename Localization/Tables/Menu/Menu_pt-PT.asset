    m_Localized: Jogos salvos
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "O teu progresso est\xE1 \xE0 tua espera. \xC9 s\xF3 voltar ao jogo."
    m_Metadata:
      m_Items: []
