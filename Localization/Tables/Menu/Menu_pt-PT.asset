    m_Localized: Sair do jogo
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: "Fechar toda a aplica\xE7\xE3o?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: Sim
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: "N\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: "Autodestrui\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: Tens a certeza?
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: Adeus, mundo cruel
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
