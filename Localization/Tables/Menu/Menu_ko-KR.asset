      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: "\uC774 \uAC8C\uC784\uC740 \uBE5B\uC774 \uBC88\uCA4D\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "\uC5B4\uB5A4 \uC0AC\uB78C\uC740 \uBE5B \uD328\uD134\uACFC \uBC88\uCA4D\uC774\uB294
      \uBE5B\uC5D0 \uB178\uCD9C\uB418\uBA74 \uAC04\uC9C8\uC131 \uBC1C\uC791\uC744
      \uC77C\uC73C\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uD50C\uB808\uC774\uD558\uB2E4
      \uBAB8\uC774 \uBD88\uD3B8\uD558\uBA74 \uC989\uC2DC \uD50C\uB808\uC774\uB97C
      \uBA48\uCD94\uACE0 \uC758\uC0AC\uC640 \uC0C1\uB2F4\uD558\uC138\uC694."
