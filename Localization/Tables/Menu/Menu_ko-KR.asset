  - m_Id: 15661116075008007
    m_Localized: "\uB2E4\uB4E4 \uC900\uBE44\uB410\uB098\uC694?\n\n\uC77C\uB2E8 \uAC8C\uC784\uC774
      \uC2DC\uC791\uB418\uBA74\n\uB2E4\uB978 \uD50C\uB808\uC774\uC5B4\uAC00 \uCC38\uAC00\uD560
      \uC218 \uC5C6\uC5B4\uC694."
