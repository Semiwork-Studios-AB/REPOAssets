      m_Items: []
  - m_Id: 17747241982930944
    m_Localized: "\xC4r du s\xE4ker p\xE5 att du vill ta av dig alla kroppsdelar
      och kl\xE4der?\n\nDetta \xE4r o\xE5terkalleligt!"
