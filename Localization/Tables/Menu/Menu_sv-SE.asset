    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: Haha ja! :)
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: Inte jag... :'(
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Varning
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "N\xE4r du spelar med random folk kan du tr\xE4ffa fuskare eller
