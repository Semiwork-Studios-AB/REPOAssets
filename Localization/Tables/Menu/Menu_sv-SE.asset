  - m_Id: 22911118095757312
    m_Localized: Tillbaka
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: "Sk\xE4rm\xE5ne"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "Truckhelaren \xE5terger 35 hp."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Monster \xE4r nu sv\xE5rare att knuffa omkull med v\xE4rdesaker."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "Halvm\xE5ne"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "Monster \xF6verbelastar din greppstr\xE5le."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "Monster skadas h\xE5rt av d\xF6dsh\xE5l, men kan \xF6verleva."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "Truckhelaren \xE5terger 25 hp."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: "Fullm\xE5ne"
    m_Metadata:
      m_Items: []
