    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930952
    m_Localized: "T\xFCm kozmetikleri \xE7\u0131karmak istedi\u011Fine emin misin?\n\nBu
      i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930953
