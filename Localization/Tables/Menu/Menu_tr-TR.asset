    m_Metadata:
      m_Items: []
  - m_Id: 10257803930230784
    m_Localized: "(Yeniden Adland\u0131rmak \u0130\xE7in T\u0131kla)"
    m_Metadata:
      m_Items: []
  - m_Id: 7715786482245632
    m_Localized: "Kay\u0131t Dosyas\u0131 Bozuk"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: 'Mevcut Ay:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: 'Toplam Ganimet:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: Affedersin!
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: "T\xFCm kay\u0131t klas\xF6r\xFCn\xFC silmek i\xE7in \n\"Kayd\u0131
      Sil\" d\xFC\u011Fmesine bas."
    m_Metadata:
      m_Items: []
  - m_Id: 33065608682569728
    m_Localized: "Her \u015Feyi kendin ba\u015Fard\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 7730571982659584
    m_Localized: Eyvah!
    m_Metadata:
      m_Items: []
  - m_Id: 7730572012019712
    m_Localized: "Kay\u0131t Dosyas\u0131 Bozuk"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179729825792
    m_Localized: "Kayd\u0131 Yeniden Adland\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991616
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991617
    m_Localized: Onayla
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296960
    m_Localized: Yeni Oyun
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296961
    m_Localized: "Oyun ba\u015Flatmak istiyor musun?"
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296962
    m_Localized: Evet!
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296963
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 33437954568257536
    m_Localized: "Kay\u0131t Dosyas\u0131 S\u0131n\u0131r\u0131na Ula\u015F\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 33437954593423361
