      m_Items: []
  - m_Id: 17747241982930954
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930955
    m_Localized: "Rastgele Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930956
    m_Localized: "T\xFCm v\xFCcut par\xE7alar\u0131n\u0131 ve kozmetikleri rastgele
      se\xE7mek istedi\u011Fine emin misin?\n\nBu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930957
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930958
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930959
    m_Localized: "Rastgele Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930960
    m_Localized: "T\xFCm v\xFCcut par\xE7alar\u0131n\u0131 rastgele se\xE7mek istedi\u011Fine
      emin misin?\n\nBu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930961
    m_Localized: Evet! :')
