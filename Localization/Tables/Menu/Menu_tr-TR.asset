      m_Items:
      - rid: 2515126557588324500
  - m_Id: 62270994624512
    m_Localized: "\xD6zel Oyun"
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790336
    m_Localized: "Herkese A\xE7\u0131k Oyun"
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790337
    m_Localized: "Arkada\u015Fa Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790338
    m_Localized: Tek Oyunculu
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790339
    m_Localized: "E\u011Fitici"
    m_Metadata:
      m_Items: []
  - m_Id: 21739271462313984
    m_Localized: "\xD6zelle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790340
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 62271019790341
    m_Localized: "Oyundan \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 754728038916096
    m_Localized: Oyun Kur
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: "Oyunu, en iyi sisteme sahip olan\narkada\u015F kurmal\u0131d\u0131r.\n\nBu
      arkada\u015F sen misin?"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: Haha evet! :)
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: "Ben de\u011Filim...  :'("
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Dikkat
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: Rastgele oyuncularla oynarken hilecilere veya kaba insanlara denk
      gelebilirsin...
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: "Anlad\u0131m"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: "\u0130stemem, kals\u0131n :("
    m_Metadata:
      m_Items: []
  - m_Id: 4093170002669568
    m_Localized: "Oyundan \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: "Uygulamay\u0131 tamamen kapat?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735488
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735489
    m_Localized: "Ana men\xFCye d\xF6n?"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735490
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735491
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: "Kendini \u0130mha Etme"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: Cidden mi?
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: Benden bu kadar
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689910808576
    m_Localized: "At\u0131ld\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168704
    m_Localized: "Oyun kurucu taraf\u0131ndan at\u0131ld\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168705
    m_Localized: Lanet Olsun
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168706
    m_Localized: "Ba\u011Flant\u0131 kesildi"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390400
    m_Localized: 'Neden:'
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168708
    m_Localized: "Y\xFCklenirken tak\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168709
    m_Localized: "Oyun kurucuyla ba\u011Flant\u0131 kesildi"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390401
    m_Localized: "Bu lobiden yasakland\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168710
    m_Localized: Lanet Olsun
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168711
    m_Localized: "Oyun S\xFCr\xFCm\xFC Yanl\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168713
    m_Localized: Lanet Olsun
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168714
    m_Localized: "Lobi Kapal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168715
    m_Localized: "Lobi kapat\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168716
    m_Localized: Lanet Olsun
    m_Metadata:
      m_Items: []
  - m_Id: 53350507528912896
    m_Localized: "Sunucuya Kat\u0131l"
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661633
    m_Localized: Evet!
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661634
    m_Localized: "Hay\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235048194048
    m_Localized: "Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554176
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554177
    m_Localized: "\xD6zelle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554178
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554179
    m_Localized: "Kendini \u0130mha Et"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554180
    m_Localized: Etkin Aylar
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554181
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554182
    m_Localized: "Oyundan \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118074785792
    m_Localized: Etkin Aylar
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: Hilal
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "Kamyon, art\u0131k 35 sa\u011Fl\u0131k yeniler."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "De\u011Ferli e\u015Fyalar\u0131 kullanarak canavarlar\u0131 alt
      etmek art\u0131k daha zor."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "Yar\u0131m Ay"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "Canavarlar, kavray\u0131c\u0131n\u0131 art\u0131k a\u015F\u0131r\u0131
      y\xFCkler."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "Canavarlar, \xE7ukura d\xFC\u015Ft\xFC\u011F\xFCnde a\u011F\u0131r
      hasar al\u0131r ama sa\u011F kurtulabilir."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "Kamyon, art\u0131k 25 sa\u011Fl\u0131k yeniler."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: Dolunay
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "Canavarlar, kavray\u0131c\u0131n\u0131 art\u0131k %25 daha fazla
      a\u015F\u0131r\u0131 y\xFCkler."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: "Canavarlar, \xE7ukura d\xFC\u015Ft\xFC\u011F\xFCnde art\u0131k
      daha az hasar al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: "S\xFCper Ay"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: "D\xFC\u015Fman K\xFCreleri yok edildi\u011Finde art\u0131k patlar."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "Canavarlar, kavray\u0131c\u0131n\u0131 art\u0131k %50 daha fazla
      a\u015F\u0131r\u0131 y\xFCkler."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: "Canavarlar, \xE7ukura d\xFC\u015Ft\xFC\u011F\xFCnde art\u0131k
      daha da az hasar al\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029706
    m_Localized: "< Geri D\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029707
    m_Localized: Yeni Oyun
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029708
