      m_Items: []
  - m_Id: 17747241982930962
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930963
    m_Localized: "Rastgele Se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930964
    m_Localized: "T\xFCm kozmetikleri rastgele se\xE7mek istedi\u011Fine emin misin?\n\nBu
      i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930965
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930966
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 10892493724835840
    m_Localized: "Renk De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 10892493724835841
    m_Localized: "Bu, t\xFCm v\xFCcut par\xE7alar\u0131 ve kozmetiklerin rengini
      de\u011Fi\u015Ftirecek.\n\nBu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 10892493724835842
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 10892493724835843
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930967
    m_Localized: "Renk De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930968
    m_Localized: "Bu, t\xFCm v\xFCcut par\xE7alar\u0131n\u0131n rengini de\u011Fi\u015Ftirecek.\n\nBu
      i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930969
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930970
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930971
    m_Localized: "Renk De\u011Fi\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930972
    m_Localized: "Bu, t\xFCm kozmetiklerin rengini de\u011Fi\u015Ftirecek.\n\nBu
      i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930973
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930974
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 15590857783631872
    m_Localized: "\u015Eifre"
    m_Metadata:
      m_Items: []
  - m_Id: 15590857808797696
    m_Localized: Atla
    m_Metadata:
      m_Items: []
  - m_Id: 15673645669015552
    m_Localized: Onayla
    m_Metadata:
      m_Items: []
  - m_Id: 15661116045647872
    m_Localized: Lobi
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008000
    m_Localized: "Sohbet etmek i\xE7in [chat] tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008001
    m_Localized: "Oyunu Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 16030297698066432
    m_Localized: "Oyuncu Kat\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008002
    m_Localized: Davet Et
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008003
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008004
    m_Localized: "\xD6zelle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008005
    m_Localized: "\xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008006
    m_Localized: "Oyunu Ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008007
    m_Localized: "Herkes haz\u0131r m\u0131?\n\nOyun ba\u015Flad\u0131ktan sonra\nyeni
      oyuncu kat\u0131lamaz."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008008
    m_Localized: Evet!
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008009
    m_Localized: "Hay\u0131r, bekle!"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008010
    m_Localized: "Lobiden \xC7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008011
    m_Localized: Emin misin?
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008012
    m_Localized: Evet
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008013
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 26475650059841536
    m_Localized: "I\u015F\u0131\u011Fa Duyarl\u0131l\u0131k Uyar\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: "Bu oyunda yan\u0131p s\xF6nen \u0131\u015F\u0131klar bulunur."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Baz\u0131 ki\u015Filer, belirli \u0131\u015F\u0131k t\xFCrlerine
      ve yan\u0131p s\xF6nen \u0131\u015F\u0131klara maruz kald\u0131\u011F\u0131nda
      epilepsi n\xF6beti ge\xE7irebilir. Oyun s\u0131ras\u0131nda bir rahats\u0131zl\u0131k
      hissedersen oyunu hemen durdur ve bir doktora g\xF6r\xFCn."
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972608
    m_Localized: "Y\xFCkleniyor"
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972609
    m_Localized: "Y\xFCklenirken tak\u0131ld\u0131 m\u0131?"
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972610
    m_Localized: "Ana men\xFCye d\xF6nmek i\xE7in [back] tu\u015Funa bas"
    m_Metadata:
      m_Items: []
  - m_Id: 30862829494894592
    m_Localized: "D\xFCkk\xE2n"
    m_Metadata:
      m_Items: []
  - m_Id: 30862829524254721
    m_Localized: Oyun Bitti
    m_Metadata:
      m_Items: []
  - m_Id: 30857599407521792
    m_Localized: Benzinlik
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687616
    m_Localized: "At\u0131k Ar\u0131tma Arenas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687617
    m_Localized: McJannek Tesisi
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687618
    m_Localized: "A\u011Fa'n\u0131n Malik\xE2nesi"
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687619
    m_Localized: "\u0130nsan Sanatlar\u0131 M\xFCzesi"
    m_Metadata:
      m_Items: []
  - m_Id: 30857599432687620
    m_Localized: "Jet S\xFCp\xFCrge Akademisi"
    m_Metadata:
      m_Items: []
  - m_Id: 74362528585474048
    m_Localized: "G\xFCnta\u015F\u0131 Vadisi Tatil K\xF6y\xFC"
    m_Metadata:
      m_Items: []
