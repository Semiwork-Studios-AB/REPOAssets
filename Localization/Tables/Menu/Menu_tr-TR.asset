    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468160
    m_Localized: Sol Kol Deseni
    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468161
    m_Localized: "Sa\u011F Bacak Deseni"
    m_Metadata:
      m_Items: []
  - m_Id: 15240008645468162
    m_Localized: Sol Bacak Deseni
    m_Metadata:
      m_Items: []
  - m_Id: 16702161813680128
    m_Localized: "Y\xFCz (Alt)"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728971
    m_Localized: "\xD6n Ayar\u0131 Sil"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728972
    m_Localized: "Bu \xF6n ayar\u0131 KALICI OLARAK silmek istedi\u011Fine EM\u0130N
      M\u0130S\u0130N?"
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728973
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 10581343602728974
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241957765120
    m_Localized: Temizle
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930944
    m_Localized: "T\xFCm v\xFCcut par\xE7alar\u0131n\u0131 ve kozmetikleri \xE7\u0131karmak
      istedi\u011Fine emin misin?\n\nBu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930945
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930946
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930947
    m_Localized: Temizle
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930948
    m_Localized: "T\xFCm v\xFCcut par\xE7alar\u0131n\u0131 \xE7\u0131karmak istedi\u011Fine
      emin misin?\n\nBu i\u015Flem geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
  - m_Id: 17747241982930949
