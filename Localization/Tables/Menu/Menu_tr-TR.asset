    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029710
    m_Localized: "Kay\u0131tl\u0131 Oyunlar"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029711
    m_Localized: "Kay\u0131tl\u0131 Oyunlar"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "\u0130\u015Fte ya\u015Fad\u0131\u011F\u0131n t\xFCm o e\u011Flenceli
      anlara kald\u0131\u011F\u0131n yerden devam et."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029713
    m_Localized: "Kayd\u0131 Sil"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029714
    m_Localized: "Kay\u0131t Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029715
