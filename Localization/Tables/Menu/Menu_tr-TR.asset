    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853696
    m_Localized: "Kay\u0131t Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853697
    m_Localized: "Bu kayd\u0131 y\xFCkle?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853698
    m_Localized: Evet!
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853699
    m_Localized: "Hay\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853700
    m_Localized: "Kayd\u0131 Sil"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853701
    m_Localized: "Bu kayd\u0131 KALICI OLARAK silmek istedi\u011Fine EM\u0130N M\u0130S\u0130N?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853702
    m_Localized: Evet! :')
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853703
    m_Localized: "Hay\u0131r..."
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853704
    m_Localized: "Yedekten Geri Y\xFCkle"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853705
    m_Localized: "Bu kayd\u0131, en son yedekleme ile de\u011Fi\u015Ftir?\n\nBu i\u015Flem
      geri al\u0131namaz!"
    m_Metadata:
      m_Items: []
