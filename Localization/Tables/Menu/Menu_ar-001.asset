      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "\u0642\u062F \u064A\u0639\u0627\u0646\u064A \u0628\u0639\u0636
      \u0627\u0644\u0623\u0641\u0631\u0627\u062F \u0646\u0648\u0628\u0627\u062A \u0635\u0631\u0639
      \u0639\u0646\u062F \u0627\u0644\u062A\u0639\u0631\u0636 \u0644\u0623\u0646\u0645\u0627\u0637
      \u0636\u0648\u0626\u064A\u0629 \u0648\u0623\u0636\u0648\u0627\u0621 \u0648\u0627\u0645\u0636\u0629.
      \u0625\u0630\u0627 \u0634\u0639\u0631\u062A \u0628\u0623\u064A \u0625\u0632\u0639\u0627\u062C
      \u0641\u064A \u0623\u062B\u0646\u0627\u0621 \u0627\u0644\u0644\u0639\u0628\u060C
      \u0641\u062A\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u0644\u0639\u0628
      \u0641\u0648\u0631\u064B\u0627 \u0648\u0627\u0633\u062A\u0634\u0631 \u0637\u0628\u064A\u0628\u064B\u0627."
