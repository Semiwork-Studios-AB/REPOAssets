  - m_Id: 754728038916096
    m_Localized: Ospita partita
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: 'L''host dovrebbe essere il giocatore

      con il computer migliore.


      Sei
      tu?'
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: "Ahah, s\xEC! :)"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: Ehm, no... :'(
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Avvertenza
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: Nelle partite con giocatori casuali potresti incontrare persone
      truffaldine o molto cattive...
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: Ho capito
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: No, grazie :(
    m_Metadata:
      m_Items: []
