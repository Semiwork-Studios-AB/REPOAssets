  - m_Id: 22911118074785792
    m_Localized: Lune attive
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: Indietro
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: Luna crescente
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: La clinica del furgone ora ripristina 35 punti salute.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Ora i mostri sono pi\xF9 difficili da abbattere con i tesori."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: Mezzaluna
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: I mostri ora sovraccaricano la tua pinza.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: Ora i mostri subiscono danni pesanti dalle fosse, ma possono sopravvivere.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: La clinica del furgone ora ripristina 25 punti salute.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: Luna piena
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "I mostri ora sovraccaricano la tua pinza del 25% in pi\xF9."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: Ora i mostri subiscono meno danni dalle fosse.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: Super luna
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: Ore le sfere nemiche esplodono se distrutte.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "I mostri ora sovraccaricano la tua pinza del 50% in pi\xF9."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: Ora i mostri subiscono ancora meno danni dalle fosse.
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029706
    m_Localized: < Torna indietro
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029707
    m_Localized: Nuova partita
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029708
    m_Localized: "Modalit\xE0 giocatore singolo"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029709
    m_Localized: "Modalit\xE0 multigiocatore"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029710
    m_Localized: Partite salvate
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029711
    m_Localized: Partite salvate
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "Qui troverai tutto il divertimento avuto finora e la possibilit\xE0
      di riprendere da dove hai interrotto."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029713
    m_Localized: Elimina salvataggio
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029714
    m_Localized: Carica salvataggio
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029715
    m_Localized: Usa backup
    m_Metadata:
      m_Items: []
  - m_Id: 10257803930230784
    m_Localized: (Fai clic per rinominare)
    m_Metadata:
      m_Items: []
  - m_Id: 7715786482245632
    m_Localized: Salvataggio corrotto
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: 'Luna attuale:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: 'Bottino totale:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: Scusa!
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: 'Premi "Elimina salvataggio" per eliminare

      l''intera cartella
      dei salvataggi.'
    m_Metadata:
      m_Items: []
  - m_Id: 33065608682569728
    m_Localized: Ce l'hai fatta con le tue forze!
    m_Metadata:
      m_Items: []
  - m_Id: 7730571982659584
    m_Localized: Oh-oh!
    m_Metadata:
      m_Items: []
  - m_Id: 7730572012019712
    m_Localized: Salvataggio corrotto
    m_Metadata:
      m_Items: []
