      m_Items: []
  - m_Id: 5190661053853696
    m_Localized: Carica salvataggio
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853697
    m_Localized: Vuoi caricare questo salvataggio?
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853698
    m_Localized: "S\xEC!"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853699
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853700
    m_Localized: Elimina salvataggio
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853701
    m_Localized: Vuoi DAVVERO, DAVVERO eliminare questo salvataggio PER SEMPRE?
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853702
    m_Localized: "S\xEC! :')"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853703
    m_Localized: No...
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853704
    m_Localized: Ripristina da un backup
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853705
    m_Localized: "Vuoi sovrascrivere questo salvataggio con l'ultimo backup?\n\nL'operazione
      non pu\xF2 essere annullata!"
