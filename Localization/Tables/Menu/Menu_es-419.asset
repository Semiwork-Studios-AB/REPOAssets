  - m_Id: 26475650059841536
    m_Localized: Aviso de fotosensibilidad
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: Este juego contiene luces parpadeantes.
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Hay personas que pueden experimentar episodios de epilepsia tras
      la exposici\xF3n a luces parpadeantes o con dise\xF1os. Si sientes alguna incomodidad
      mientras juegas, termina tu sesi\xF3n de juego y consulta a un m\xE9dico."
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972608
    m_Localized: Cargando
    m_Metadata:
      m_Items: []
  - m_Id: 15592435403972609
