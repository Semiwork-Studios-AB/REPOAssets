  - m_Id: 754728038916096
    m_Localized: Organizar partida
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: "Lo ideal es que la partida la organice quien tenga la mejor computadora.\n\n\xBFEres
      t\xFA?"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: "\xA1Por supuesto! :)"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: Creo que no :(
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Aviso
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "Si juegas con gente desconocida, podr\xEDas encontrarte con personas
      tramposas o groseras."
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: Comprendo
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: No, gracias :(
    m_Metadata:
      m_Items: []
  - m_Id: 4093170002669568
    m_Localized: Salir del juego
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: "\xBFCerrar toda la aplicaci\xF3n?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735488
    m_Localized: "Men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735489
    m_Localized: "\xBFSalir al men\xFA principal?"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735490
    m_Localized: "S\xED"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735491
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: "Autodestrucci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: "\xBFEn verdad quieres hacerlo?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: "Lleg\xF3 mi final."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
    m_Localized: No
    m_Metadata:
      m_Items: []
  - m_Id: 33712689910808576
    m_Localized: "Expulsi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168704
    m_Localized: "El anfitri\xF3n te expuls\xF3."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168705
    m_Localized: Ay, caramba
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168706
    m_Localized: "Desconexi\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390400
    m_Localized: 'Motivo:'
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168708
    m_Localized: "Se trab\xF3 el proceso de carga."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168709
    m_Localized: "Se desconect\xF3 el anfitri\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390401
    m_Localized: Te vetaron de esta sala.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168710
    m_Localized: Ay, caramba
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168711
    m_Localized: "Versi\xF3n err\xF3nea del juego."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168713
    m_Localized: Ay, caramba
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168714
    m_Localized: Sala cerrada
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168715
    m_Localized: "Se cerr\xF3 la sala."
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168716
    m_Localized: Ay, caramba
    m_Metadata:
      m_Items: []
