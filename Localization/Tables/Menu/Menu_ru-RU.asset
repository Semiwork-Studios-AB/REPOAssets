  - m_Id: 26475650059841536
    m_Localized: "\u041F\u0440\u0435\u0434\u0443\u043F\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u0435
      \u043E \u0441\u0432\u0435\u0442\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: "\u0412 \u044D\u0442\u043E\u0439 \u0438\u0433\u0440\u0435 \u0435\u0441\u0442\u044C
      \u043C\u0438\u0433\u0430\u044E\u0449\u0438\u0439 \u0441\u0432\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "\u0423 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043B\u044E\u0434\u0435\u0439
      \u043C\u043E\u0433\u0443\u0442 \u0432\u043E\u0437\u043D\u0438\u043A\u0430\u0442\u044C
      \u043F\u0440\u0438\u043F\u0430\u0434\u043A\u0438 \u043F\u0440\u0438 \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0438
      \u0441\u0432\u0435\u0442\u043E\u0432\u044B\u0445 \u0443\u0437\u043E\u0440\u043E\u0432
      \u0438 \u0432\u0441\u043F\u044B\u0448\u0435\u043A \u0441\u0432\u0435\u0442\u0430.
      \u0415\u0441\u043B\u0438 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0438\u0433\u0440\u044B
      \u0432\u044B \u043F\u043E\u0447\u0443\u0432\u0441\u0442\u0432\u0443\u0435\u0442\u0435
      \u0434\u0438\u0441\u043A\u043E\u043C\u0444\u043E\u0440\u0442, \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E
      \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435 \u0438\u0433\u0440\u0443
      \u0438 \u043E\u0431\u0440\u0430\u0442\u0438\u0442\u0435\u0441\u044C \u043A
      \u0432\u0440\u0430\u0447\u0443."
    m_Metadata:
      m_Items: []
