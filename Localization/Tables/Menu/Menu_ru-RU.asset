      m_Items: []
  - m_Id: 22911118074785792
    m_Localized: "\u0410\u043A\u0442\u0438\u0432\u043D\u044B\u0435 \u043B\u0443\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: "\u041D\u0430\u0437\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: "\u041F\u043E\u043B\u0443\u043C\u0435\u0441\u044F\u0446"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0444\u0443\u0440\u0433\u043E\u043D
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      35 \u043E\u0447\u043A\u043E\u0432 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u043E\u0432 \u0442\u0435\u043F\u0435\u0440\u044C
      \u0441\u043B\u043E\u0436\u043D\u0435\u0435 \u0441\u0431\u0438\u0442\u044C \u0441
      \u043D\u043E\u0433 \u0446\u0435\u043D\u043D\u044B\u043C\u0438 \u0432\u0435\u0449\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: "\u0412\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0430\u044F \u043B\u0443\u043D\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u044B \u0442\u0435\u043F\u0435\u0440\u044C
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u044E\u0442 \u0432\u0430\u0448
      \u0437\u0430\u0445\u0432\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u044B \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0443\u0440\u043E\u043D \u043E\u0442
      \u044F\u043C, \u043D\u043E \u043C\u043E\u0433\u0443\u0442 \u0432\u044B\u0436\u0438\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u0444\u0443\u0440\u0433\u043E\u043D
      \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      25 \u043E\u0447\u043A\u043E\u0432 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u043B\u0443\u043D\u0438\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u044B \u0442\u0435\u043F\u0435\u0440\u044C
      \u043F\u0435\u0440\u0435\u0433\u0440\u0443\u0436\u0430\u044E\u0442 \u0432\u0430\u0448
      \u0437\u0430\u0445\u0432\u0430\u0442 \u043D\u0430 25% \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: "\u041C\u043E\u043D\u0441\u0442\u0440\u044B \u0442\u0435\u043F\u0435\u0440\u044C
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 \u043C\u0435\u043D\u044C\u0448\u0435
      \u0443\u0440\u043E\u043D\u0430 \u043E\u0442 \u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
