  - m_Id: 754728038916096
    m_Localized: Spiel hosten
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887616
    m_Localized: 'Die Person mit dem besten Computer

      sollte das Spiel hosten.


      Bist
      du das?'
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: Haha, ja! :)
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: "Nein\_\u2026 :'("
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Achtung
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "Bei zuf\xE4lligen Spielern kann es sich um Cheater oder wirklich
      gemeine Menschen handeln\_\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: Verstanden.
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
    m_Localized: Dann lieber nicht. :(
    m_Metadata:
      m_Items: []
  - m_Id: 4093170002669568
    m_Localized: Spiel beenden
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029696
    m_Localized: "Gesamte Anwendung schlie\xDFen?"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029697
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029698
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735488
    m_Localized: "Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735489
    m_Localized: "Zum Hauptmen\xFC zur\xFCck?"
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735490
    m_Localized: Ja
    m_Metadata:
      m_Items: []
  - m_Id: 21828124860735491
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029699
    m_Localized: "Selbstzerst\xF6rung"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029700
    m_Localized: Muss das sein?
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029701
    m_Localized: "Das war\u2019s f\xFCr mich."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029702
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 33712689910808576
    m_Localized: Rausgeworfen
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168704
    m_Localized: Der Host hat dich rausgeworfen.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168705
    m_Localized: Och Menno.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168706
    m_Localized: Verbindung getrennt
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390400
    m_Localized: 'Ursache:'
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168708
    m_Localized: "Im Ladebildschirm h\xE4ngen geblieben"
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168709
    m_Localized: Host hat die Verbindung getrennt
    m_Metadata:
      m_Items: []
  - m_Id: 33714292684390401
    m_Localized: Du wurdest aus der Lobby gebannt.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168710
    m_Localized: Och Menno.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168711
    m_Localized: Falsche Spielversion
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168713
    m_Localized: Och Menno.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168714
    m_Localized: Lobby geschlossen
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168715
    m_Localized: Die Lobby wurde geschlossen.
    m_Metadata:
      m_Items: []
  - m_Id: 33712689940168716
    m_Localized: Och Menno.
    m_Metadata:
      m_Items: []
  - m_Id: 53350507528912896
    m_Localized: Server beitreten
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661633
    m_Localized: Jep!
    m_Metadata:
      m_Items: []
  - m_Id: 53350507566661634
    m_Localized: "N\xF6!"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235048194048
    m_Localized: "Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554176
    m_Localized: Fortsetzen
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554177
    m_Localized: Anpassen
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554178
    m_Localized: Einstellungen
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554179
    m_Localized: "Selbst zerst\xF6ren"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554180
    m_Localized: Aktive Monde
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554181
    m_Localized: "Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 21825235077554182
    m_Localized: Spiel beenden
    m_Metadata:
      m_Items: []
  - m_Id: 22911118074785792
    m_Localized: Aktive Monde
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757312
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757313
    m_Localized: Sichelmond
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "Die Truck-Heilstation stellt nun 35\_Gesundheit wieder her."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Monster lassen sich mit Wertgegenst\xE4nden nun schwieriger umsto\xDFen."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: Halbmond
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: "Monster \xFCberladen nun deinen Greifer."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "Monster erleiden gro\xDFen Schaden, wenn sie in Gruben fallen,
      k\xF6nnen aber \xFCberleben."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "Die Truck-Heilstation stellt nun 25\_Gesundheit wieder her."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: Vollmond
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "Monster \xFCberladen deinen Greifer nun um insgesamt 25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: Monster erleiden nun weniger Schaden, wenn sie in Gruben fallen.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: Supermond
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: "Gegnerische Kugeln explodieren nun, wenn sie zerst\xF6rt werden."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "Monster \xFCberladen deinen Greifer nun um insgesamt 50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: Monster erleiden nun noch weniger Schaden, wenn sie in Gruben fallen.
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029706
    m_Localized: "< Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029707
    m_Localized: Neues Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029708
    m_Localized: Einzelspieler-Modus
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029709
    m_Localized: Mehrspieler-Modus
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029710
    m_Localized: "Spielst\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029711
    m_Localized: "Spielst\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029712
    m_Localized: "Hier wartet all der Spa\xDF, den du bisher hattest, und die Gelegenheit,
      dort weiterzumachen, wo du aufgeh\xF6rt hast."
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029713
    m_Localized: "Spielstand l\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029714
    m_Localized: Spielstand laden
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029715
    m_Localized: Sicherheitskopie verwenden
    m_Metadata:
      m_Items: []
  - m_Id: 10257803930230784
    m_Localized: (Klicken zum Umbenennen)
    m_Metadata:
      m_Items: []
  - m_Id: 7715786482245632
    m_Localized: "Besch\xE4digte Speicherdatei"
    m_Metadata:
      m_Items: []
  - m_Id: 4093170032029717
    m_Localized: 'Aktueller Mond:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549056
    m_Localized: 'Gesamte Ausbeute:'
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549057
    m_Localized: Sorry!
    m_Metadata:
      m_Items: []
  - m_Id: 5450952597549058
    m_Localized: "Dr\xFCcke \u201ESpielstand l\xF6schen\u201C, um den\nOrdner mit
      allen Spielst\xE4nden zu l\xF6schen."
    m_Metadata:
      m_Items: []
  - m_Id: 33065608682569728
    m_Localized: Das hast du alles allein geschafft!
    m_Metadata:
      m_Items: []
  - m_Id: 7730571982659584
    m_Localized: Oh-oh!
    m_Metadata:
      m_Items: []
  - m_Id: 7730572012019712
    m_Localized: "Besch\xE4digte Speicherdatei"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179729825792
    m_Localized: Spielstand umbenennen
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991616
    m_Localized: "Zur\xFCck"
    m_Metadata:
      m_Items: []
  - m_Id: 8038179754991617
    m_Localized: "Best\xE4tigen"
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296960
    m_Localized: Neues Spiel
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296961
    m_Localized: "M\xF6chtest du ein Spiel beginnen?"
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296962
    m_Localized: Ja!
    m_Metadata:
      m_Items: []
  - m_Id: 15667952224296963
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 33437954568257536
    m_Localized: "Zu viele Spielst\xE4nde"
    m_Metadata:
      m_Items: []
  - m_Id: 33437954593423361
    m_Localized: Okay.
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853696
    m_Localized: Spielstand laden
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853697
    m_Localized: Diese Speicherdatei laden?
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853698
    m_Localized: Ja!
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853699
    m_Localized: Nein
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853700
    m_Localized: "Spielstand l\xF6schen"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853701
    m_Localized: "M\xF6chtest du WIRKLICH diesen Spielstand F\xDCR IMMER l\xF6schen?"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853702
    m_Localized: Ja! :')
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853703
    m_Localized: "Nein\_\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853704
    m_Localized: Aus Sicherheitskopie wiederherstellen
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853705
    m_Localized: "M\xF6chtest du diese Speicherdatei mit der neuesten Sicherheitskopie
      \xFCberschreiben?\n\nDu kannst dies nicht r\xFCckg\xE4ngig machen!"
    m_Metadata:
      m_Items: []
  - m_Id: 5190661053853706
    m_Localized: Ja!
