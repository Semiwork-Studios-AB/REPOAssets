    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008006
    m_Localized: Aloita peli
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008007
    m_Localized: "Onko kaikki valmiita?\n\nPelin aloitettua uudet pelaajat ei voi
      liitty\xE4.\n"
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008008
    m_Localized: "Let's menn\xE4\xE4n"
    m_Metadata:
      m_Items: []
