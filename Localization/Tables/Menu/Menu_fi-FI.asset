    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: "T\xE4ss\xE4 peliss\xE4 on v\xE4lkkyvi\xE4 valoja."
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Joillakin henkil\xF6ill\xE4 voi esiinty\xE4 epileptisi\xE4 kohtauksia
      altustuessaan valokuvioille ja v\xE4lkkyville valoille. Jos tunnet ep\xE4mukavuutta
      pelaamisen aikana, lopeta pelaaminen v\xE4litt\xF6m\xE4sti ja ota yhteys l\xE4\xE4k\xE4riin."
    m_Metadata:
      m_Items: []
