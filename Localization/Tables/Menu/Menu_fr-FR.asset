      m_Items: []
  - m_Id: 754728059887616
    m_Localized: "Choisissez la personne avec l\u2019ordinateur le plus performant\npour
      h\xE9berger la partie.\n\nEst-ce que c\u2019est vous\_?"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887617
    m_Localized: "Bien s\xFBr que oui\_! :)"
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887618
    m_Localized: "Euh, non... :\u2019("
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887619
    m_Localized: Avertissement
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887620
    m_Localized: "En jouant avec des inconnus, vous pourriez tomber sur des tricheurs
      ou des personnes pas tr\xE8s sympathiques..."
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887621
    m_Localized: Je comprends
    m_Metadata:
      m_Items: []
  - m_Id: 754728059887622
