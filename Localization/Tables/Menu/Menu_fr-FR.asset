  - m_Id: 22911118095757313
    m_Localized: Croissant de lune
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757314
    m_Localized: "L\u2019espace soin du camion restaure d\xE9sormais 35\_points de
      vie."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757315
    m_Localized: "Il est plus difficile de renverser les monstres \xE0 l\u2019aide
      des objets de valeur."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757316
    m_Localized: Demi-lune
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757317
    m_Localized: Les monstres surchargent le rayon tracteur.
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757318
    m_Localized: "Les monstres subissent davantage de d\xE9g\xE2ts en tombant dans
      des trous, mais ils peuvent survivre."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757319
    m_Localized: "L\u2019espace soin du camion restaure d\xE9sormais 25\_points de
      vie."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757320
    m_Localized: Pleine lune
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757321
    m_Localized: "L\u2019effet de surcharge du rayon tracteur augmente de 25\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757322
    m_Localized: "Les monstres subissent moins de d\xE9g\xE2ts en tombant dans des
      trous."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757323
    m_Localized: Super lune
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757324
    m_Localized: "Lorsqu\u2019ils sont d\xE9truits, les orbes ennemis explosent."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757325
    m_Localized: "L\u2019effet de surcharge du rayon tracteur augmente de 50\_%."
    m_Metadata:
      m_Items: []
  - m_Id: 22911118095757326
    m_Localized: "Les monstres subissent encore moins de d\xE9g\xE2ts en tombant
      dans des trous."
    m_Metadata:
      m_Items: []
