      m_Items: []
  - m_Id: 15661116075008007
    m_Localized: "Tout le monde est pr\xEAt\_?\n\nUne fois la partie lanc\xE9e,\nplus
      personne ne peut la rejoindre."
    m_Metadata:
      m_Items: []
  - m_Id: 15661116075008008
