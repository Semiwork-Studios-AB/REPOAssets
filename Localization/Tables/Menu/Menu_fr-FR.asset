      m_Items: []
  - m_Id: 26475650059841536
    m_Localized: "Avertissement sur la photosensibilit\xE9"
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007360
    m_Localized: Ce jeu contient des flashs lumineux.
    m_Metadata:
      m_Items: []
  - m_Id: 26475650085007361
    m_Localized: "Certaines personnes peuvent \xEAtre sujettes \xE0 des crises d\u2019\xE9pilepsie
      lors de l\u2019exposition \xE0 certains ph\xE9nom\xE8nes lumineux. Si vous
      \xE9prouvez la moindre g\xEAne en jouant, veuillez quitter le jeu imm\xE9diatement
      et consulter un m\xE9decin."
    m_Metadata:
      m_Items: []
